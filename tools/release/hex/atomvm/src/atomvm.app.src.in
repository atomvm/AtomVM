{application, atomvm, [
    {description, "The supported API of an AtomVM release, for build tools"},
    {vsn, "@ATOMVM_HEX_VERSION@"},
    {modules, []},
    {registered, []},
    {applications, [kernel, stdlib]},
    {env, [{supported_api, true}]},
    {licenses, ["Apache-2.0", "LGPL-2.1-or-later"]},
    {links, [
        {"AtomVM", "https://github.com/atomvm/AtomVM"},
        {"Release", "https://github.com/atomvm/AtomVM/releases/tag/v@ATOMVM_HEX_VERSION@"}
    ]}
]}.
