/*
 * Fixture for extract_instructions.erl: a miniature opcode table with all four
 * macros, a block comment, a line comment and a trailing comment.
 */

// Opcodes are listed in opcode order, and so is the output.

X_OPCODE_HANDLER(OP_LABEL, 1, label, "I") // has its own handler
X_OPCODE(OP_FUNC_INFO, 2, func_info, "aaA")
X_OPCODE(OP_INT_CALL_END, 3, int_call_end, "$")
X_OPCODE_REMOVED(OP_GONE, 4, gone)
X_OPCODE_SKIP(5)
X_OPCODE(OP_RETURN, 6, return, "")
