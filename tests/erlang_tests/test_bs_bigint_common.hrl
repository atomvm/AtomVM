%% Integer segments wider than 64 bits, shared by test_bs_bigint_unaligned and
%% test_no_bs_unaligned.

-export([bi_id/1]).

bi_id(X) -> X.

bigint_test() ->
    ok = bi_test_construct_vectors(bi_construct_vectors()),
    ok = bi_test_extract_vectors(bi_extract_vectors()),
    ok = bi_test_sweep(),
    ok = bi_test_wider_than_256(),
    ok.

