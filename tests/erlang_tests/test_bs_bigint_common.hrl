                239, 1, 128, 255, 0, 18, 52, 86, 120, 154, 188, 222, 241, 126, 1:2>>,
            {12546137710874687162090754521778247211100509064166711800561045418185034004671,
                12546137710874687162090754521778247211100509064166711800561045418185034004671},
            {28923056875783930597630082458555742722161525583348296366851166691020053772599,
                28923056875783930597630082458555742722161525583348296366851166691020053772599}},
        {0, 1, <<1:4>>, {0, 0}, {0, 0}}
    ].

bi_test_construct_vectors([]) ->
    ok;
bi_test_construct_vectors([{P, V, N, Be, Le} | T]) ->
    Pre = (1 bsl P) - 1,
    Be = bi_cbe(Pre, ?MODULE:bi_id(P), ?MODULE:bi_id(V), ?MODULE:bi_id(N)),
    Le = bi_cle(Pre, ?MODULE:bi_id(P), ?MODULE:bi_id(V), ?MODULE:bi_id(N)),
    Native = bi_cne(Pre, ?MODULE:bi_id(P), ?MODULE:bi_id(V), ?MODULE:bi_id(N)),
    case <<1:16/native>> of
        <<1, 0>> -> Le = Native;
        _ -> Be = Native
    end,
    bi_test_construct_vectors(T).

%% {Prefix size, Field size, Field and trailer,
%%  {Big-endian unsigned, Big-endian signed}, {Little-endian unsigned, Little-endian signed}}
bi_test_extract_vectors([]) ->
    ok;
bi_test_extract_vectors([{P, N, Input, {Be, SBe}, {Le, SLe}} | T]) ->
    Bin = <<0:P, Input/bits>>,
    Rest = <<1:3>>,
    {Be, Rest} = bi_xbe(?MODULE:bi_id(P), ?MODULE:bi_id(N), ?MODULE:bi_id(Bin)),
    {SBe, Rest} = bi_xsbe(?MODULE:bi_id(P), ?MODULE:bi_id(N), ?MODULE:bi_id(Bin)),
    {Le, Rest} = bi_xle(?MODULE:bi_id(P), ?MODULE:bi_id(N), ?MODULE:bi_id(Bin)),
    {SLe, Rest} = bi_xsle(?MODULE:bi_id(P), ?MODULE:bi_id(N), ?MODULE:bi_id(Bin)),
    bi_test_extract_vectors(T).

bi_pattern() ->
    <<16#9E, 16#37, 16#79, 16#B9, 16#7F, 16#4A, 16#7C, 16#15, 16#F0, 16#0F, 16#A5, 16#5A, 16#C3,
        16#3C, 16#81, 16#7E, 16#DE, 16#AD, 16#BE, 16#EF, 16#01, 16#80, 16#FF, 16#00, 16#12, 16#34,
        16#56, 16#78, 16#9A, 16#BC, 16#DE, 16#F1, 16#7F, 16#FF, 16#80, 16#00, 16#55, 16#AA, 16#C0,
        16#3F>>.

bi_values() ->
    S = fun(X) -> ?MODULE:bi_id(1) bsl X end,
    [
        0,
        1,
        -1,
        255,
        -256,
        S(63) - 1,
        S(63),
        S(64) - 1,
        -S(63),
        -S(63) - 1,
        S(64),
        S(70) + 12345,
        -(S(70) + 12345),
        S(200) + 7,
        -(S(200) + 9),
        S(255),
        -S(255),
        S(255) + (S(255) - 1),
        -(S(255) + (S(255) - 1))
    ].

