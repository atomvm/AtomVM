bi_test_sweep() ->
    bi_sweep_prefixes(bi_prefixes()).

bi_sweep_prefixes([]) ->
    ok;
bi_sweep_prefixes([P | T]) ->
    ok = bi_sweep_sizes(P, bi_sizes()),
    bi_sweep_prefixes(T).

bi_sweep_sizes(_P, []) ->
    ok;
bi_sweep_sizes(P, [N | T]) ->
    ok = bi_sweep_values(P, N, bi_values()),
    ok = bi_sweep_extract(P, N),
    bi_sweep_sizes(P, T).

bi_sweep_values(_P, _N, []) ->
    ok;
bi_sweep_values(P, N, [V | T]) ->
    Pre = (1 bsl P) - 1,
    M = 1 bsl N,
    Vm = ((V rem M) + M) rem M,
    Ones = bi_bits_from_int(Pre, P),
    Trailer = [0, 0, 1],
    ExpectedBe = bi_to_bitstring(Ones ++ bi_be_bits(Vm, N) ++ Trailer),
    ExpectedLe = bi_to_bitstring(Ones ++ bi_le_bits(Vm, N) ++ Trailer),
    ExpectedBe = bi_cbe(Pre, ?MODULE:bi_id(P), ?MODULE:bi_id(V), ?MODULE:bi_id(N)),
    ExpectedBe = bi_csbe(Pre, ?MODULE:bi_id(P), ?MODULE:bi_id(V), ?MODULE:bi_id(N)),
    ExpectedLe = bi_cle(Pre, ?MODULE:bi_id(P), ?MODULE:bi_id(V), ?MODULE:bi_id(N)),
    bi_sweep_values(P, N, T).

bi_sweep_extract(P, N) ->
    <<_:P/bits, Field:N/bits, _/bits>> = bi_pattern(),
    Bin = <<0:P, Field/bits, 1:3>>,
    Bits = bi_bits(Field),
    Be = bi_int_from_bits(Bits),
    Le = bi_le_int_from_bits(Bits, N),
    SBe = bi_signed(Be, N),
    SLe = bi_signed(Le, N),
    Rest = <<1:3>>,
    {Be, Rest} = bi_xbe(?MODULE:bi_id(P), ?MODULE:bi_id(N), ?MODULE:bi_id(Bin)),
    {SBe, Rest} = bi_xsbe(?MODULE:bi_id(P), ?MODULE:bi_id(N), ?MODULE:bi_id(Bin)),
    {Le, Rest} = bi_xle(?MODULE:bi_id(P), ?MODULE:bi_id(N), ?MODULE:bi_id(Bin)),
    {SLe, Rest} = bi_xsle(?MODULE:bi_id(P), ?MODULE:bi_id(N), ?MODULE:bi_id(Bin)),
    ok.

bi_test_wider_than_256() ->
    <<0:1, 0:300, 1:3>> = bi_cbe(0, 1, ?MODULE:bi_id(0), ?MODULE:bi_id(300)),
    <<1:1, 0:292, 255:8, 1:3>> =
        bi_cbe(1, ?MODULE:bi_id(1), ?MODULE:bi_id(255), ?MODULE:bi_id(300)),
    ok.

bi_cbe(Pre, P, V, N) -> <<Pre:P, V:N, 1:3>>.
bi_cle(Pre, P, V, N) -> <<Pre:P, V:N/little, 1:3>>.
bi_cne(Pre, P, V, N) -> <<Pre:P, V:N/native, 1:3>>.
bi_csbe(Pre, P, V, N) -> <<Pre:P, V:N/signed, 1:3>>.
bi_xbe(P, N, B) ->
    <<_:P, X:N, R/bits>> = B,
    {X, R}.
bi_xsbe(P, N, B) ->
    <<_:P, X:N/signed, R/bits>> = B,
    {X, R}.
bi_xle(P, N, B) ->
    <<_:P, X:N/little, R/bits>> = B,
    {X, R}.
bi_xsle(P, N, B) ->
    <<_:P, X:N/signed-little, R/bits>> = B,
    {X, R}.

bi_bit(X, I) -> (X bsr I) band 1.

bi_bits_from_int(X, N) -> bi_bits_from_int(X, N - 1, []).

bi_bits_from_int(_X, I, Acc) when I < 0 -> lists:reverse(Acc);
bi_bits_from_int(X, I, Acc) -> bi_bits_from_int(X, I - 1, [bi_bit(X, I) | Acc]).

bi_be_bits(Vm, N) -> bi_bits_from_int(Vm, N).

bi_le_bits(Vm, N) ->
    Whole = N div 8,
    Rem = N rem 8,
    bi_le_bytes(Vm, 0, Whole) ++ bi_bits_from_int(Vm bsr (8 * Whole), Rem).

bi_le_bytes(_Vm, I, Whole) when I >= Whole -> [];
bi_le_bytes(Vm, I, Whole) -> bi_bits_from_int(Vm bsr (8 * I), 8) ++ bi_le_bytes(Vm, I + 1, Whole).

bi_to_bitstring(Bits) -> bi_to_bitstring(Bits, <<>>).

bi_to_bitstring([], Acc) -> Acc;
bi_to_bitstring([B | T], Acc) -> bi_to_bitstring(T, <<Acc/bits, B:1>>).

bi_bits(<<>>) -> [];
bi_bits(<<B:1, Rest/bits>>) -> [B | bi_bits(Rest)].

bi_int_from_bits(Bits) -> bi_int_from_bits(Bits, 0).

bi_int_from_bits([], Acc) -> Acc;
bi_int_from_bits([B | T], Acc) -> bi_int_from_bits(T, Acc * 2 + B).

bi_le_int_from_bits(Bits, N) ->
    Whole = N div 8,
    {Bytes, High} = bi_split(Bits, Whole * 8),
    bi_le_bytes_value(Bytes, 1) + bi_int_from_bits(High) * (1 bsl (8 * Whole)).

bi_split(Bits, Count) -> bi_split(Bits, Count, []).

bi_split(Rest, 0, Acc) -> {lists:reverse(Acc), Rest};
bi_split([B | T], Count, Acc) -> bi_split(T, Count - 1, [B | Acc]).

bi_le_bytes_value([], _Scale) ->
    0;
bi_le_bytes_value(Bits, Scale) ->
    {Byte, Rest} = bi_split(Bits, 8),
    bi_int_from_bits(Byte) * Scale + bi_le_bytes_value(Rest, Scale * 256).

bi_signed(U, N) ->
    case U >= (1 bsl (N - 1)) of
        true -> U - (1 bsl N);
        false -> U
    end.
