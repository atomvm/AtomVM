index b883f4c9c638ff6e76cb61ba762003fe68293e8b..974d22f9bd7b389c8c046f42b1dc068fed4427f3 100644
--- a/rtemslwip/esp32c3/lwipbspopts.h
+++ b/rtemslwip/esp32c3/lwipbspopts.h
@@ -113,4 +113,7 @@
  */
 #define LWIP_NETIF_STATUS_CALLBACK  1
 
+/* Wi-Fi AP proxy ARP can claim a station address with the AP MAC. */
+#define LWIP_DHCP_DOES_ACD_CHECK 0
+
 #endif /* RTEMSLWIP_ESP32C3_LWIPBSPOPTS_H */
