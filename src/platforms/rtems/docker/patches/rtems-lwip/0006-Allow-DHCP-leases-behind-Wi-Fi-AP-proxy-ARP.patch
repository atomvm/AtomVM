 rtemslwip/esp32c5/lwipbspopts.h  | 3 +++
 rtemslwip/esp32c6/lwipbspopts.h  | 3 +++
 rtemslwip/esp32s31/lwipbspopts.h | 3 +++
 4 files changed, 12 insertions(+)

