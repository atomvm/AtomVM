+/* === software coexistence ============================================== */
+
 /*
- * The ESP32-C3 has one radio shared between WiFi and Bluetooth, and these
- * entries are how the WiFi side asks for it.  This port builds no Bluetooth,
- * so WiFi always has the radio and the honest implementation is to say yes.
+ * ESP-IDF's esp32c3/c5/c6/s31 esp_adapter.c calls these when
+ * CONFIG_SW_COEXIST_ENABLE or CONFIG_EXTERNAL_COEX_ENABLE is set. Software
+ * coexistence is on; external wire coexistence is not. coex_pre_init() is
+ * what esp_coex's secondary init function runs after registering the OS
+ * adapter, and the Wi-Fi blob reaches coexistence before _coex_init().
  *
- * Deliberately not named failures.  A named failure is right where the answer
- * is unknown; here it is known, and reporting "not implemented" every time the
- * libraries check for a peer that cannot exist would be noise that hides the
- * entries that do still matter.
+ * Flexible-period entry points stay at the disabled-wrapper values because
+ * CONFIG_ESP_COEX_POWER_MANAGEMENT is off. condition_set has no software
+ * coexistence implementation in that adapter either.
  */
-static int rtems_wifi_coex_init( void )
+static int ( *rtems_wifi_coex_start_cb )( void );
+static int ( *rtems_wifi_coex_schm_cb )( int );
+
+static int rtems_wifi_coex_start_forward( void )
 {
+  if ( rtems_wifi_coex_start_cb == NULL ) {
+    return 0;
+  }
+
+  return rtems_wifi_coex_start_cb();
+}
+
+static int rtems_wifi_coex_schm_forward( int event )
+{
+  if ( rtems_wifi_coex_schm_cb == NULL ) {
+    return 0;
+  }
+
+  return rtems_wifi_coex_schm_cb( event );
+}
