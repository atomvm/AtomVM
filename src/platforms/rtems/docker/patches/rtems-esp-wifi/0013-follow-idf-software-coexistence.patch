+/*
+ * C3's pinned esp_coex_adapter.c leaves _env_is_chip and _xtal_freq_get
+ * unset. Those fields are in the header (the library checks its MD5), so
+ * leaving them NULL shifts _magic. Fill every field the header declares.
+ */
+static coex_adapter_funcs_t rtems_coex_adapter_funcs = {
+  ._version = COEX_ADAPTER_VERSION,
+  ._task_yield_from_isr = rtems_wifi_task_yield_from_isr,
+  ._semphr_create = rtems_wifi_semphr_create,
+  ._semphr_delete = rtems_wifi_semphr_delete,
+  ._semphr_take_from_isr = rtems_wifi_semphr_take_from_isr,
+  ._semphr_give_from_isr = rtems_wifi_semphr_give_from_isr,
+  ._semphr_take = rtems_wifi_semphr_take,
+  ._semphr_give = rtems_wifi_semphr_give,
+  ._is_in_isr = rtems_coex_is_in_isr,
+  ._malloc_internal = rtems_wifi_malloc,
+  ._free = free,
+  ._esp_timer_get_time = rtems_wifi_esp_timer_get_time,
+  ._env_is_chip = rtems_wifi_env_is_chip,
+  ._timer_disarm = rtems_wifi_timer_disarm,
+  ._timer_done = rtems_wifi_timer_done,
+  ._timer_setfn = rtems_wifi_timer_setfn,
+  ._timer_arm_us = rtems_wifi_timer_arm_us,
+  ._debug_matrix_init = rtems_coex_debug_matrix_init,
+  ._xtal_freq_get = rtems_coex_xtal_freq_get,
+#if defined(CONFIG_IDF_TARGET_ESP32C6)
+  ._ieee802154_intr_disable = rtems_coex_ieee802154_intr_disable,
+  ._ieee802154_intr_enable = rtems_coex_ieee802154_intr_enable,
+#endif
+  ._magic = COEX_ADAPTER_MAGIC,
+};
+
+/*
+ * Runs from esp_wifi_init() before esp_wifi_init_internal(), which is where
+ * ESP-IDF runs it from its secondary init function. Idempotent because the
+ * OS table's _coex_init still calls it.
+ */
+int rtems_wifi_coex_prepare( void )
+{
+  static bool prepared = false;
+  esp_err_t err;
+
+  if ( prepared ) {
+    return ESP_OK;
+  }
+
+  err = esp_coex_adapter_register( &rtems_coex_adapter_funcs );
+  if ( err != ESP_OK ) {
+    return err;
+  }
+
+  err = coex_pre_init();
+  if ( err != ESP_OK ) {
+    return err;
+  }
+
+  prepared = true;
+  return ESP_OK;
+}
+
+static int rtems_wifi_coex_init( void )
+{
+  int err = rtems_wifi_coex_prepare();
+
+  if ( err != ESP_OK ) {
+    return err;
+  }
+
+  return coex_init();
+}
+
 static void rtems_wifi_coex_deinit( void )
