-   * called and reporting success is accurate rather than a shortcut.
-   */
-  return ESP_OK;
+  return coex_register_start_cb( rtems_wifi_coex_start_forward );
 }
 
 static int rtems_wifi_coex_schm_register_cb( int type, int ( *cb )( int ) )
 {
-  (void) type;
-  (void) cb;
+  rtems_wifi_coex_schm_cb = cb;
+  if ( cb == NULL ) {
+    return coex_schm_register_callback( type, NULL );
+  }
 
-  return ESP_OK;
+  return coex_schm_register_callback( type, rtems_wifi_coex_schm_forward );
 }
 
