new file mode 100644
--- /dev/null
+++ b/include/rtems-esp/recursive-lock.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Copyright (C) 2026 Peter M. <petermm@gmail.com> */
+#ifndef RTEMS_ESP_RECURSIVE_LOCK_H
+#define RTEMS_ESP_RECURSIVE_LOCK_H
+
+#include <rtems.h>
+#include <rtems/score/smp.h>
+
+/* ESP32-S31 has two application harts. With local interrupts masked, each
+ * hart alone owns its depth/context slot. The RTEMS lock excludes the other
+ * hart; reacquisition on the same hart only increments its nesting count.
+ */
+typedef struct {
+  rtems_interrupt_lock lock;
+  unsigned depth[2];
+  rtems_interrupt_lock_context context[2];
+} rtems_esp_recursive_lock;
+
+#define RTEMS_ESP_RECURSIVE_LOCK_INITIALIZER(name) \
+  { .lock = RTEMS_INTERRUPT_LOCK_INITIALIZER(name) }
+
+static inline __attribute__((always_inline)) uint32_t
+rtems_esp_recursive_lock_acquire( rtems_esp_recursive_lock *lock )
+{
+  rtems_interrupt_level level;
+  rtems_interrupt_local_disable( level );
+  uint32_t cpu = _SMP_Get_current_processor();
+  if ( lock->depth[cpu]++ == 0 ) {
+    _ISR_lock_Acquire_inline( &lock->lock, &lock->context[cpu] );
+  }
+  return level;
+}
+
+static inline __attribute__((always_inline)) void
+rtems_esp_recursive_lock_release( rtems_esp_recursive_lock *lock, uint32_t level )
+{
+  uint32_t cpu = _SMP_Get_current_processor();
+  if ( --lock->depth[cpu] == 0 ) {
+    _ISR_lock_Release_inline( &lock->lock, &lock->context[cpu] );
+  }
+  rtems_interrupt_local_enable( level );
+}
+#endif
