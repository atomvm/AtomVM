-  rtems_wifi_reg_write( 0x20109C00u, rtems_wifi_reg_read( 0x20109C00u ) | 1u );
-  rtems_wifi_reg_write( 0x20109C04u, 0xFFFFFFFFu );
-  rtems_wifi_reg_write( 0x20109C08u, 0xFFFFFFFFu );
-  rtems_wifi_reg_write( 0x20109C14u, 0xFFFFFFFFu );
-  rtems_wifi_reg_write( 0x2010F000u, rtems_wifi_reg_read( 0x2010F000u ) | 1u );
-  rtems_wifi_reg_write( 0x2010F018u, 0xFFFFFFFFu );
-  rtems_wifi_reg_write( 0x2010F01Cu, 0xFFFFFFFFu );
-  rtems_wifi_reg_write( 0x205044C4u, 0 );
-  rtems_wifi_reg_write( 0x205048C4u, 0 );
-  rtems_wifi_reg_write( 0x20504CC4u, 0 );
-  rtems_wifi_reg_write( 0x20706CBCu, 0 );
-  __asm__ volatile (
-    ".option push\n"
-    ".option arch, +zicsr\n"
-    "csrw 0xbcc, x0\n"
-    "csrw 0xbcd, x0\n"
-    "csrw 0xbce, x0\n"
-    "csrw 0xbcf, x0\n"
-    "csrw 0xbdc, x0\n"
-    "csrw 0xbdd, x0\n"
-    "csrw 0xbde, x0\n"
-    "csrw 0xbdf, x0\n"
-    ".option pop\n"
-    ::: "memory"
-  );
+  /* bootloader_init_mem(): filters off and the S31 peripheral-access
+   * workaround. Use named registers and retain the BSP's per-hart PMA map.
+   */
+  REG_CLR_BIT( HP_APM_FUNC_CTRL_REG, 0x7fu );
+  REG_CLR_BIT( CPU_APM_FUNC_CTRL_REG, 0x0fu );
+  REG_CLR_BIT( HP_MEM_APM_FUNC_CTRL_REG, 0x3fu );
+  REG_CLR_BIT( LP_APM_FUNC_CTRL_REG, 0x0fu );
+  for ( uint32_t reg = LP_PERI_PMS_LP_SYSREG_CTRL_REG;
+        reg <= LP_PERI_PMS_LP_DAC_CTRL_REG; reg += 4 ) {
+    REG_WRITE( reg, 0xff );
+  }
+  for ( uint32_t reg = HP_PERI0_PMS_TRACE0_CTRL_REG;
+        reg <= HP_PERI0_PMS_AXI_PERF_MON_CTRL_REG; reg += 4 ) {
+    REG_WRITE( reg, 0xff );
+  }
+  for ( uint32_t reg = HP_PERI1_PMS_HP_USBOTG_PHY_CTRL_REG;
+        reg <= HP_PERI1_PMS_HP_USBOTG_PHY_CTRL_REG; reg += 4 ) {
+    REG_WRITE( reg, 0xff );
+  }
+  rtems_s31_modem_clock_init();
 #elif defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
   /* ESP-IDF has no software modem power-domain sequence on C5.
    * Clock dependencies are enabled by the OS adapter and PHY lifecycle.
@@ -1171,6 +1338,8 @@
