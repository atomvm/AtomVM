 src/rtems_esp_glue.c               |  77 +++
 src/rtems_esp_wifi_init.c          | 926 +++++++++++++++++++++--------
 src/rtems_wifi_os_adapter.c        | 181 ++++--
 4 files changed, 936 insertions(+), 291 deletions(-)
 create mode 100644 include/rtems-esp/recursive-lock.h

diff --git a/include/rtems-esp/recursive-lock.h b/include/rtems-esp/recursive-lock.h
new file mode 100644
index 0000000000000000000000000000000000000000..035e1176315e33b9c5937595827371e5d56fad80
--- /dev/null
+++ b/include/rtems-esp/recursive-lock.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Copyright (C) 2026 Peter M. <petermm@gmail.com> */
+#ifndef RTEMS_ESP_RECURSIVE_LOCK_H
+#define RTEMS_ESP_RECURSIVE_LOCK_H
+
+#include <rtems.h>
+#include <rtems/score/smp.h>
+
+/* ESP32-S31 has two application harts. With local interrupts masked, each
+ * hart alone owns its depth/context slot. The RTEMS lock excludes the other
+ * hart; reacquisition on the same hart only increments its nesting count.
+ */
+typedef struct {
+  rtems_interrupt_lock lock;
+  unsigned depth[2];
+  rtems_interrupt_lock_context context[2];
+} rtems_esp_recursive_lock;
+
+#define RTEMS_ESP_RECURSIVE_LOCK_INITIALIZER(name) \
+  { .lock = RTEMS_INTERRUPT_LOCK_INITIALIZER(name) }
+
+static inline __attribute__((always_inline)) uint32_t
+rtems_esp_recursive_lock_acquire( rtems_esp_recursive_lock *lock )
+{
+  rtems_interrupt_level level;
+  rtems_interrupt_local_disable( level );
+  uint32_t cpu = _SMP_Get_current_processor();
+  if ( lock->depth[cpu]++ == 0 ) {
+    _ISR_lock_Acquire_inline( &lock->lock, &lock->context[cpu] );
+  }
+  return level;
+}
+
+static inline __attribute__((always_inline)) void
+rtems_esp_recursive_lock_release( rtems_esp_recursive_lock *lock, uint32_t level )
+{
+  uint32_t cpu = _SMP_Get_current_processor();
+  if ( --lock->depth[cpu] == 0 ) {
+    _ISR_lock_Release_inline( &lock->lock, &lock->context[cpu] );
+  }
+  rtems_interrupt_local_enable( level );
+}
+#endif
diff --git a/src/rtems_esp_glue.c b/src/rtems_esp_glue.c
index a58a2561a11a4f420023410c234e17a192e8bfd6..989522763677d699d1a9ea031694b88094b7adb7 100644
--- a/src/rtems_esp_glue.c
+++ b/src/rtems_esp_glue.c
@@ -40,6 +40,7 @@
 #include <rtems/bspIo.h>
 
 #include <esp_log.h>
+#include <esp_attr.h>
 
 #include <stdarg.h>
 #include <stdint.h>
@@ -119,6 +120,81 @@ RTEMS_ESP_PRINTF(coex_pti_print, "wifi.coex")
  * owner's context is kept here rather than handed out. Acquire and release
  * through local copies so a competing CPU cannot overwrite its saved level.
  */
+#if defined(RTEMS_BOARD_ESP32C3) || defined(CONFIG_IDF_TARGET_ESP32C3) \
+  || defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+/* C3/C6 use one application CPU. Keep the saved level in each caller's token so nested
+ * PHY critical sections restore the outer interrupt state, as IDF does.
+ */
+uint32_t IRAM_ATTR phy_enter_critical(void)
+{
+  rtems_interrupt_level level;
+  rtems_interrupt_local_disable( level );
+  return level;
+}
+
+void IRAM_ATTR phy_exit_critical(uint32_t level)
+{
+  rtems_interrupt_local_enable( level );
+}
+
+/* IDF's phy_override.c also protects the PHY's analog I2C transactions.
+ * These hooks have no token argument, so retain the outermost saved level.
+ * With one application CPU, masked interrupts exclude both tasks and ISRs.
+ */
+static unsigned rtems_phy_i2c_depth;
+static rtems_interrupt_level rtems_phy_i2c_level;
+
+void IRAM_ATTR phy_i2c_enter_critical(void)
+{
+  rtems_interrupt_level level;
+  rtems_interrupt_local_disable( level );
+  if ( rtems_phy_i2c_depth++ == 0 ) {
+    rtems_phy_i2c_level = level;
+  }
+}
+
+void IRAM_ATTR phy_i2c_exit_critical(void)
+{
+  if ( --rtems_phy_i2c_depth == 0 ) {
+    rtems_interrupt_local_enable( rtems_phy_i2c_level );
+  }
+}
+#elif defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+#include <rtems-esp/recursive-lock.h>
+static rtems_esp_recursive_lock rtems_s31_phy_lock =
+  RTEMS_ESP_RECURSIVE_LOCK_INITIALIZER( "ESP PHY" );
+static rtems_esp_recursive_lock rtems_s31_i2c_lock =
+  RTEMS_ESP_RECURSIVE_LOCK_INITIALIZER( "PHY I2C" );
+static rtems_interrupt_level rtems_s31_i2c_level[2];
+
+uint32_t IRAM_ATTR phy_enter_critical(void)
+{
+  return rtems_esp_recursive_lock_acquire( &rtems_s31_phy_lock );
+}
+
+void IRAM_ATTR phy_exit_critical(uint32_t level)
+{
+  rtems_esp_recursive_lock_release( &rtems_s31_phy_lock, level );
+}
+
+void IRAM_ATTR phy_i2c_enter_critical(void)
+{
+  uint32_t level = rtems_esp_recursive_lock_acquire( &rtems_s31_i2c_lock );
+  uint32_t cpu = _SMP_Get_current_processor();
+  if ( rtems_s31_i2c_lock.depth[cpu] == 1 ) {
+    rtems_s31_i2c_level[cpu] = level;
+  }
+}
+
+void IRAM_ATTR phy_i2c_exit_critical(void)
+{
+  uint32_t cpu = _SMP_Get_current_processor();
+  /* Inner calls must retain masked interrupts; the outer call restores its token. */
+  uint32_t level = rtems_s31_i2c_lock.depth[cpu] == 1
+    ? rtems_s31_i2c_level[cpu] : 0;
+  rtems_esp_recursive_lock_release( &rtems_s31_i2c_lock, level );
+}
+#else
 RTEMS_INTERRUPT_LOCK_DEFINE( static, rtems_esp_phy_lock, "ESP PHY" )
 
 static rtems_interrupt_lock_context rtems_esp_phy_lock_context;
@@ -144,6 +220,7 @@ void phy_exit_critical(uint32_t level)
   rtems_interrupt_lock_context context = rtems_esp_phy_lock_context;
   rtems_interrupt_lock_release( &rtems_esp_phy_lock, &context );
 }
+#endif
 
