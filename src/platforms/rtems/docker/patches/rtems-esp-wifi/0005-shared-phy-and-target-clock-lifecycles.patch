+  S31_ICG_MAP( lpcon, LPCON, coex, 6 );
+  S31_ICG_MAP( lpcon, LPCON, wifipwr, 6 );
+#undef S31_ICG_MAP
+  RTEMS_S31_PMU.imm.modem_icg.update_dig_icg_modem_en = 1;
+  RTEMS_S31_PMU.imm.sleep_sysclk.update_dig_icg_switch = 1;
+}
+
+static void rtems_s31_modem_clock_init( void )
+{
+  /* esp_perip_clk_init(): S31 supports RC_SLOW or XTAL32K. */
+  uint32_t slow_src = REG_GET_FIELD( LP_AONCLKRST_ROOT_CLK_CONF_REG,
+    LP_AONCLKRST_SLOW_CLK_SEL );
+  rtems_s31_clock_maps_init();
+  modem_lpcon_ll_enable_wifi_lpclk_slow_osc( &MODEM_LPCON, false );
+  modem_lpcon_ll_enable_wifi_lpclk_fast_osc( &MODEM_LPCON, false );
+  modem_lpcon_ll_enable_wifi_lpclk_main_xtal( &MODEM_LPCON, false );
+  modem_lpcon_ll_enable_wifi_lpclk_32k_xtal( &MODEM_LPCON, false );
+  if ( slow_src == 1u ) {
+    modem_lpcon_ll_enable_wifi_lpclk_32k_xtal( &MODEM_LPCON, true );
+    /* modem_clock_hal.c: XTAL32K has code 0 on S31. */
+    modem_lpcon_ll_select_modem_32k_clock_source( &MODEM_LPCON, 0 );
+  } else {
+    modem_lpcon_ll_enable_wifi_lpclk_slow_osc( &MODEM_LPCON, true );
+  }
+  modem_lpcon_ll_set_wifi_lpclk_divisor_value( &MODEM_LPCON, 0 );
+  modem_lpcon_ll_enable_wifipwr_clock( &MODEM_LPCON, true );
+}
+
+static void rtems_s31_shared_clock_update( void )
+{
+  bool enable = rtems_s31_wifi_clock_enabled || rtems_s31_phy_clock_enabled;
+  if ( enable == rtems_s31_shared_clock_enabled ) {
+    return;
+  }
+  rtems_s31_shared_clock_enabled = enable;
+  if ( enable ) {
+    /* clk_ll_bbpll_enable() / esp_clk_tree_enable_src(PLL_F160M).
+     * Keep the BBPLL powered on release: direct boot also uses it for
+     * flash and USB, which do not participate in IDF's reference counts.
+     */
+    SET_PERI_REG_MASK( PMU_IMM_HP_CK_POWER_1_REG,
+      PMU_TIE_HIGH_XPD_BBPLL | PMU_TIE_HIGH_XPD_BBPLL_I2C );
+    SET_PERI_REG_MASK( PMU_IMM_HP_CK_POWER_1_REG, PMU_TIE_HIGH_GLOBAL_BBPLL_ICG );
+    SET_PERI_REG_MASK( HP_ALIVE_SYS_HP_CLK_CTRL_REG, HP_ALIVE_SYS_HP_SPLL_480M_CLK_EN );
+    SET_PERI_REG_MASK( PMU_HP_ACTIVE_HP_CK_POWER_REG,
+      PMU_HP_ACTIVE_XPD_BBPLL_I2C | PMU_HP_ACTIVE_XPD_BBPLL );
+    SET_PERI_REG_MASK( HP_SYS_CLKRST_REF_160M_CTRL0_REG, HP_SYS_CLKRST_REG_REF_160M_CLK_EN );
+    REG_WRITE( HP_SYS_CLKRST_MODEM_CONF_REG, 0x15 );
+    REG_WRITE( HP_SYS_CLKRST_MODEM_CONF_REG, 0x1d );
+  } else {
+    REG_WRITE( HP_SYS_CLKRST_MODEM_CONF_REG, 0x2d );
+    REG_WRITE( HP_SYS_CLKRST_MODEM_CONF_REG, 0x25 );
+  }
+  /* WIFI_BB_80X1 is shared by PHY and Wi-Fi. IDF retains it while initialized. */
+  if ( enable || !rtems_s31_wifi_initialized ) {
+    modem_syscon_ll_enable_wifibb_80x1_clock( &MODEM_SYSCON, enable );
+  }
+}
+
+void rtems_esp_wifi_s31_clock_enable( void )
+{
+  pthread_mutex_lock( &rtems_phy_lock );
+  rtems_s31_clock_maps_init();
+  bool first = !rtems_s31_wifi_clock_enabled;
+  rtems_s31_wifi_clock_enabled = true;
+  rtems_s31_shared_clock_update();
+  modem_syscon_ll_enable_wifi_mac_clock( &MODEM_SYSCON, true );
+  modem_syscon_ll_enable_wifi_apb_clock( &MODEM_SYSCON, true );
+  if ( first ) {
+    modem_syscon_ll_reset_wifibb( &MODEM_SYSCON );
+  }
+  modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, true );
+  modem_syscon_ll_enable_wifibb_44m_clock( &MODEM_SYSCON, true );
+  modem_lpcon_ll_enable_coex_clock( &MODEM_LPCON, true );
+  pthread_mutex_unlock( &rtems_phy_lock );
+}
+
+void rtems_esp_wifi_s31_clock_disable( void )
+{
+  pthread_mutex_lock( &rtems_phy_lock );
+  if ( !rtems_s31_wifi_initialized ) {
+    modem_syscon_ll_enable_wifi_mac_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_wifi_apb_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_wifibb_44m_clock( &MODEM_SYSCON, false );
+  }
+  modem_lpcon_ll_enable_coex_clock( &MODEM_LPCON, false );
+  rtems_s31_wifi_clock_enabled = false;
+  rtems_s31_shared_clock_update();
+  pthread_mutex_unlock( &rtems_phy_lock );
+}
+#endif
+
+#if defined(RTEMS_ESP_WIFI_MANAGED_PHY)
+static void rtems_phy_track( void )
+{
+  phy_param_track_tot( true, false );
+  rtems_last_track_us = rtems_clock_get_uptime_nanoseconds() / 1000;
+}
+
+void rtems_esp_wifi_phy_track( void )
+{
+  pthread_mutex_lock( &rtems_phy_lock );
+  if ( rtems_phy_enabled ) {
+    rtems_phy_track();
+  }
+  pthread_mutex_unlock( &rtems_phy_lock );
+}
+
+void rtems_esp_wifi_phy_enable( void )
+{
+  pthread_mutex_lock( &rtems_phy_lock );
+  if ( !rtems_phy_enabled ) {
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+    rtems_c5_clock_maps_init();
+    /* PERIPH_PHY_MODULE: common/private FE and analog I2C. */
+    modem_syscon_ll_enable_fe_apb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_80m_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_160m_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_dac_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_pwdet_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_adc_clock( &MODEM_SYSCON, true );
+    MODEM_LPCON.clk_conf.clk_i2c_mst_en = 1;
+    /* PERIPH_PHY_CALIBRATION_MODULE. Shared Wi-Fi clocks stay enabled. */
+    modem_syscon_ll_enable_wifi_apb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_wifibb_44m_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_bt_bb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_bt_apb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_modem_sec_apb_clock( &MODEM_SYSCON, true );
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+    rtems_c6_clock_maps_init();
+    /* PERIPH_PHY_MODULE: common FE, private FE and analog I2C. */
+    modem_syscon_ll_enable_fe_apb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_80m_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_cal_160m_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_160m_clock( &MODEM_SYSCON, true );
+    MODEM_LPCON.clk_conf.clk_i2c_mst_en = 1;
+    /* PERIPH_PHY_CALIBRATION_MODULE: Wi-Fi BB and shared BT/15.4 BB/APB. */
+    modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_bt_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_modem_sec_apb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_bt_apb_clock( &MODEM_SYSCON, true );
+#elif defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+    rtems_s31_clock_maps_init();
+    rtems_s31_phy_clock_enabled = true;
+    rtems_s31_shared_clock_update();
+    modem_syscon_ll_enable_fe_apb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_80m_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_160m_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_dac_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_pwdet_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_fe_adc_clock( &MODEM_SYSCON, true );
+    MODEM_LPCON.clk_conf.clk_i2c_mst_en = 1;
+    /* Temporary PHY calibration dependencies; shared Wi-Fi clocks survive. */
+    modem_syscon_ll_enable_wifi_apb_clock( &MODEM_SYSCON, true );
+    if ( !rtems_s31_wifi_clock_enabled ) {
+      modem_syscon_ll_reset_wifibb( &MODEM_SYSCON );
+    }
+    modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_wifibb_44m_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_bt_bb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_bt_apb_clock( &MODEM_SYSCON, true );
+    modem_syscon_ll_enable_modem_sec_apb_clock( &MODEM_SYSCON, true );
+#else
+    /* esp_phy_enable()/phy_module_enable(), with no Bluetooth user. */
+    periph_ll_wifi_bt_module_enable_clk();
+    periph_ll_phy_calibration_module_enable_clk_clear_rst();
+    periph_ll_enable_clk_clear_rst( PERIPH_RNG_MODULE );
+    periph_ll_wifi_module_enable_clk_clear_rst();
+    periph_ll_enable_clk_clear_rst( PERIPH_BT_MODULE );
+#endif
+    if ( !rtems_phy_calibrated ) {
+      if ( rtems_esp_wifi_calibrate() != ESP_OK ) {
+        rtems_panic( "ESP PHY calibration failed" );
+      }
+      rtems_phy_calibrated = true;
+    } else {
+      phy_wakeup_init();
+#if defined(RTEMS_BOARD_ESP32C3) || defined(CONFIG_IDF_TARGET_ESP32C3)
+      if ( rtems_c3_phy_regs_stored ) {
+        phy_dig_reg_backup( false, rtems_c3_phy_digital_regs );
+      }
+#endif
+    }
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+    modem_syscon_ll_enable_bt_bb_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_bt_apb_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_modem_sec_apb_clock( &MODEM_SYSCON, false );
+    if ( !rtems_c5_wifi_clock_enabled && !rtems_c5_wifi_initialized ) {
+      modem_syscon_ll_enable_wifi_apb_clock( &MODEM_SYSCON, false );
+      modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, false );
+      modem_syscon_ll_enable_wifibb_44m_clock( &MODEM_SYSCON, false );
+    }
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+    modem_syscon_ll_enable_bt_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_modem_sec_apb_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_bt_apb_clock( &MODEM_SYSCON, false );
+    if ( !rtems_c6_wifi_clock_enabled && !rtems_c6_wifi_initialized ) {
+      modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, false );
+    }
+#elif defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+    modem_syscon_ll_enable_bt_bb_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_bt_apb_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_modem_sec_apb_clock( &MODEM_SYSCON, false );
+    if ( !rtems_s31_wifi_clock_enabled && !rtems_s31_wifi_initialized ) {
+      modem_syscon_ll_enable_wifi_apb_clock( &MODEM_SYSCON, false );
+      modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, false );
+      modem_syscon_ll_enable_wifibb_44m_clock( &MODEM_SYSCON, false );
+    }
+#else
+    periph_ll_disable_clk_set_rst( PERIPH_BT_MODULE );
+    periph_ll_wifi_module_disable_clk_set_rst();
+    /* Like IDF, retain the PHY and RNG clocks after calibration. */
+#endif
+    rtems_phy_enabled = true;
+  }
+  /* IDF tracks on enable only if more than one period has elapsed. */
+  if ( rtems_clock_get_uptime_nanoseconds() / 1000
+       - rtems_last_track_us > 1000000 ) {
+    rtems_phy_track();
+  }
+  pthread_mutex_unlock( &rtems_phy_lock );
+}
+
+void rtems_esp_wifi_phy_disable( void )
+{
+  pthread_mutex_lock( &rtems_phy_lock );
+  if ( rtems_phy_enabled ) {
+    rtems_phy_enabled = false;
+#if defined(RTEMS_BOARD_ESP32C3) || defined(CONFIG_IDF_TARGET_ESP32C3)
+    phy_dig_reg_backup( true, rtems_c3_phy_digital_regs );
+    rtems_c3_phy_regs_stored = true;
+#endif
+    phy_close_rf();
+    phy_xpd_tsens();
+    phy_wait_freq_hw_hop_done();
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+    MODEM_LPCON.clk_conf.clk_i2c_mst_en = 0;
+    /* IDF's C5 common/private FE disable operations intentionally do nothing. */
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+    MODEM_LPCON.clk_conf.clk_i2c_mst_en = 0;
+    /* C6 common/private FE disable operations intentionally do nothing. */
+#elif defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+    MODEM_LPCON.clk_conf.clk_i2c_mst_en = 0;
+    rtems_s31_phy_clock_enabled = false;
+    rtems_s31_shared_clock_update();
+    /* Common/private FE disable callbacks intentionally leave clocks on. */
+#else
+    periph_ll_wifi_bt_module_disable_clk();
+#endif
+  }
+  pthread_mutex_unlock( &rtems_phy_lock );
+}
+#endif
+
+esp_err_t esp_wifi_init( const wifi_init_config_t *config )
+{
+  esp_err_t result;
+
+  if ( config == NULL ) {
+    return ESP_ERR_INVALID_ARG;
+  }
+
+  if ( rtems_wifi_inited ) {
+    printk( "rtems-esp-wifi: already initialised\n" );
+
+    return ESP_ERR_INVALID_STATE;
+  }
+
+  /*
+   * The OS adapter has to be reachable before anything in the libraries runs.
+   * It travels in the config -- WIFI_INIT_CONFIG_DEFAULT() sets
+   * .osi_funcs = &g_wifi_osi_funcs -- and esp_wifi_init_internal() is what
+   * assigns the ROM's g_osi_funcs_p from it.  A caller that builds a config by
+   * hand and leaves this null gets a null-pointer call from inside a blob, so
+   * it is worth refusing here where the message can say why.
+   */
+  if ( config->osi_funcs == NULL ) {
+    printk( "rtems-esp-wifi: config->osi_funcs is null; "
+            "build the config with WIFI_INIT_CONFIG_DEFAULT()\n" );
+
+    return ESP_ERR_INVALID_ARG;
+  }
+
+  rtems_esp_wifi_copy_sections();
+
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+  /* bootloader_init_mem(): filters off and the S31 peripheral-access
+   * workaround. Use named registers and retain the BSP's per-hart PMA map.
+   */
+  REG_CLR_BIT( HP_APM_FUNC_CTRL_REG, 0x7fu );
+  REG_CLR_BIT( CPU_APM_FUNC_CTRL_REG, 0x0fu );
+  REG_CLR_BIT( HP_MEM_APM_FUNC_CTRL_REG, 0x3fu );
+  REG_CLR_BIT( LP_APM_FUNC_CTRL_REG, 0x0fu );
+  for ( uint32_t reg = LP_PERI_PMS_LP_SYSREG_CTRL_REG;
+        reg <= LP_PERI_PMS_LP_DAC_CTRL_REG; reg += 4 ) {
+    REG_WRITE( reg, 0xff );
+  }
+  for ( uint32_t reg = HP_PERI0_PMS_TRACE0_CTRL_REG;
+        reg <= HP_PERI0_PMS_AXI_PERF_MON_CTRL_REG; reg += 4 ) {
+    REG_WRITE( reg, 0xff );
+  }
+  for ( uint32_t reg = HP_PERI1_PMS_HP_USBOTG_PHY_CTRL_REG;
+        reg <= HP_PERI1_PMS_HP_USBOTG_PHY_CTRL_REG; reg += 4 ) {
+    REG_WRITE( reg, 0xff );
+  }
+  rtems_s31_modem_clock_init();
+#elif defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+  /* ESP-IDF has no software modem power-domain sequence on C5.
+   * Clock dependencies are enabled by the OS adapter and PHY lifecycle.
+   */
+  /* bootloader_init_mem(): permit DMA masters on the direct-boot path. */
+  apm_ll_hp_apm_enable_ctrl_filter_all( false );
+  apm_ll_lp_apm0_enable_ctrl_filter_all( false );
+  apm_ll_lp_apm_enable_ctrl_filter_all( false );
+  apm_ll_cpu_apm_enable_ctrl_filter_all( false );
+  uint32_t master_mask = APM_MASTER_MASK_ALL;
+  while ( master_mask != 0 ) {
+    uint32_t master = __builtin_ctz( master_mask );
+    master_mask &= ~( 1u << master );
+    apm_ll_hp_tee_set_master_sec_mode( master, APM_SEC_MODE_TEE );
+    if ( master == APM_MASTER_LPCORE ) {
+      apm_ll_lp_tee_set_master_sec_mode( master, APM_SEC_MODE_TEE );
+    }
+  }
+  rtems_c5_modem_clock_init();
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+  /* bootloader_init_mem(): direct boot must permit DMA access. */
+  apm_ll_hp_apm_enable_ctrl_filter_all( false );
+  apm_ll_lp_apm0_enable_ctrl_filter_all( false );
+  apm_ll_lp_apm_enable_ctrl_filter_all( false );
+  /* C6 has no software modem power-domain sequence or USB PHY workaround. */
+  rtems_c6_modem_clock_init();
+#else
+  /*
+   * Before the PHY, not after.  register_chipv7_phy() calibrates against the
+   * analog blocks, and on silicon they have to be powered and out of isolation
+   * first or the calibration loops never converge.
+   */
+  printk( "rtems-esp-wifi: powering the modem domain...\n" );
+  rtems_esp_wifi_power_domain_on();
+  rtems_esp_wifi_clocks_on();
+  /* IDF opens the BBPLL and SAR/TSENS targets rather than unmasking
+   * every analog device. The BSP already set the CPU and ROM delay clock.
+   */
+  regi2c_ctrl_ll_i2c_bbpll_enable();
+  regi2c_ctrl_ll_i2c_sar_periph_enable();
+
+#endif
+
+  esp_wifi_set_sleep_min_active_time( RTEMS_WIFI_MIN_ACTIVE_TIME_US );
+  esp_wifi_set_keep_alive_time( RTEMS_WIFI_KEEP_ALIVE_TIME_US );
+  esp_wifi_set_sleep_wait_broadcast_data_time(
+    RTEMS_WIFI_WAIT_BROADCAST_DATA_TIME_US
+  );
+
+#if !defined(RTEMS_ESP_WIFI_MANAGED_PHY)
+  result = rtems_esp_wifi_calibrate();
+  if ( result != ESP_OK ) {
+    return result;
+  }
+#endif
+
+  printk( "rtems-esp-wifi: esp_wifi_init_internal()...\n" );
 
   result = esp_wifi_init_internal( config );
 
@@ -881,6 +1334,13 @@ esp_err_t esp_wifi_init( const wifi_init_config_t *config )
     return result;
   }
 
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+  rtems_c5_wifi_initialized = true;
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+  rtems_c6_wifi_initialized = true;
+#elif defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+  rtems_s31_wifi_initialized = true;
+#endif
   rtems_wifi_inited = true;
 
   return ESP_OK;
