+    modem_##dev##_ll_get_##name##_icg_bitmap( &MODEM_##symbol ) | ( bits ) )
+  C5_ICG_MAP( syscon, SYSCON, modem_apb, 6 );
+  C5_ICG_MAP( syscon, SYSCON, modem_periph, 4 );
+  C5_ICG_MAP( syscon, SYSCON, wifi, 6 );
+  C5_ICG_MAP( syscon, SYSCON, bt, 4 );
+  C5_ICG_MAP( syscon, SYSCON, fe, 6 );
+  C5_ICG_MAP( syscon, SYSCON, ieee802154, 4 );
