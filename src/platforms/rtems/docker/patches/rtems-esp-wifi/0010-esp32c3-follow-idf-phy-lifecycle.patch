+#if defined(RTEMS_BOARD_ESP32C3) || defined(CONFIG_IDF_TARGET_ESP32C3)
+/* C3 is uniprocessor. Keep the saved level in each caller's token so nested
+ * PHY critical sections restore the outer interrupt state, as IDF does.
+ */
+uint32_t IRAM_ATTR phy_enter_critical(void)
+{
+  rtems_interrupt_level level;
+  rtems_interrupt_local_disable( level );
+  return level;
+}
+
+void IRAM_ATTR phy_exit_critical(uint32_t level)
+{
+  rtems_interrupt_local_enable( level );
+}
+
+/* IDF's phy_override.c also protects the PHY's analog I2C transactions.
+ * These hooks have no token argument, so retain the outermost saved level.
+ * With one C3 CPU, masked interrupts exclude both tasks and ISRs.
+ */
+static unsigned rtems_phy_i2c_depth;
+static rtems_interrupt_level rtems_phy_i2c_level;
+
+void IRAM_ATTR phy_i2c_enter_critical(void)
+{
+  rtems_interrupt_level level;
+  rtems_interrupt_local_disable( level );
+  if ( rtems_phy_i2c_depth++ == 0 ) {
+    rtems_phy_i2c_level = level;
+  }
+}
+
+void IRAM_ATTR phy_i2c_exit_critical(void)
+{
+  if ( --rtems_phy_i2c_depth == 0 ) {
+    rtems_interrupt_local_enable( rtems_phy_i2c_level );
+  }
