+void rtems_esp_bt_periph_enable( void )
+{
+  /* esp_bt_controller_init(): periph_module_enable(), then reset(). */
+  periph_ll_enable_clk_clear_rst( PERIPH_BT_MODULE );
+  periph_ll_reset( PERIPH_BT_MODULE );
+  rtems_bt_periph_enabled = true;
+}
+#endif
+
 static void rtems_phy_track( void )
 {
-  phy_param_track_tot( true, false );
-  rtems_last_track_us = rtems_clock_get_uptime_nanoseconds() / 1000;
+  phy_param_track_tot(
+    ( rtems_phy_modems & PHY_MODEM_WIFI ) != 0,
+    ( rtems_phy_modems & PHY_MODEM_BT ) != 0
+  );
+  uint64_t now = rtems_clock_get_uptime_nanoseconds() / 1000;
+  if ( rtems_phy_modems & PHY_MODEM_WIFI ) {
+    rtems_last_track_us = now;
+  }
+  if ( rtems_phy_modems & PHY_MODEM_BT ) {
+    rtems_bt_last_track_us = now;
+  }
+}
+
+static void rtems_phy_track_if_due( void )
+{
+  uint64_t now = rtems_clock_get_uptime_nanoseconds() / 1000;
+  if ( ( ( rtems_phy_modems & PHY_MODEM_WIFI )
+         && now - rtems_last_track_us > 1000000 )
+       || ( ( rtems_phy_modems & PHY_MODEM_BT )
+            && now - rtems_bt_last_track_us > 1000000 ) ) {
+    rtems_phy_track();
+  }
 }

 void rtems_esp_wifi_phy_track( void )
 {
   pthread_mutex_lock( &rtems_phy_lock );
-  if ( rtems_phy_enabled ) {
-    rtems_phy_track();
-  }
+  rtems_phy_track_if_due();
   pthread_mutex_unlock( &rtems_phy_lock );
 }

