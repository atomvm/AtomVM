Subject: [PATCH] Preserve owner interrupt contexts across SMP lock contention

Acquire using a local context, then save it only while owning the lock.
Copy it back before release so the next owner cannot change the interrupt
state being restored. Keep the opaque ESP callback return value unchanged.

--- a/src/rtems_wifi_os_adapter.c
+++ b/src/rtems_wifi_os_adapter.c
@@ -118,10 +118,9 @@
 /* === interrupts and spin locks ======================================== */
 
 /*
- * The context has to live with the lock rather than be returned, because the
- * signature returns a uint32_t and RTEMS hands back a structure.  One context
- * per lock is enough for the same reason it is in the PHY glue: these nest,
- * they do not interleave.
+ * The ESP callbacks return an opaque uint32_t. Keep the owner's context
+ * with the lock, but acquire and release through local copies so a waiting
+ * CPU cannot overwrite the interrupt state of the current owner.
  */
 typedef struct {
   rtems_interrupt_lock          lock;
@@ -156,10 +155,10 @@
     return 0;
   }
 
-  rtems_interrupt_lock_acquire(
-    (rtems_interrupt_lock *) mux,
-    &( (rtems_wifi_int_lock *) mux )->context
-  );
+  rtems_wifi_int_lock *lock = mux;
+  rtems_interrupt_lock_context context;
+  rtems_interrupt_lock_acquire( &lock->lock, &context );
+  lock->context = context;
 
   return 0;
 }
@@ -172,10 +171,9 @@
     return;
   }
 
-  rtems_interrupt_lock_release(
-    (rtems_interrupt_lock *) mux,
-    &( (rtems_wifi_int_lock *) mux )->context
-  );
+  rtems_wifi_int_lock *lock = mux;
+  rtems_interrupt_lock_context context = lock->context;
+  rtems_interrupt_lock_release( &lock->lock, &context );
 }
 
 static bool rtems_wifi_is_from_isr( void )
--- a/src/rtems_esp_glue.c
+++ b/src/rtems_esp_glue.c
@@ -116,9 +116,8 @@
  *
  * RTEMS' interrupt lock returns the previous level through a context object
  * rather than as a value, and ESP-IDF's signature returns a uint32_t.  The
- * context is kept here rather than handed out, which is sound because the
- * calls nest rather than interleave -- libphy always exits the section it
- * entered last, and the level it passes back is the one it was given.
+ * owner's context is kept here rather than handed out. Acquire and release
+ * through local copies so a competing CPU cannot overwrite its saved level.
  */
 RTEMS_INTERRUPT_LOCK_DEFINE( static, rtems_esp_phy_lock, "ESP PHY" )
 
@@ -126,10 +125,9 @@
 
 uint32_t phy_enter_critical(void)
 {
-  rtems_interrupt_lock_acquire(
-    &rtems_esp_phy_lock,
-    &rtems_esp_phy_lock_context
-  );
+  rtems_interrupt_lock_context context;
+  rtems_interrupt_lock_acquire( &rtems_esp_phy_lock, &context );
+  rtems_esp_phy_lock_context = context;
 
   /*
    * The value is opaque to the caller: libphy passes back whatever it was
@@ -143,10 +141,8 @@
 {
   (void) level;
 
-  rtems_interrupt_lock_release(
-    &rtems_esp_phy_lock,
-    &rtems_esp_phy_lock_context
-  );
+  rtems_interrupt_lock_context context = rtems_esp_phy_lock_context;
+  rtems_interrupt_lock_release( &rtems_esp_phy_lock, &context );
 }
 
