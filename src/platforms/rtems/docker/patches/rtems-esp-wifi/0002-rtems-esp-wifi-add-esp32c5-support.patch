Subject: [PATCH] rtems-esp-wifi: add ESP32-C5 target and register layouts

Select the C5 PHY configuration, eFuse base and modem clock/reset registers.
Configure direct-boot memory access and keep the RFPLL shim confined to C6.
Match ESP-IDF coexistence-disabled callbacks instead of reporting failures.

diff --git a/include/rtems-esp/sdkconfig.h b/include/rtems-esp/sdkconfig.h
--- a/include/rtems-esp/sdkconfig.h
+++ b/include/rtems-esp/sdkconfig.h
@@ -39,7 +39,12 @@
 #ifndef RTEMS_ESP_SDKCONFIG_H
 #define RTEMS_ESP_SDKCONFIG_H
 
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#define CONFIG_IDF_TARGET_ESP32C5 1
+#define CONFIG_IDF_TARGET "esp32c5"
+#define CONFIG_SOC_WIFI_HE_SUPPORT 1
+#define CONFIG_SOC_WIFI_SUPPORT_5G 1
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
 #define CONFIG_IDF_TARGET_ESP32C6 1
 #define CONFIG_IDF_TARGET "esp32c6"
 #define CONFIG_SOC_WIFI_HE_SUPPORT 1
@@ -61,7 +66,9 @@
 #define CONFIG_ESP_WIFI_FTM_ENABLE 1
 
 /* The C3 is 2.4 GHz only. */
+#if !defined(CONFIG_SOC_WIFI_SUPPORT_5G)
 #define CONFIG_SOC_WIFI_SUPPORT_5G 0
+#endif
 
 /*
  * Maximum transmit power, in dBm, asked for by esp_phy/esp32c3/phy_init_data.c
diff --git a/src/rtems_esp_glue.c b/src/rtems_esp_glue.c
--- a/src/rtems_esp_glue.c
+++ b/src/rtems_esp_glue.c
@@ -368,12 +368,14 @@
   return dst;
 }
 
+#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6) || defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+uint32_t rtc_clk_xtal_freq_get( void )
+{
+  return 40u;
+}
+#endif
+
 #if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
-uint32_t rtc_clk_xtal_freq_get( void )
-{
-  return 40u;
-}
-
 void phy_rfpll_cap_track_new( uint8_t cap );
 void rfpll_cap_track( uint8_t cap )
 {
diff --git a/src/rtems_esp_netif.c b/src/rtems_esp_netif.c
--- a/src/rtems_esp_netif.c
+++ b/src/rtems_esp_netif.c
@@ -890,6 +890,14 @@
   unsigned char *mac_address
 ) __attribute__((alias("esp32c3_netif_add")));
 
+int esp32c5_netif_add(
+  struct netif  *net_interface,
+  ip_addr_t     *ipaddr,
+  ip_addr_t     *netmask,
+  ip_addr_t     *gateway,
+  unsigned char *mac_address
+) __attribute__((alias("esp32c3_netif_add")));
+
 int esp32c6_netif_add(
   struct netif  *net_interface,
   ip_addr_t     *ipaddr,
diff --git a/src/rtems_esp_wifi_init.c b/src/rtems_esp_wifi_init.c
--- a/src/rtems_esp_wifi_init.c
+++ b/src/rtems_esp_wifi_init.c
@@ -156,7 +156,7 @@
  * .data and .fast_text; the constant is repeated here rather than shared
  * because the BSP does not export it.
  */
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6) || defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
 #define RTEMS_ESP_FLASH_MAPPED_BASE 0x42000000
 #else
 #define RTEMS_ESP_FLASH_MAPPED_BASE 0x3c000000
@@ -336,7 +336,9 @@
 #define RTEMS_WIFI_CAL_MODE PHY_RF_CAL_FULL
 #endif
 
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#define RTEMS_WIFI_EFUSE_BASE         0x600B4800u
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
 #define RTEMS_WIFI_EFUSE_BASE         0x600B0800u
 #else
 #define RTEMS_WIFI_EFUSE_BASE         0x60008800u
@@ -454,7 +456,7 @@
  * The BBPLL itself is already running -- the USB-Serial-JTAG that carries this
  * console is fed from it -- so only the CPU mux and the divider move here.
  */
-#if !defined(RTEMS_BOARD_ESP32C6) && !defined(CONFIG_IDF_TARGET_ESP32C6)
+#if !defined(RTEMS_BOARD_ESP32C6) && !defined(CONFIG_IDF_TARGET_ESP32C6) && !defined(RTEMS_BOARD_ESP32C5) && !defined(CONFIG_IDF_TARGET_ESP32C5)
 static void rtems_esp_wifi_cpu_clock_to_pll( void )
 {
   uint32_t reg;
@@ -608,7 +610,34 @@
 
   rtems_esp_wifi_copy_sections();
 
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+  printk( "rtems-esp-wifi: enabling ESP32-C5 modem clocks...\n" );
+  rtems_wifi_reg_write( 0x600A9C00u, rtems_wifi_reg_read( 0x600A9C00u ) | 1u );
+  rtems_wifi_reg_write( 0x600A9C04u, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x600A9C08u, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x600A9C14u, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x600AF000u, rtems_wifi_reg_read( 0x600AF000u ) | 1u );
+  rtems_wifi_reg_write( 0x600AF018u, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x600AF01Cu, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x600990C4u, 0 );
+  rtems_wifi_reg_write( 0x600998C4u, 0 );
+  rtems_wifi_reg_write( 0x6009A0C4u, 0 );
+  rtems_wifi_reg_write( 0x600B38C4u, 0 );
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+    "csrw 0xbcc, x0\n"
+    "csrw 0xbcd, x0\n"
+    "csrw 0xbce, x0\n"
+    "csrw 0xbcf, x0\n"
+    "csrw 0xbdc, x0\n"
+    "csrw 0xbdd, x0\n"
+    "csrw 0xbde, x0\n"
+    "csrw 0xbdf, x0\n"
+    ".option pop\n"
+    ::: "memory"
+  );
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
   printk( "rtems-esp-wifi: enabling ESP32-C6 modem clocks...\n" );
   rtems_wifi_reg_write( 0x600A9804u, rtems_wifi_reg_read( 0x600A9804u ) | 0xFFFFFFFFu );
   rtems_wifi_reg_write( 0x600AF004u, rtems_wifi_reg_read( 0x600AF004u ) | 0xFFFFFFFFu );
diff --git a/src/rtems_wifi_os_adapter.c b/src/rtems_wifi_os_adapter.c
--- a/src/rtems_wifi_os_adapter.c
+++ b/src/rtems_wifi_os_adapter.c
@@ -1400,7 +1400,11 @@
  * esp-hal-3rdparty rather than from memory; each is named below.
  */
 
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#define RTEMS_WIFI_EFUSE_BASE         0x600B4800u
+#define RTEMS_WIFI_EFUSE_MAC0_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x44u )
+#define RTEMS_WIFI_EFUSE_MAC1_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x48u )
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
 #define RTEMS_WIFI_EFUSE_BASE         0x600B0800u
 #define RTEMS_WIFI_EFUSE_MAC0_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x44u )
 #define RTEMS_WIFI_EFUSE_MAC1_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x48u )
@@ -1441,7 +1445,12 @@
 
 static void rtems_wifi_clock_enable( void )
 {
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+  rtems_wifi_reg_write(
+    0x600A9C14u,
+    rtems_wifi_reg_read( 0x600A9C14u ) | ( 1u << 9 ) | ( 1u << 10 )
+  );
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
   /* MODEM_SYSCON_CLK_CONF_REG (0x600A9804) bit 9: MODEM_SYSCON_CLK_WIFIMAC_EN */
   rtems_wifi_reg_write(
     0x600A9804u,
@@ -1465,7 +1474,12 @@
 
 static void rtems_wifi_clock_disable( void )
 {
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+  rtems_wifi_reg_write(
+    0x600A9C14u,
+    rtems_wifi_reg_read( 0x600A9C14u ) & ~( ( 1u << 9 ) | ( 1u << 10 ) )
+  );
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
   rtems_wifi_reg_write(
     0x600A9804u,
     rtems_wifi_reg_read( 0x600A9804u ) & ~( 1u << 9 )
@@ -1480,7 +1494,11 @@
 
 static void rtems_wifi_reset_mac( void )
 {
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+  uint32_t reg = rtems_wifi_reg_read( 0x600A9C10u );
+  rtems_wifi_reg_write( 0x600A9C10u, reg | ( 1u << 9 ) );
+  rtems_wifi_reg_write( 0x600A9C10u, reg & ~( 1u << 9 ) );
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
   /* MODEM_SYSCON_MODEM_RST_CONF_REG (0x600A9814) bit 10: MODEM_SYSCON_RST_WIFIMAC */
   uint32_t reg = rtems_wifi_reg_read( 0x600A9814u );
   rtems_wifi_reg_write( 0x600A9814u, reg | ( 1u << 10 ) );
@@ -1921,11 +1939,11 @@
     ( rtems_clock_get_uptime_nanoseconds() / 1000000u );
 }
 
+/* Match ESP-IDF wrappers with software/external coexistence disabled. */
 static void rtems_wifi_stub_coex_condition_set( uint32_t type, bool dissatisfy )
 {
   (void) type;
   (void) dissatisfy;
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
 }
 
 static int rtems_wifi_stub_coex_wifi_request( uint32_t event, uint32_t latency, uint32_t duration )
@@ -1933,72 +1951,61 @@
   (void) event;
   (void) latency;
   (void) duration;
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
-  return ESP_FAIL;
+  return ESP_OK;
 }
 
 static int rtems_wifi_stub_coex_wifi_release( uint32_t event )
 {
   (void) event;
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
-  return ESP_FAIL;
+  return ESP_OK;
 }
 
 static int rtems_wifi_stub_coex_wifi_channel_set( uint8_t primary, uint8_t secondary )
 {
   (void) primary;
   (void) secondary;
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
-  return ESP_FAIL;
+  return ESP_OK;
 }
 
 static int rtems_wifi_stub_coex_event_duration_get( uint32_t event, uint32_t *duration )
 {
   (void) event;
   (void) duration;
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
-  return ESP_FAIL;
+  return ESP_OK;
 }
 
 static uint32_t rtems_wifi_stub_coex_schm_interval_get( void )
 {
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
   return 0;
 }
 
 static uint8_t rtems_wifi_stub_coex_schm_curr_period_get( void )
 {
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
   return 0;
 }
 
 static void *rtems_wifi_stub_coex_schm_curr_phase_get( void )
 {
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
   return NULL;
 }
 
 static int rtems_wifi_stub_coex_schm_process_restart( void )
 {
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
-  return ESP_FAIL;
+  return ESP_OK;
 }
 
 static int rtems_wifi_stub_coex_schm_flexible_period_set( uint8_t )
 {
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
-  return ESP_FAIL;
+  return ESP_OK;
 }
 
 static uint8_t rtems_wifi_stub_coex_schm_flexible_period_get( void )
 {
-  RTEMS_WIFI_UNIMPLEMENTED( "esp_coex" );
-  return 0;
+  return 1;
 }
 
 static void *rtems_wifi_stub_coex_schm_get_phase_by_idx( int )
 {
