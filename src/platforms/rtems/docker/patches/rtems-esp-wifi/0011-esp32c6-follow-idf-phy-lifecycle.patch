+#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+/* ESP-IDF: esp_hw_support/modem/port/esp32c6/modem_clock_impl.c,
+ * hal/esp32c6/modem_clock_hal.c and esp_phy/src/phy_init.c.
+ * RTEMS supplies the lock and timer; use the vendor LL register operations.
+ */
+#define MODEM_SYSCON (*(modem_syscon_dev_t *) 0x600a9800u)
+#define MODEM_LPCON (*(modem_lpcon_dev_t *) 0x600af000u)
+#define RTEMS_C6_PMU (*(pmu_dev_t *) 0x600b0000u)
+
+static bool rtems_c6_wifi_clock_enabled;
+static bool rtems_c6_wifi_initialized;
+
+static void rtems_c6_clock_maps_init( void )
+{
+  /* rtc_clk_modem_clock_domain_active_state_icg_map_preinit(): direct
+   * boot has no IDF bootloader to select the ACTIVE modem ICG code.
+   */
+  RTEMS_C6_PMU.hp_sys[0].icg_modem.code = 2;
+  MODEM_LPCON.i2c_mst_clk_conf.clk_i2c_mst_sel_160m = 1;
+  /* Preserve existing maps, as modem_clock_module_icg_map_init_all() does.
+   * ACTIVE=BIT(2), MODEM=BIT(1); sleep remains gated.
+   */
+#define C6_ICG_MAP( dev, symbol, name, bits ) \
+  modem_##dev##_ll_set_##name##_icg_bitmap( &MODEM_##symbol, \
+    modem_##dev##_ll_get_##name##_icg_bitmap( &MODEM_##symbol ) | ( bits ) )
+  C6_ICG_MAP( syscon, SYSCON, modem_apb, 6 );
+  C6_ICG_MAP( syscon, SYSCON, modem_periph, 4 );
+  C6_ICG_MAP( syscon, SYSCON, wifi, 6 );
+  C6_ICG_MAP( syscon, SYSCON, bt, 4 );
+  C6_ICG_MAP( syscon, SYSCON, fe, 6 );
+  C6_ICG_MAP( syscon, SYSCON, ieee802154, 4 );
+  C6_ICG_MAP( lpcon, LPCON, lp_apb, 6 );
+  C6_ICG_MAP( lpcon, LPCON, i2c_master, 6 );
+  C6_ICG_MAP( lpcon, LPCON, coex, 6 );
+  C6_ICG_MAP( lpcon, LPCON, wifipwr, 6 );
+#undef C6_ICG_MAP
+  RTEMS_C6_PMU.imm.modem_icg.update_dig_icg_modem_en = 1;
+  RTEMS_C6_PMU.imm.sleep_sysclk.update_dig_icg_switch = 1;
+}
+
+static void rtems_c6_modem_clock_init( void )
+{
+  /* esp_system/port/soc/esp32c6/clk.c: esp_perip_clk_init(). */
+  uint32_t slow_src = rtems_wifi_reg_read( LP_CLKRST_LP_CLK_CONF_REG ) & 3u;
+  rtems_c6_clock_maps_init();
+  modem_lpcon_ll_enable_wifi_lpclk_slow_osc( &MODEM_LPCON, false );
+  modem_lpcon_ll_enable_wifi_lpclk_fast_osc( &MODEM_LPCON, false );
+  modem_lpcon_ll_enable_wifi_lpclk_main_xtal( &MODEM_LPCON, false );
+  modem_lpcon_ll_enable_wifi_lpclk_32k_xtal( &MODEM_LPCON, false );
+  if ( slow_src != 0u ) {
+    modem_lpcon_ll_enable_wifi_lpclk_32k_xtal( &MODEM_LPCON, true );
+    modem_lpcon_ll_select_modem_32k_clock_source( &MODEM_LPCON,
+      slow_src == 1u ? MODEM_CLOCK_32K_SRC_XTAL32K
+        : slow_src == 2u ? MODEM_CLOCK_32K_SRC_RC32K : MODEM_CLOCK_32K_SRC_EXT32K );
+  } else {
+    modem_lpcon_ll_enable_wifi_lpclk_slow_osc( &MODEM_LPCON, true );
+  }
+  modem_lpcon_ll_set_wifi_lpclk_divisor_value( &MODEM_LPCON, 0 );
+  modem_lpcon_ll_enable_wifipwr_clock( &MODEM_LPCON, true );
+}
+
+void rtems_esp_wifi_c6_clock_enable( void )
+{
+  pthread_mutex_lock( &rtems_phy_lock );
+  rtems_c6_clock_maps_init();
+  modem_syscon_ll_enable_wifi_mac_clock( &MODEM_SYSCON, true );
+  modem_syscon_ll_enable_wifi_apb_clock( &MODEM_SYSCON, true );
+  modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, true );
+  modem_lpcon_ll_enable_coex_clock( &MODEM_LPCON, true );
+  rtems_c6_wifi_clock_enabled = true;
+  pthread_mutex_unlock( &rtems_phy_lock );
+}
+
+void rtems_esp_wifi_c6_clock_disable( void )
+{
+  pthread_mutex_lock( &rtems_phy_lock );
+  /* IDF keeps MAC/BB/APB clocks on while Wi-Fi is initialized. */
+  if ( !rtems_c6_wifi_initialized ) {
+    modem_syscon_ll_enable_wifi_mac_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_enable_wifi_apb_clock( &MODEM_SYSCON, false );
+    modem_syscon_ll_clk_wifibb_configure( &MODEM_SYSCON, false );
+  }
+  modem_lpcon_ll_enable_coex_clock( &MODEM_LPCON, false );
+  rtems_c6_wifi_clock_enabled = false;
   pthread_mutex_unlock( &rtems_phy_lock );
 }
 
@@ -801,6 +894,19 @@
     modem_syscon_ll_enable_bt_bb_clock( &MODEM_SYSCON, true );
     modem_syscon_ll_enable_bt_apb_clock( &MODEM_SYSCON, true );
