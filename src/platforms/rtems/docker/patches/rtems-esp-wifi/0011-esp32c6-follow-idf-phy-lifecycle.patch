diff --git a/src/rtems_esp_glue.c b/src/rtems_esp_glue.c
--- a/src/rtems_esp_glue.c
+++ b/src/rtems_esp_glue.c
@@ -120,8 +120,9 @@
  * owner's context is kept here rather than handed out. Acquire and release
  * through local copies so a competing CPU cannot overwrite its saved level.
  */
-#if defined(RTEMS_BOARD_ESP32C3) || defined(CONFIG_IDF_TARGET_ESP32C3)
-/* C3 is uniprocessor. Keep the saved level in each caller's token so nested
+#if defined(RTEMS_BOARD_ESP32C3) || defined(CONFIG_IDF_TARGET_ESP32C3) \
+  || defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
+/* C3/C6 use one application CPU. Keep the saved level in each caller's token so nested
  * PHY critical sections restore the outer interrupt state, as IDF does.
  */
