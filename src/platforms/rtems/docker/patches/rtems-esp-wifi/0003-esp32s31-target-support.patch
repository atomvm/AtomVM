From f38ac2d14c862346bc953e08f3e7f6ca4c2664da Mon Sep 17 00:00:00 2001
From: Peter M <petermm@gmail.com>
Date: Thu, 15 Oct 2026 19:18:24 +0200
Subject: [PATCH 3/8] rtems-esp-wifi: add ESP32-S31 target support

Consolidated from the following downstream patches. Original rationale
and provenance are retained below; source licensing is unchanged.

Original-patch: 0003-rtems-esp-wifi-add-esp32s31-support.patch
Original-author: Peter M <petermm@gmail.com>
Original-date: Thu, 15 Oct 2026 19:18:24 +0200
AtomVM-origin-commit: 53a7d9d2ec4fa2aae2dfcadbd633bd3b4a4d505c

rtems-esp-wifi: add ESP32-S31 target and register layouts

Select the S31 PHY configuration, eFuse base and modem clock/reset registers.
The S31 is 2.4 GHz Wi-Fi 6 only, so HE is enabled without 5 GHz support.
The S31 eFuse MAC words sit at 0x50/0x54 rather than 0x44/0x48.  Provide the
S31-only coexistence preemption-end callback entry so the OS adapter table
matches the Wi-Fi binaries' wifi_osi_funcs layout.

Signed-off-by: Peter M <petermm@gmail.com>
---
 include/rtems-esp/sdkconfig.h |  4 +++
 src/rtems_esp_glue.c          |  2 +-
 src/rtems_esp_netif.c         |  7 +++++
 src/rtems_esp_wifi_init.c     | 44 +++++++++++++++++++++++++++++---
 src/rtems_wifi_os_adapter.c   | 48 ++++++++++++++++++++++++++++++++---
 5 files changed, 96 insertions(+), 9 deletions(-)

diff --git a/include/rtems-esp/sdkconfig.h b/include/rtems-esp/sdkconfig.h
index 55286dd8899e570699cc20cb8df05b7c8d864f55..7ba19d9687b92d5805675e6b710499bec5b7d972 100644
--- a/include/rtems-esp/sdkconfig.h
+++ b/include/rtems-esp/sdkconfig.h
@@ -44,6 +44,10 @@
 #define CONFIG_IDF_TARGET "esp32c5"
 #define CONFIG_SOC_WIFI_HE_SUPPORT 1
 #define CONFIG_SOC_WIFI_SUPPORT_5G 1
+#elif defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+#define CONFIG_IDF_TARGET_ESP32S31 1
+#define CONFIG_IDF_TARGET "esp32s31"
+#define CONFIG_SOC_WIFI_HE_SUPPORT 1
 #elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
 #define CONFIG_IDF_TARGET_ESP32C6 1
 #define CONFIG_IDF_TARGET "esp32c6"
diff --git a/src/rtems_esp_glue.c b/src/rtems_esp_glue.c
index 211fbf157f431221ac1eb703f9cbbe07450f7f60..42aa8d7253687c4a2ce1f864783cea747fabf97c 100644
--- a/src/rtems_esp_glue.c
+++ b/src/rtems_esp_glue.c
@@ -368,7 +368,7 @@ void *memcpy( void *dst, const void *src, size_t n )
   return dst;
 }
 
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6) || defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6) || defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5) || defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
 uint32_t rtc_clk_xtal_freq_get( void )
 {
 #if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
diff --git a/src/rtems_esp_netif.c b/src/rtems_esp_netif.c
index d92b9e50391ba84adfcc104caa5b8ed758600c5a..89ddfec95ecb1846fb8365b00eecb5bf68e3112f 100644
--- a/src/rtems_esp_netif.c
+++ b/src/rtems_esp_netif.c
@@ -906,3 +906,10 @@ int esp32c6_netif_add(
   unsigned char *mac_address
 ) __attribute__((alias("esp32c3_netif_add")));
 
+int esp32s31_netif_add(
+  struct netif  *net_interface,
+  ip_addr_t     *ipaddr,
+  ip_addr_t     *netmask,
+  ip_addr_t     *gateway,
+  unsigned char *mac_address
+) __attribute__((alias("esp32c3_netif_add")));
diff --git a/src/rtems_esp_wifi_init.c b/src/rtems_esp_wifi_init.c
index a0f660af5512605856448e2f8c37faebec65e8b9..11f56cf3201cabe35c2fa6754c1c7ce621a3638b 100644
--- a/src/rtems_esp_wifi_init.c
+++ b/src/rtems_esp_wifi_init.c
@@ -156,7 +156,9 @@ extern char esp32c_iram_to_dram_delta[];
  * .data and .fast_text; the constant is repeated here rather than shared
  * because the BSP does not export it.
  */
-#if defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6) || defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+#define RTEMS_ESP_FLASH_MAPPED_BASE 0x40000000
+#elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6) || defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
 #define RTEMS_ESP_FLASH_MAPPED_BASE 0x42000000
 #else
 #define RTEMS_ESP_FLASH_MAPPED_BASE 0x3c000000
@@ -336,15 +338,22 @@ static inline void rtems_wifi_reg_write( uint32_t addr, uint32_t value )
 #define RTEMS_WIFI_CAL_MODE PHY_RF_CAL_FULL
 #endif
 
-#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+#define RTEMS_WIFI_EFUSE_BASE         0x20715000u
+#elif defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
 #define RTEMS_WIFI_EFUSE_BASE         0x600B4800u
 #elif defined(RTEMS_BOARD_ESP32C6) || defined(CONFIG_IDF_TARGET_ESP32C6)
 #define RTEMS_WIFI_EFUSE_BASE         0x600B0800u
 #else
 #define RTEMS_WIFI_EFUSE_BASE         0x60008800u
 #endif
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+#define RTEMS_WIFI_EFUSE_MAC0_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x50u )
+#define RTEMS_WIFI_EFUSE_MAC1_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x54u )
+#else
 #define RTEMS_WIFI_EFUSE_MAC0_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x44u )
 #define RTEMS_WIFI_EFUSE_MAC1_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x48u )
+#endif
 
 /*
  * Says whether the blocks the calibration spins on are clocked.
@@ -456,7 +465,7 @@ static void rtems_esp_wifi_probe_window(
  * The BBPLL itself is already running -- the USB-Serial-JTAG that carries this
  * console is fed from it -- so only the CPU mux and the divider move here.
  */
-#if !defined(RTEMS_BOARD_ESP32C6) && !defined(CONFIG_IDF_TARGET_ESP32C6) && !defined(RTEMS_BOARD_ESP32C5) && !defined(CONFIG_IDF_TARGET_ESP32C5)
+#if !defined(RTEMS_BOARD_ESP32C6) && !defined(CONFIG_IDF_TARGET_ESP32C6) && !defined(RTEMS_BOARD_ESP32C5) && !defined(CONFIG_IDF_TARGET_ESP32C5) && !defined(RTEMS_BOARD_ESP32S31) && !defined(CONFIG_IDF_TARGET_ESP32S31)
 static void rtems_esp_wifi_cpu_clock_to_pll( void )
 {
   uint32_t reg;
@@ -610,7 +619,34 @@ esp_err_t esp_wifi_init( const wifi_init_config_t *config )
 
   rtems_esp_wifi_copy_sections();
 
-#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+  printk( "rtems-esp-wifi: enabling ESP32-S31 modem clocks...\n" );
+  rtems_wifi_reg_write( 0x20109C00u, rtems_wifi_reg_read( 0x20109C00u ) | 1u );
+  rtems_wifi_reg_write( 0x20109C04u, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x20109C08u, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x20109C14u, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x2010F000u, rtems_wifi_reg_read( 0x2010F000u ) | 1u );
+  rtems_wifi_reg_write( 0x2010F018u, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x2010F01Cu, 0xFFFFFFFFu );
+  rtems_wifi_reg_write( 0x205044C4u, 0 );
+  rtems_wifi_reg_write( 0x205048C4u, 0 );
+  rtems_wifi_reg_write( 0x20504CC4u, 0 );
+  rtems_wifi_reg_write( 0x20706CBCu, 0 );
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+    "csrw 0xbcc, x0\n"
+    "csrw 0xbcd, x0\n"
+    "csrw 0xbce, x0\n"
+    "csrw 0xbcf, x0\n"
+    "csrw 0xbdc, x0\n"
+    "csrw 0xbdd, x0\n"
+    "csrw 0xbde, x0\n"
+    "csrw 0xbdf, x0\n"
+    ".option pop\n"
+    ::: "memory"
+  );
+#elif defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
   printk( "rtems-esp-wifi: enabling ESP32-C5 modem clocks...\n" );
   rtems_wifi_reg_write( 0x600A9C00u, rtems_wifi_reg_read( 0x600A9C00u ) | 1u );
   rtems_wifi_reg_write( 0x600A9C04u, 0xFFFFFFFFu );
diff --git a/src/rtems_wifi_os_adapter.c b/src/rtems_wifi_os_adapter.c
index f4868d388b0f1da94814ca9d823fa986d2cb5bd5..a43a36e6f2f02a2fed4ccac9bcfdd949b5e958ee 100644
--- a/src/rtems_wifi_os_adapter.c
+++ b/src/rtems_wifi_os_adapter.c
@@ -1400,7 +1400,12 @@ static void rtems_wifi_ints_off( uint32_t mask )
  * esp-hal-3rdparty rather than from memory; each is named below.
  */
 
-#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+/* soc/esp32s31/register/soc/reg_base.h and efuse_reg.h */
+#define RTEMS_WIFI_EFUSE_BASE         0x20715000u
+#define RTEMS_WIFI_EFUSE_MAC0_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x50u )
+#define RTEMS_WIFI_EFUSE_MAC1_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x54u )
+#elif defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
 #define RTEMS_WIFI_EFUSE_BASE         0x600B4800u
 #define RTEMS_WIFI_EFUSE_MAC0_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x44u )
 #define RTEMS_WIFI_EFUSE_MAC1_REG     ( RTEMS_WIFI_EFUSE_BASE + 0x48u )
@@ -1445,7 +1450,13 @@ static bool rtems_wifi_env_is_chip( void )
 
 static void rtems_wifi_clock_enable( void )
 {
-#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+  /* MODEM_SYSCON_CLK_CONF1_REG (0x20109C14): bit 9 WIFIMAC, bit 10 WIFI_APB. */
+  rtems_wifi_reg_write(
+    0x20109C14u,
+    rtems_wifi_reg_read( 0x20109C14u ) | ( 1u << 9 ) | ( 1u << 10 )
+  );
+#elif defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
   rtems_wifi_reg_write(
     0x600A9C14u,
     rtems_wifi_reg_read( 0x600A9C14u ) | ( 1u << 9 ) | ( 1u << 10 )
@@ -1474,7 +1485,12 @@ static void rtems_wifi_clock_enable( void )
 
 static void rtems_wifi_clock_disable( void )
 {
-#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+  rtems_wifi_reg_write(
+    0x20109C14u,
+    rtems_wifi_reg_read( 0x20109C14u ) & ~( ( 1u << 9 ) | ( 1u << 10 ) )
+  );
+#elif defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
   rtems_wifi_reg_write(
     0x600A9C14u,
     rtems_wifi_reg_read( 0x600A9C14u ) & ~( ( 1u << 9 ) | ( 1u << 10 ) )
@@ -1494,7 +1510,12 @@ static void rtems_wifi_clock_disable( void )
 
 static void rtems_wifi_reset_mac( void )
 {
-#if defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
+#if defined(RTEMS_BOARD_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32S31)
+  /* MODEM_SYSCON_MODEM_RST_CONF_REG (0x20109C10) bit 9: RST_WIFIMAC. */
+  uint32_t reg = rtems_wifi_reg_read( 0x20109C10u );
+  rtems_wifi_reg_write( 0x20109C10u, reg | ( 1u << 9 ) );
+  rtems_wifi_reg_write( 0x20109C10u, reg & ~( 1u << 9 ) );
+#elif defined(RTEMS_BOARD_ESP32C5) || defined(CONFIG_IDF_TARGET_ESP32C5)
   uint32_t reg = rtems_wifi_reg_read( 0x600A9C10u );
   rtems_wifi_reg_write( 0x600A9C10u, reg | ( 1u << 9 ) );
   rtems_wifi_reg_write( 0x600A9C10u, reg & ~( 1u << 9 ) );
@@ -1623,6 +1644,22 @@ static int rtems_wifi_coex_schm_register_cb( int type, int ( *cb )( int ) )
   return ESP_OK;
 }
 
+#if CONFIG_IDF_TARGET_ESP32S31
+static int rtems_wifi_coex_configure_preemption_end_cb( bool is_register, int ( *cb )( uint32_t ) )
+{
+  (void) is_register;
+  (void) cb;
+
+  /*
+   * Preemption-end notification is a coexistence scheduling hook.  With no
+   * competing radio there is nothing to preempt, so accepting the
+   * registration without keeping the callback is accurate rather than a
+   * shortcut.
+   */
+  return ESP_OK;
+}
+#endif
+
 /* === power management, which is switched off =========================== */
 
 /*
@@ -2171,6 +2208,9 @@ wifi_osi_funcs_t g_wifi_osi_funcs = {
   ._coex_schm_flexible_period_set = rtems_wifi_stub_coex_schm_flexible_period_set,
   ._coex_schm_flexible_period_get = rtems_wifi_stub_coex_schm_flexible_period_get,
   ._coex_schm_get_phase_by_idx = rtems_wifi_stub_coex_schm_get_phase_by_idx,
+#if CONFIG_IDF_TARGET_ESP32S31
+  ._coex_configure_preemption_end_cb = rtems_wifi_coex_configure_preemption_end_cb,
+#endif
 #if CONFIG_SOC_WIFI_HE_SUPPORT
   ._wifi_disable_ac_ax = rtems_wifi_stub_disable_ac_ax,
 #endif
