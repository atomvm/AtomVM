+    return 1u << SOC_WIFI_LIGHT_SLEEP_CLK_WIDTH;
+  }
+#endif
+  return rtems_wifi_rtc_cal >> ( 19 - SOC_WIFI_LIGHT_SLEEP_CLK_WIDTH );
 }
 
