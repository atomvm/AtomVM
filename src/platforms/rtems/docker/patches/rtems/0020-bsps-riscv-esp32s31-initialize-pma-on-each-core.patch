From: Peter M <petermm@gmail.com>
Subject: [PATCH] bsps/riscv/esp32s31: allow SRAM execution on each core

The ROM leaves PMA entry 14 mapping HP TCM as read/write only. PMA is
per hart and constrains machine mode too. Clearing it in esp_wifi_init()
only fixes the calling core: with SMP the Wi-Fi task can run on the other
core and fault when it enters a function copied to SRAM.

Like ESP-IDF's per-core memory initialization, configure executable SRAM
before tasks start on both the boot processor and secondary processor.
Keep the ROM's other PMA mappings and cache attributes unchanged.

Signed-off-by: Peter M <petermm@gmail.com>
---
diff --git a/bsps/riscv/esp32/include/bsp.h b/bsps/riscv/esp32/include/bsp.h
--- a/bsps/riscv/esp32/include/bsp.h
+++ b/bsps/riscv/esp32/include/bsp.h
@@ -75,6 +75,10 @@
 extern "C" {
 #endif
 
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+void bsp_esp32s31_initialize_pma( void );
+#endif
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/bsps/riscv/esp32/start/bspsmp.c b/bsps/riscv/esp32/start/bspsmp.c
--- a/bsps/riscv/esp32/start/bspsmp.c
+++ b/bsps/riscv/esp32/start/bspsmp.c
@@ -25,6 +25,7 @@
  * SUCH DAMAGE.
  */
 
+#include <bsp.h>
 #include <bsp/bootcard.h>
 #include <bsp/irq.h>
 
@@ -121,6 +122,8 @@
 
 void bsp_start_on_secondary_processor( Per_CPU_Control *cpu_self )
 {
+  bsp_esp32s31_initialize_pma();
+
   uint32_t cpu_index_self = _Per_CPU_Get_index( cpu_self );
 
   if ( _SMP_Should_start_processor( cpu_index_self ) ) {
diff --git a/bsps/riscv/esp32/start/bspstart.c b/bsps/riscv/esp32/start/bspstart.c
--- a/bsps/riscv/esp32/start/bspstart.c
+++ b/bsps/riscv/esp32/start/bspstart.c
@@ -23,6 +23,7 @@
  * SUCH DAMAGE.
  */
 
+#include <bsp.h>
 #include <bsp/bootcard.h>
 #include <bsp/fatal.h>
 #include <bsp/irq-generic.h>
@@ -236,8 +237,37 @@
   }
 }
 
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+void bsp_esp32s31_initialize_pma( void )
+{
+  /*
+   * The ROM's PMA entry 14 maps the 512 KiB HP TCM as read/write, without
+   * execute permission.  PMA applies even in machine mode and is per hart.
+   * Give RTEMS the same executable SRAM mapping as ESP-IDF before starting
+   * any tasks; Wi-Fi can execute on a different hart from its initializer.
+   * Keep the ROM's other PMA regions and their cache attributes unchanged.
+   */
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+    "csrw 0xbce, zero\n"
+    "csrw 0xbde, %0\n"
+    "csrw 0xbce, %1\n"
+    ".option pop\n"
+    :
+    : "r" ( ( 0x2f000000U | ( 0x80000U / 2U - 1U ) ) >> 2 ),
+      "r" ( 0xc000001dU ) /* NAPOT, enabled, read/write/execute */
+    : "memory"
+  );
+}
+#endif
+
 void bsp_start( void )
 {
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+  bsp_esp32s31_initialize_pma();
+#endif
+
   bsp_clock_init();
 
   uint32_t timg_wdtconfig0;
