Subject: [PATCH] bsps/riscv/esp32c5: calibrate PLL before selecting CPU clock

Direct boot can leave 40 MHz crystal PLL settings on a 48 MHz board. The
nominal 160 MHz CPU then runs at 192 MHz, with incorrect peripheral clocks.
Configure and calibrate the 480 MHz PLL for the detected crystal during BSP
startup, as ESP-IDF and Zephyr do, before selecting PLL160. Use a 40 MHz
AHB clock and update ROM delay calibration across the clock transitions.

--- a/bsps/riscv/esp32/start/bspstart.c
+++ b/bsps/riscv/esp32/start/bspstart.c
@@ -88,9 +88,9 @@
  * the CPU on the crystal (20 MHz on the C3) and only throughput suffers: the
  * tick comes from the crystal-derived systimer, so timing still looks right.
  *
- * Bring the CPU up to its maximum here, the way IDF would.  The BBPLL/CPLL
- * that feeds it is already running -- the USB-Serial-JTAG that carries this
- * console is fed from it -- so only the mux and dividers move.
+ * Bring the CPU up to its maximum here, the way IDF would.  The C5 also
+ * needs BBPLL calibration for its 40 MHz or 48 MHz crystal.  Other targets
+ * retain the ROM's PLL configuration and only change muxes and dividers.
  *
  * BSP_ESP32_CPU_FREQ_MHZ selects the target in MHz and defaults to the chip
  * maximum; only the maximum is implemented so far.
@@ -138,6 +138,101 @@
 extern void ets_update_cpu_frequency( uint32_t cpu_mhz )
   __attribute__( ( weak ) );
 
+
+#if defined( LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H )
+#define C5_MODEM_SYSCON_BASE (uintptr_t) 0x600a9c00
+#define C5_MODEM_LPCON_BASE (uintptr_t) 0x600af000
+#define C5_ANALOG_I2C_BASE (uintptr_t) 0x600af800
+#define C5_PMU_BASE (uintptr_t) 0x600b0000
+
+static void bsp_c5_bbpll_i2c_write(
+  uint32_t address,
+  uint32_t mask,
+  uint32_t value
+)
+{
+  uint32_t host = ( READ_REG( C5_ANALOG_I2C_BASE, 0x20 ) & BSP_BIT32( 9 ) )
+    != 0 ? 0 : 4;
+  uint32_t command = 0x66u | ( address << 8 );
+
+  WRITE_REG( C5_ANALOG_I2C_BASE, 0x1c, 0xffff7fu );
+  while ( READ_REG( C5_ANALOG_I2C_BASE, host ) & BSP_BIT32( 25 ) ) {
+  }
+  WRITE_REG( C5_ANALOG_I2C_BASE, host, command );
+  while ( READ_REG( C5_ANALOG_I2C_BASE, host ) & BSP_BIT32( 25 ) ) {
+  }
+  uint32_t data = ( READ_REG( C5_ANALOG_I2C_BASE, host ) >> 16 ) & 0xffu;
+  data = ( data & ~mask ) | value;
+  WRITE_REG( C5_ANALOG_I2C_BASE, host,
+    command | BSP_BIT32( 24 ) | ( data << 16 ) );
+  while ( READ_REG( C5_ANALOG_I2C_BASE, host ) & BSP_BIT32( 25 ) ) {
+  }
+}
+
+static void bsp_c5_bbpll_init( void )
+{
+  /* Match ESP-IDF clk_ll_bbpll_set_config(): the ROM can leave 40 MHz
+   * PLL settings on a board with a 48 MHz crystal. Select XTAL while
+   * recalibrating the PLL, before selecting its nominal 160 MHz output.
+   */
+  uint32_t sysclk = READ_REG( CLK_PCR_BASE, CLK_PCR_SYSCLK_CONF_REG );
+  uint32_t xtal = ( sysclk >> 24 ) & 0x7fu;
+  uint32_t lp_clock = READ_REG( C5_MODEM_LPCON_BASE, 0x18 );
+  uint32_t lp_force = READ_REG( C5_MODEM_LPCON_BASE, 0x1c );
+  uint32_t i2c_clock = READ_REG( C5_MODEM_SYSCON_BASE, 0x04 );
+  uint32_t analog_mask = READ_REG( C5_ANALOG_I2C_BASE, 0x1c );
+
+  if ( xtal != 40 && xtal != 48 ) {
+    rtems_panic( "ESP32-C5: unsupported crystal frequency" );
+  }
+
+  WRITE_REG( C5_PMU_BASE, 0xd0, BSP_BIT32( 31 ) );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG,
+    READ_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG ) & ~0xffu );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG,
+    READ_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG ) & ~0xffu );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_SYSCLK_CONF_REG,
+    sysclk & ~( 3u << 16 ) );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_BUS_CLK_UPDATE_REG, 1 );
+  while ( READ_REG( CLK_PCR_BASE, CLK_PCR_BUS_CLK_UPDATE_REG ) != 0 ) {
+  }
+  if ( ets_update_cpu_frequency != NULL ) {
+    ets_update_cpu_frequency( xtal );
+  }
+
+  /* Power the PLL and force the analog master clock during calibration. */
+  WRITE_REG( C5_PMU_BASE, 0xcc, 0x72000000u );
+  WRITE_REG( C5_MODEM_LPCON_BASE, 0x18, lp_clock | BSP_BIT32( 2 ) );
+  WRITE_REG( C5_MODEM_LPCON_BASE, 0x1c, lp_force | BSP_BIT32( 2 ) );
+  WRITE_REG( C5_MODEM_SYSCON_BASE, 0x04, i2c_clock | BSP_BIT32( 12 ) );
+  uint32_t cal = READ_REG( C5_ANALOG_I2C_BASE, 0x18 );
+  WRITE_REG( C5_ANALOG_I2C_BASE, 0x18, ( cal & ~4u ) | 8u );
+
+  bsp_c5_bbpll_i2c_write( 2, 0xffu, 0x51u );
+  bsp_c5_bbpll_i2c_write( 3, 0xffu, xtal == 48 ? 10u : 12u );
+  bsp_c5_bbpll_i2c_write( 5, 0x77u, xtal == 48 ? 0x11u : 0u );
+  bsp_c5_bbpll_i2c_write( 6, 0xf0u, 0x70u );
+  bsp_c5_bbpll_i2c_write( 9, 3u, 3u );
+
+  uint32_t timeout = 1000000;
+  while ( !( READ_REG( C5_ANALOG_I2C_BASE, 0x18 ) & BSP_BIT32( 24 ) ) ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32-C5: PLL calibration timed out" );
+    }
+  }
+  /* Allow at least the 10 us settling interval required by ESP-IDF. */
+  for ( volatile uint32_t delay = 0; delay < 1000; ++delay ) {
+    __asm__ volatile ( "nop" );
+  }
+  cal = READ_REG( C5_ANALOG_I2C_BASE, 0x18 );
+  WRITE_REG( C5_ANALOG_I2C_BASE, 0x18, ( cal & ~8u ) | 4u );
+  WRITE_REG( C5_ANALOG_I2C_BASE, 0x1c, analog_mask );
+  WRITE_REG( C5_MODEM_SYSCON_BASE, 0x04, i2c_clock );
+  WRITE_REG( C5_MODEM_LPCON_BASE, 0x18, lp_clock );
+  WRITE_REG( C5_MODEM_LPCON_BASE, 0x1c, lp_force );
+}
+#endif
+
 static void bsp_clock_init( void )
 {
 #if defined( LIBBSP_ESP32_C3_CHIP_DEFINITIONS_H )
@@ -161,12 +256,14 @@
 
   uint32_t reg;
 
-  /* CPU = PLL_F160M / 1, AHB = CPU / 6 (kept <= 48 MHz). */
+  bsp_c5_bbpll_init();
+
+  /* CPU = PLL_F160M / 1, AHB = PLL_F160M / 4 = 40 MHz. */
   reg = READ_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG );
   WRITE_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG, reg & ~0xFFu );
 
   reg = READ_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG );
-  WRITE_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG, ( reg & ~0xFFu ) | 5u );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG, ( reg & ~0xFFu ) | 3u );
 
   /* SOC_CLK_SEL = PLL_F160M (2). */
   reg = READ_REG( CLK_PCR_BASE, CLK_PCR_SYSCLK_CONF_REG );
