+#define GPIO_BASE            ( (uintptr_t) 0x20583000U )
+#define IO_MUX_BASE          ( (uintptr_t) 0x20582000U )
+#define I2C_BASE             ( (uintptr_t) 0x20385000U )
+#define UART0_BASE           ( (uintptr_t) 0x2038A000U )
+#define UART1_BASE           ( (uintptr_t) 0x2038B000U )
