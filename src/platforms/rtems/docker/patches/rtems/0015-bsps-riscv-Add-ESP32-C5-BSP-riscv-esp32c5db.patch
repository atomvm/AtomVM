+/*
+ * 1-31 for the internal VIC with IRQ 0 being invalid since it corresponds to
+ * machine exception. This controller is fronted by an interrupt matrix
+ * supporting 84 peripheral interrupts (0-83). The count of 85 below includes
+ * 84 peripheral interrupts plus invalid interrupt 0.
+ */
+#define RISCV_MAXIMUM_EXTERNAL_INTERRUPTS 85
+#define BSP_INTERRUPT_VECTOR_COUNT        RISCV_MAXIMUM_EXTERNAL_INTERRUPTS
+
+#define BSP_INTERRUPT_CUSTOM_VALID_VECTOR
+
+#define BSP_GPIO_PIN_COUNT     29
+#define BSP_GPIO_PINS_PER_BANK 32
+
+/*
+ * The WiFi sources, which are peripheral interrupts 0 to 3 on this part.
+ */
