+#define WIFI_MAC_NMI_INTR      1
+#define WIFI_PWR_INTR          2
+#define WIFI_BB_INTR           3
+
+/*
+ * Bluetooth and Low Power sources.
+ */
+#define BT_MAC_INTR            4
+#define BT_BB_INTR             5
+#define BT_BB_NMI_INTR         6
