+#define BLE_SEC_INTR          10
+#define I2C_MASTER_INTR       11
+#define ZB_MAC_INTR           12
+#define PMU_INTR              13
+#define EFUSE_INTR            14
+#define LP_RTC_TIMER_INTR     15
+#define LP_UART_INTR          16
+#define LP_I2C_INTR           17
+#define LP_WDT_INTR           18
+#define LP_PERI_TIMEOUT_INTR  19
+#define LP_APM_M0_INTR        20
+#define LP_APM_M1_INTR        21
+#define HUK_INTR              22
+
+/*
+ * CPU software interrupts.
+ */
+#define SW_INTR_0             23
+#define SW_INTR_1             24
+#define SW_INTR_2             25
+#define SW_INTR_3             26
+
+#define ASSIST_DEBUG_INTR     27
+#define TRACE_INTR            28
+#define CACHE_INTR            29
+#define CPU_PERI_TIMEOUT_INTR 30
+#define GPIO_PROCPU_INTR      31
+#define GPIO_PROCPU_NMI_INTR  32
+#define PAU_INTR              33
+#define HP_PERI_TIMEOUT_INTR  34
+#define MODEM_PERI_TIMEOUT_INTR 35
+#define HP_APM_M0_INTR        36
+#define HP_APM_M1_INTR        37
+#define HP_APM_M2_INTR        38
+#define HP_APM_M3_INTR        39
+#define HP_APM_M4_INTR        40
+#define LP_APM0_INTR          41
+#define CPU_APM_M0_INTR       42
+#define CPU_APM_M1_INTR       43
+#define MSPI_INTR             44
+#define I2S_INTR              45
+#define UHCI0_INTR            46
+#define UART_INTR             47
+#define UART1_INTR            48
+#define LEDC_INTR             49
+#define TWAI0_INTR            50
+#define TWAI0_TIMER_INTR      51
+#define TWAI1_INTR            52
+#define TWAI1_TIMER_INTR      53
+#define USB_SERIAL_JTAG_INTR  54
+#define RMT_INTR              55
+#define I2C_EXT0_INTR         56
+#define TG_T0_INTR            57
+#define TG_WDT_INTR           58
+#define TG1_T0_INTR           59
+#define TG1_WDT_INTR          60
+#define SYSTIMER_TARGET0_INTR 61
+#define SYSTIMER_TARGET1_INTR 62
+#define SYSTIMER_TARGET2_INTR 63
+#define APB_ADC_INTR          64
+#define MCPWM0_INTR           65
+#define PCNT_INTR             66
+#define PARL_IO_TX_INTR       67
+#define PARL_IO_RX_INTR       68
+#define SLC0_INTR             69
+#define SLC1_INTR             70
+#define GDMA_CH0_INTR         71
+#define GDMA_CH1_INTR         72
+#define GDMA_CH2_INTR         73
+#define GDMA_OUT_CH0_INTR     74
+#define GDMA_OUT_CH1_INTR     75
+#define GDMA_OUT_CH2_INTR     76
+#define GPSPI2_INTR           77
+#define GPSPI2_INTR_2         77
+#define AES_INTR              78
+#define SHA_INTR              79
+#define RSA_INTR              80
+#define ECC_INTR              81
+#define ECDSA_INTR            82
+#define KM_INTR               83
+
+#define RISCV_INTERRUPT_VECTOR_SOFTWARE SW_INTR_0
+#define RISCV_INTERRUPT_VECTOR_TIMER    SYSTIMER_TARGET0_INTR
