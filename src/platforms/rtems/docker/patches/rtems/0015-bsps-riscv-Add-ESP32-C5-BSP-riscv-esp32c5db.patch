   { .peripheral_int = WIFI_PWR_INTR, .cpu_int = 1 },
@@ -176,7 +176,7 @@ static peripheral_irq_map_t irq_mappings[] = {
 
 #define MATRIX_REG( reg ) *( (volatile uint32_t *) ( INT_MATRIX_BASE + reg ) )
 
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
 /* ESP32-C6 Interrupt Matrix status registers */
 #define INTERRUPT_CORE0_INTR_STATUS_0_REG 0x134
 #define INTERRUPT_CORE0_INTR_STATUS_1_REG 0x138
@@ -290,7 +290,7 @@ static rtems_vector_number get_active_interrupt( uint8_t cpu_vector )
 {
   uint32_t s0 = MATRIX_REG( INTERRUPT_CORE0_INTR_STATUS_0_REG );
   uint32_t s1 = MATRIX_REG( INTERRUPT_CORE0_INTR_STATUS_1_REG );
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
   uint32_t s2 = MATRIX_REG( INTERRUPT_CORE0_INTR_STATUS_2_REG );
 #endif
 
@@ -305,7 +305,7 @@ static rtems_vector_number get_active_interrupt( uint8_t cpu_vector )
         if ( ( s1 & ( 1U << ( vec - 32 ) ) ) != 0 ) {
           return vec;
         }
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
       } else if ( vec < RISCV_MAXIMUM_EXTERNAL_INTERRUPTS ) {
         if ( ( s2 & ( 1U << ( vec - 64 ) ) ) != 0 ) {
           return vec;
@@ -443,7 +443,7 @@ rtems_status_code bsp_interrupt_is_pending(
     *pending = ( MATRIX_REG( INTERRUPT_CORE0_INTR_STATUS_0_REG ) & ( 1U << vector ) ) != 0;
   } else if ( vector < 64 ) {
     *pending = ( MATRIX_REG( INTERRUPT_CORE0_INTR_STATUS_1_REG ) & ( 1U << ( vector - 32 ) ) ) != 0;
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
   } else if ( vector < RISCV_MAXIMUM_EXTERNAL_INTERRUPTS ) {
     *pending = ( MATRIX_REG( INTERRUPT_CORE0_INTR_STATUS_2_REG ) & ( 1U << ( vector - 64 ) ) ) != 0;
 #endif
@@ -454,7 +454,7 @@ rtems_status_code bsp_interrupt_is_pending(
   return RTEMS_SUCCESSFUL;
 }
 
-#if !defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
+#if !defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) && !defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
 #define SYSTEM_CPU_INTR_FROM_CPU_0_REG 0x28
 #define SYSTEM_CPU_INTR_FROM_CPU_1_REG 0x2C
 #define SYSTEM_CPU_INTR_FROM_CPU_2_REG 0x30
@@ -467,7 +467,7 @@ rtems_status_code bsp_interrupt_raise( rtems_vector_number vector )
 {
   bsp_interrupt_assert( bsp_interrupt_is_valid_vector( vector ) );
 
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
   switch ( vector ) {
     case SW_INTR_0:
       INTPRI_REG( 0x90 ) = 1;
@@ -520,7 +520,7 @@ rtems_status_code bsp_interrupt_clear( rtems_vector_number vector )
   esp32_cpu_int_clear( cpu_int );
 
   /* If this is a software interrupt, clear it. */
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
   switch ( vector ) {
     case SW_INTR_0:
       INTPRI_REG( 0x90 ) = 0;
