+#define UART_TX_ONE_CHAR_ADDR ( (void *) (uintptr_t) 0x40000054 )
+#define UART_RX_ONE_CHAR_ADDR ( (void *) (uintptr_t) 0x40000060 )
+#define UART_TX_FLUSH_ADDR    ( (void *) (uintptr_t) 0x40000074 )
