diff --git a/bsps/riscv/esp32/start/bspc3power.h b/bsps/riscv/esp32/start/bspc3power.h
new file mode 100644
index 0000000000000000000000000000000000000000..4120bf51fc6759ba0a939daeb6ffff73680ddb2e
--- /dev/null
+++ b/bsps/riscv/esp32/start/bspc3power.h
@@ -0,0 +1,131 @@
+/*
+ * SPDX-FileCopyrightText: 2020-2026 Espressif Systems (Shanghai) CO LTD
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * ESP32-C3 RTC_CONFIG_DEFAULT() power/voltage policy, derived from ESP-IDF
+ * 9a97f6c54ec638111ce55cd36581b3c192f15207:
+ * components/esp_hw_support/port/esp32c3/{rtc_init.c,rtc_sleep.c,
+ * include/soc/rtc.h}, components/hal/{efuse_hal.c,esp32c3/include/hal/efuse_ll.h}
+ * and components/soc/esp32c3/{include,register}/soc register definitions.
+ *
+ * Include after the C3 analog helpers. analog_read(block,address) returns
+ * the complete byte; analog_write(block,address,mask,value) preserves bits
+ * outside mask and uses an already shifted value. The caller owns analog
+ * bus clock/host setup. This routine must precede PLL/CPU clock setup.
+ *
+ * Deliberate exclusions: o-code is performed by the caller (and is disabled
+ * by RTC_CONFIG_DEFAULT itself); RTC sources, tuning and calibration belong
+ * to the clock initializer. sar_periph_ctrl_init and blanket peripheral
+ * clock shutdown are NOT imported: SAR/peripheral gates remain owned by
+ * RTEMS drivers. Cache/MMU/SPI-memory clock force handoffs below are the
+ * specific clkctl_init policy, not a peripheral clock shutdown. No sleep
+ * entry configuration or driver interrupt ownership is introduced here.
+ */
+#if defined( LIBBSP_ESP32_C3_CHIP_DEFINITIONS_H )
+
+static void bsp_c3_power_field(
+  uintptr_t base, uint32_t offset, uint32_t mask, uint32_t value
+)
+{
+  WRITE_REG( base, offset, ( READ_REG( base, offset ) & ~mask ) | value );
+}
+
+static int bsp_c3_power_signed( uint32_t value, uint32_t sign )
+{
+  /* eFuse uses sign-magnitude, including negative zero, NOT two's complement. */
+  return ( value & sign ) != 0 ? -(int) ( value & ( sign - 1 ) ) : (int) value;
+}
+
+static void bsp_c3_power_init( void )
+{
+  const uintptr_t rtc = 0x60008000u;
+  const uintptr_t efuse = 0x60008800u;
+  const uintptr_t system = 0x600c0000u;
+  uint32_t rtc_bias = 28;
+  uint32_t dig_bias = 28;
+  uint32_t sys3 = READ_REG( efuse, 0x50 );
+  uint32_t sys5 = READ_REG( efuse, 0x58 );
+  /* efuse_hal_chip_revision(): major * 100 + the complete 4-bit minor. */
+  uint32_t revision = ( ( sys5 >> 24 ) & 3u ) * 100u +
+    ( ( ( sys5 >> 23 ) & 1u ) << 3 ) + ( ( sys3 >> 18 ) & 7u );
+  uint32_t hvt = ( sys5 >> 5 ) & 31u;
+
+  /* Release modem PD/isolation BEFORE accessing BB/NRX memory controls. */
+  bsp_c3_power_field( rtc, 0x88, BSP_BIT32( 17 ), 0 );
+  bsp_c3_power_field( rtc, 0x8c, BSP_BIT32( 28 ), 0 );
+  bsp_c3_analog_write( 0x6d, 13, 0x08u, 0 ); /* XPD_DIG_REG */
+  bsp_c3_analog_write( 0x6d, 13, 0x04u, 0 ); /* XPD_RTC_REG */
+  bsp_c3_power_field( rtc, 0x34, BSP_BIT32( 26 ), 0 ); /* PVTMON */
+  /* PLL_BUF_WAIT=20, CK8M_WAIT=20. Preserve XTL_BUF_WAIT and CPU_STALL_EN. */
+  bsp_c3_power_field( rtc, 0x1c, 0xff003fc0u, ( 20u << 24 ) | ( 20u << 6 ) );
+  bsp_c3_power_field( rtc, 0x2c, 0xff00u, 2u << 8 );
+  /* RTC_INIT_CONFIG_DEFAULT: each power-up and wait counter is one. */
+  WRITE_REG( rtc, 0x24, 0x02010201u ); /* BT / WIFI */
+  WRITE_REG( rtc, 0x28, 0x02010201u ); /* DG_WRAP / CPU_TOP */
+  bsp_c3_power_field( rtc, 0x30, 0xffff0000u, 0x02010000u ); /* DG_PERI */
+
+  if ( revision >= 3 && hvt != 0 ) {
+    uint32_t sys4 = READ_REG( efuse, 0x54 );
+    int k_rtc = bsp_c3_power_signed( ( sys4 >> 7 ) & 0x7fu, 0x40u );
+    int k_dig = bsp_c3_power_signed( ( sys4 >> 14 ) & 0x7fu, 0x40u );
+    int v_rtc = bsp_c3_power_signed( ( sys4 >> 21 ) & 0xffu, 0x80u );
+    int v_dig = bsp_c3_power_signed(
+      ( ( sys5 & 31u ) << 3 ) | ( sys4 >> 29 ), 0x80u );
+    dig_bias = hvt + 4 > 31 ? 31 : hvt + 4;
+    /* Keep IDF's unsigned arithmetic (including dbias-20 wrap), rounding,
+     * >= comparison, 250 margin and saturation at 31 exactly. */
+    uint32_t target = 10860 + v_dig * 10000 / 500 +
+      ( 213 + k_dig ) * ( dig_bias - 20 );
+    for ( rtc_bias = 15; rtc_bias < 31; ++rtc_bias ) {
+      uint32_t voltage = 10800 + v_rtc * 10000 / 500 +
+        ( 215 + k_rtc ) * ( rtc_bias - 20 );
+      if ( voltage >= target - 250 ) {
+        break;
+      }
+    }
+  }
+  bsp_c3_analog_write( 0x6d, 4, 0x1fu, rtc_bias );
+  bsp_c3_analog_write( 0x6d, 6, 0x1fu, dig_bias );
+
+  /* cfg.clkctl_init: release cache/MMU and SPI-memory clock forces. */
+  bsp_c3_power_field( 0x600c4000u, 0xac, 1u, 0 );
+  bsp_c3_power_field( 0x600c4000u, 0x08, 1u, 0 );
+  bsp_c3_power_field( 0x60003000u, 0xdc, 1u, 0 );
+  bsp_c3_power_field( 0x60002000u, 0xdc, 1u, 0 );
+
+  /* cfg.pwrctl_init, xtal_fpu=bbpll_fpu=0, rtc_dboost_fpd=1. */
+  bsp_c3_power_field( rtc, 0x70, BSP_BIT32( 26 ), 0 );
+  bsp_c3_power_field( rtc, 0x00, BSP_BIT32( 13 ), 0 );
+  bsp_c3_power_field( rtc, 0x34, BSP_BIT32( 24 ), 0 );
+  bsp_c3_power_field( rtc, 0x34, BSP_BIT32( 23 ), BSP_BIT32( 23 ) );
+  bsp_c3_power_field( rtc, 0x34, BSP_BIT32( 18 ), 0 ); /* SAR I2C POR protect */
+  bsp_c3_power_field( rtc, 0x00, 0xa80u, 0 ); /* BBPLL / PLL I2C / BB I2C */
+  bsp_c3_power_field( rtc, 0x80, 0xb0000000u, BSP_BIT32( 28 ) );
+  bsp_c3_power_field( system, 0x0c, 1u, 0 ); /* LSLP_MEM_PD_MASK */
+
+  /* rtc_sleep_pu(RTC_SLEEP_PU_CONFIG_ALL(0)): only LL force-PU fields. */
+  bsp_c3_power_field( rtc, 0x88, 0x10010u, 0 );
+  bsp_c3_power_field( 0x60026000u, 0x9c, 0x15u, 0 ); /* FE DC/PBUS/AGC */
+  bsp_c3_power_field( 0x6001d000u, 0x54, 0x0au, 0 ); /* BB FFT/DC_EST */
+  bsp_c3_power_field( 0x6001cc00u, 0xd4, 0x2au, 0 ); /* NRX ROT/VIT/DEMAP */
+  bsp_c3_power_field( 0x60006000u, 0x90, BSP_BIT32( 5 ), 0 );
+  bsp_c3_power_field( 0x60005000u, 0xf0, BSP_BIT32( 10 ), 0 );
+  bsp_c3_power_field( 0x60026000u, 0xac, 0x3fu, 0 ); /* SRAM / ROM */
+
+  bsp_c3_power_field( rtc, 0x88, 0x545000u, 0 ); /* domain force PU */
+  bsp_c3_power_field( rtc, 0x8c, 0xaa800000u, 0 ); /* domain force NOISO */
+  bsp_c3_power_field( system, 0x08, BSP_BIT32( 3 ), 0 ); /* WAITI clock gate */
+  bsp_c3_power_field( rtc, 0x8c, 0x5000u, 0 ); /* PAD UNHOLD / NOISO */
+  /* IDF parks unused modem domains after their memory-force handoff. */
+  bsp_c3_power_field( rtc, 0x8c, BSP_BIT32( 28 ), BSP_BIT32( 28 ) );
+  bsp_c3_power_field( rtc, 0x88, BSP_BIT32( 17 ), BSP_BIT32( 17 ) );
+  bsp_c3_power_field( rtc, 0x8c, BSP_BIT32( 22 ), BSP_BIT32( 22 ) );
+  bsp_c3_power_field( rtc, 0x88, BSP_BIT32( 11 ), BSP_BIT32( 11 ) );
+  WRITE_REG( rtc, 0x40, 0 );
+  WRITE_REG( rtc, 0x4c, 0xffffffffu );
+  bsp_c3_analog_write( 0x61, 0, 0x04u, 0x04u ); /* IR_FORCE_XPD_CK */
+}
+
+#endif /* LIBBSP_ESP32_C3_CHIP_DEFINITIONS_H */
diff --git a/bsps/riscv/esp32/start/bspc3rtc.h b/bsps/riscv/esp32/start/bspc3rtc.h
new file mode 100644
index 0000000000000000000000000000000000000000..bceb1f6d02aa63ad64535953ae4711f20f25bbf3
--- /dev/null
+++ b/bsps/riscv/esp32/start/bspc3rtc.h
@@ -0,0 +1,209 @@
+/*
+ * SPDX-FileCopyrightText: 2020-2026 Espressif Systems (Shanghai) CO LTD
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/* ESP-IDF 9a97f6c54ec638111ce55cd36581b3c192f15207, C3 rtc_clk_init.c,
+ * rtc_clk.c, rtc_init.c, rtc_time.c and esp_system/port/soc/esp32c3/clk.c.
+ * Direct boot: XTAL40, PLL480/CPU160, RC_SLOW/RC_FAST, no modem retention.
+ * Keep RTEMS timer/scheduler and peripheral-driver clock ownership.
+ */
+#if defined( LIBBSP_ESP32_C3_CHIP_DEFINITIONS_H )
+
+static void bsp_c3_field( uint32_t offset, uint32_t mask, uint32_t value )
+{
+  const uintptr_t rtc = 0x60008000;
+  WRITE_REG( rtc, offset, ( READ_REG( rtc, offset ) & ~mask ) | value );
+}
+
+static void bsp_c3_delay( uint32_t us )
+{
+  ( (void (*)( uint32_t )) (uintptr_t) 0x40000050U )( us );
+}
+
+/* Use the public regi2c HAL table, not the lower-level chip accessor ABI. */
+static uint32_t bsp_c3_analog_read( uint32_t block, uint32_t address )
+{
+  return ( (uint8_t (*)( uint8_t, uint8_t, uint8_t ))
+    (uintptr_t) 0x40001954U )( block, 0, address );
+}
+
+static void bsp_c3_analog_write(
+  uint32_t block,
+  uint32_t address,
+  uint32_t mask,
+  uint32_t value
+)
+{
+  uint32_t data = mask == 0xffu ? value
+    : ( bsp_c3_analog_read( block, address ) & ~mask ) | value;
+  ( (void (*)( uint8_t, uint8_t, uint8_t, uint8_t ))
+    (uintptr_t) 0x4000195cU )( block, 0, address, data );
+}
+
+#include "bspc3power.h"
+
+static void bsp_c3_cpu_xtal( void )
+{
+  /* IDF's safe predivider sequence, including ROM delay/APB accounting. */
+  ( (void (*)( uint32_t )) (uintptr_t) 0x40000588U )( 40 );
+  uint32_t reg = READ_REG( CLK_SYSTEM_BASE, CLK_SYSCLK_CONF_REG );
+  WRITE_REG( CLK_SYSTEM_BASE, CLK_SYSCLK_CONF_REG, reg & ~0x3ffu );
+  WRITE_REG( CLK_SYSTEM_BASE, CLK_SYSCLK_CONF_REG, reg & ~0x3ffu );
+  WRITE_REG( CLK_SYSTEM_BASE, CLK_SYSCLK_CONF_REG, reg & ~0xfffu );
+  uint32_t apb = 40000000u >> 12;
+  WRITE_REG( (uintptr_t) 0x60008000, 0xbc, apb | ( apb << 16 ) );
+}
+
+static void bsp_c3_cpu_pll( void )
+{
+  const uintptr_t analog = 0x6000e000;
+  bsp_c3_field( 0, BSP_BIT32( 10 ) | BSP_BIT32( 8 ) | BSP_BIT32( 6 ), 0 );
+  uint32_t reg = READ_REG( CLK_SYSTEM_BASE, CLK_CPU_PER_CONF_REG );
+  WRITE_REG( CLK_SYSTEM_BASE, CLK_CPU_PER_CONF_REG, reg | BSP_BIT32( 2 ) );
+  reg = READ_REG( analog, 0x40 );
+  WRITE_REG( analog, 0x40, ( reg & ~4u ) | 8u );
+  bsp_c3_analog_write( 0x66, 4, 0xff, 0x6b );
+  bsp_c3_analog_write( 0x66, 2, 0xff, 0x50 );
+  bsp_c3_analog_write( 0x66, 3, 0xff, 8 );
+  bsp_c3_analog_write( 0x66, 5, 0x77, 0 );
+  bsp_c3_analog_write( 0x66, 6, 0xff, 0x93 );
+  bsp_c3_analog_write( 0x66, 9, 3, 2 );
+  bsp_c3_analog_write( 0x66, 6, 0x30, 0x20 );
+  bsp_c3_analog_write( 0x66, 6, 0xc0, 0x40 );
+  /* Unlike newer chips, IDF's C3 calibration has no DONE poll/STOP write. */
+  reg = READ_REG( CLK_SYSTEM_BASE, CLK_CPU_PER_CONF_REG );
+  WRITE_REG( CLK_SYSTEM_BASE, CLK_CPU_PER_CONF_REG, ( reg & ~3u ) | 1u );
+  reg = READ_REG( CLK_SYSTEM_BASE, CLK_SYSCLK_CONF_REG );
+  WRITE_REG( CLK_SYSTEM_BASE, CLK_SYSCLK_CONF_REG, reg & ~0x3ffu );
+  WRITE_REG( CLK_SYSTEM_BASE, CLK_SYSCLK_CONF_REG,
+    ( reg & ~0xfffu ) | BSP_BIT32( 10 ) );
+  uint32_t apb = 80000000u >> 12;
+  WRITE_REG( (uintptr_t) 0x60008000, 0xbc, apb | ( apb << 16 ) );
+  ( (void (*)( uint32_t )) (uintptr_t) 0x40000588U )( 160 );
+}
+
+static void bsp_c3_clock_init( void )
+{
+  bsp_c3_cpu_xtal();
+  const uintptr_t analog = 0x6000e000;
+  uint32_t reg = READ_REG( analog, 0x44 );
+  WRITE_REG( analog, 0x44, reg | 0x3ff00u );
+  WRITE_REG( analog, 0x44, ( reg | 0x3ff00u ) & ~BSP_BIT32( 17 ) );
+  bsp_c3_power_init();
+  bsp_c3_field( 0x80, 0xffu << 14, 255u << 14 );
+  bsp_c3_field( 0x70, 0xffu << 17, 100u << 17 );
+  bsp_c3_field( 0x74, BSP_BIT32( 22 ), 0 );
+  bsp_c3_field( 0x74, 0xffu << 23, 0 );
+  bsp_c3_field( 0x74, BSP_BIT32( 22 ), BSP_BIT32( 22 ) );
+  bsp_c3_field( 0x70, BSP_BIT32( 3 ), 0 );
+  bsp_c3_field( 0x70, 7u << 12, 0 );
+  bsp_c3_field( 0x70, BSP_BIT32( 3 ), BSP_BIT32( 3 ) );
+  reg = READ_REG( (uintptr_t) 0x60008000, 0xb8 );
+  uint32_t xtal = ( reg & 0x10001u ) == 0x10001u ? 41u : 40u;
+  WRITE_REG( (uintptr_t) 0x60008000, 0xb8, xtal | ( xtal << 16 ) );
+  bsp_c3_cpu_pll();
+}
+
+static uint32_t bsp_c3_slow_calibrate( uint32_t cycles )
+{
+  const uintptr_t timg = 0x6001f000;
+  uint32_t reg = READ_REG( timg, 0x68 );
+  if ( reg & BSP_BIT32( 12 ) ) {
+    WRITE_REG( timg, 0x80,
+      ( READ_REG( timg, 0x80 ) & ~0xffffff80u ) | ( 1u << 7 ) );
+    uint32_t wait = 100000;
+    while ( !( READ_REG( timg, 0x68 ) & BSP_BIT32( 15 ) ) &&
+            !( READ_REG( timg, 0x80 ) & 1u ) ) {
+      if ( --wait == 0 ) {
+        rtems_panic( "ESP32-C3: RTC calibration drain timed out" );
+      }
+      bsp_c3_delay( 1 );
+    }
+  }
+  reg = READ_REG( timg, 0x68 );
+  reg &= ~( BSP_BIT32( 31 ) | BSP_BIT32( 12 ) | ( 3u << 13 )
+    | ( 0x7fffu << 16 ) );
+  WRITE_REG( timg, 0x68, reg | ( cycles << 16 ) );
+  WRITE_REG( timg, 0x80,
+    ( READ_REG( timg, 0x80 ) & ~0xffffff80u ) | ( cycles << 17 ) );
+  WRITE_REG( timg, 0x68, READ_REG( timg, 0x68 ) | BSP_BIT32( 31 ) );
+  bsp_c3_delay( cycles * 1000000ULL / 136000u );
+  uint32_t wait = 100000;
+  while ( !( READ_REG( timg, 0x68 ) & BSP_BIT32( 15 ) ) ) {
+    if ( ( READ_REG( timg, 0x80 ) & 1u ) || --wait == 0 ) {
+      rtems_panic( "ESP32-C3: RTC calibration timed out" );
+    }
+    bsp_c3_delay( 1 );
+  }
+  uint64_t xtal_cycles = ( READ_REG( timg, 0x6c ) >> 7 ) & 0x1ffffffu;
+  WRITE_REG( timg, 0x68, READ_REG( timg, 0x68 ) & ~BSP_BIT32( 31 ) );
+  uint64_t divisor = 40u * cycles;
+  uint32_t period = ( ( xtal_cycles << 19 ) + divisor / 2 - 1 ) / divisor;
+  if ( period == 0 ) {
+    rtems_panic( "ESP32-C3: invalid RTC calibration" );
+  }
+  return period;
+}
+
+static uint64_t bsp_c3_rtc_count( void )
+{
+  const uintptr_t rtc = 0x60008000;
+  WRITE_REG( rtc, 0x0c, READ_REG( rtc, 0x0c ) | BSP_BIT32( 31 ) );
+  uint32_t low = READ_REG( rtc, 0x10 );
+  uint32_t high = READ_REG( rtc, 0x14 ) & 0xffffu;
+  return ( (uint64_t) high << 32 ) | low;
+}
+
+static void bsp_c3_ocode_init( void )
+{
+  uint32_t reset = ( (uint32_t (*)( uint32_t )) (uintptr_t) 0x40000018U )( 0 );
+  if ( reset != 1 && reset != 0x14 ) {
+    return; /* IDF calibrates on chip power-on or the C3 eFuse CRC reset. */
+  }
+  uint32_t efuse = READ_REG( (uintptr_t) 0x60008800, 0x6c );
+  if ( ( efuse & 3u ) == 1 ) {
+    bsp_c3_analog_write( 0x61, 6, 0xff, ( efuse >> 12 ) & 0xffu );
+    bsp_c3_analog_write( 0x61, 5, 0x40, 0x40 );
+    return;
+  }
+  uint32_t period = bsp_c3_slow_calibrate( 100 );
+  uint64_t deadline = bsp_c3_rtc_count() + ( ( 10000ULL << 19 ) / period );
+  bsp_c3_cpu_xtal();
+  bsp_c3_field( 0, BSP_BIT32( 10 ) | BSP_BIT32( 8 ) | BSP_BIT32( 6 ),
+    BSP_BIT32( 10 ) | BSP_BIT32( 8 ) | BSP_BIT32( 6 ) );
+  bsp_c3_analog_write( 0x61, 0, 1, 0 );
+  bsp_c3_analog_write( 0x61, 0, 1, 1 );
+  uint32_t wait = 100000;
+  while ( ( bsp_c3_analog_read( 0x61, 3 ) & 9u ) != 9u ) {
+    if ( bsp_c3_rtc_count() >= deadline ) {
+      break; /* IDF warns and continues after the 10 ms o-code deadline. */
+    }
+    if ( --wait == 0 ) {
+      rtems_panic( "ESP32-C3: RTC stopped during o-code calibration" );
+    }
+    bsp_c3_delay( 1 );
+  }
+  bsp_c3_cpu_pll();
+}
+
+static void bsp_c3_rtc_init( void )
+{
+  /* Acquire the calibration clock without resetting RTEMS's timer state. */
+  WRITE_REG( CLK_SYSTEM_BASE, 0x10,
+    READ_REG( CLK_SYSTEM_BASE, 0x10 ) | BSP_BIT32( 13 ) );
+  WRITE_REG( CLK_SYSTEM_BASE, 0x18,
+    READ_REG( CLK_SYSTEM_BASE, 0x18 ) & ~BSP_BIT32( 13 ) );
+  /* Bootloader/app final profile: RC_FAST on, /256 off, RC_SLOW selected. */
+  bsp_c3_field( 0x70, BSP_BIT32( 6 ), 0 );
+  bsp_c3_field( 0x1c, 0xffu << 6, 5u << 6 );
+  bsp_c3_delay( 50 );
+  bsp_c3_field( 0x70, BSP_BIT32( 7 ), BSP_BIT32( 7 ) );
+  bsp_c3_field( 0x70, BSP_BIT32( 29 ), BSP_BIT32( 29 ) );
+  bsp_c3_delay( 3 );
+  bsp_c3_field( 0x70, ( 3u << 30 ) | BSP_BIT32( 8 ), 0 );
+  bsp_c3_delay( 300 );
+  bsp_c3_ocode_init();
+  WRITE_REG( (uintptr_t) 0x60008000, 0x54, bsp_c3_slow_calibrate( 1024 ) );
+}
+#endif
diff --git a/bsps/riscv/esp32/start/bspc6pmu.h b/bsps/riscv/esp32/start/bspc6pmu.h
new file mode 100644
index 0000000000000000000000000000000000000000..8dfa6c1c958e9e943047a744736a15d803e4d9ba
--- /dev/null
+++ b/bsps/riscv/esp32/start/bspc6pmu.h
@@ -0,0 +1,99 @@
+/*
+ * SPDX-FileCopyrightText: 2023-2026 Espressif Systems (Shanghai) CO LTD
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * ESP32-C6 fixed-voltage PMU defaults, derived from ESP-IDF
+ * 9a97f6c54ec638111ce55cd36581b3c192f15207:
+ * components/esp_hw_support/port/esp32c6/{pmu_init.c,pmu_param.c} and
+ * components/esp_hal_pmu/esp32c6/include/hal/pmu_ll.h.
+ *
+ * Include after bspvoltage.h. The caller has established calibrated HP/LP
+ * biases, enabled the analog master clock, and selected its clock source.
+ * This is the PVT-OFF PMU policy phase, not o-code or RTC clock setup. In
+ * particular, LP clock power below is pmu_init's default, not a choice of
+ * RTC source. Sleep entry may subsequently replace the sleep templates.
+ */
+#if defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+static void bsp_c6_pmu_init( void )
+{
+  uint32_t hp_bias = READ_REG( VOLTAGE_PMU_BASE, 0x28 ) >> 27;
+  uint32_t lp_bias = READ_REG( VOLTAGE_PMU_BASE, 0x9c ) >> 27;
+  uint32_t analog_mask = READ_REG( VOLTAGE_I2C_BASE, 0x1c );
+
+  /* pmu_init(), unlike the earlier rtc_clk_init(), clears both XPD bits. */
+  bsp_voltage_i2c_write( 0x6d, 5, 0x80u, 0x80u );
+  bsp_voltage_i2c_write( 0x6d, 7, 0x80u, 0x80u );
+  bsp_voltage_i2c_write( 0x6d, 13, 0x0cu, 0 );
+  WRITE_REG( VOLTAGE_I2C_BASE, 0x1c, analog_mask );
+
+  /* pmu_hp_system_init_default(): ACTIVE, MODEM, SLEEP, in that order. */
+  for ( uint32_t mode = 0; mode < 3; ++mode ) {
+    uint32_t offset = mode * 0x34u;
+    bool active = mode == 0;
+    bool sleep = mode == 2;
+
+    /* Power, then clock, then digital, analog and retention policies. */
+    WRITE_REG( VOLTAGE_PMU_BASE, offset,
+      active ? 0 : sleep ? 0x08200000u : 0x20000000u );
+    WRITE_REG( VOLTAGE_PMU_BASE, offset + 0x14,
+      sleep ? 0x1c000000u : 0x70000000u );
+    bsp_voltage_field( offset + 0x30, BSP_BIT32( 31 ),
+      sleep ? 0 : BSP_BIT32( 31 ) );
+
+    WRITE_REG( VOLTAGE_PMU_BASE, offset + 0x04,
+      active ? 0xffffffffu : sleep ? 0 : BSP_BIT32( 20 ) );
+    WRITE_REG( VOLTAGE_PMU_BASE, offset + 0x08,
+      active ? 0xffffffffu : sleep ? 0 : BSP_BIT32( 9 ) );
+    bsp_voltage_field( offset + 0x0c, 3u << 30,
+      active ? 2u << 30 : sleep ? 0 : 1u << 30 );
+    bsp_voltage_field( offset + 0x24, 0xfc000000u,
+      active ? 0x08000000u : sleep ? 0x30000000u : 0x78000000u );
+    bsp_voltage_field( offset + 0x10, 0x3f000000u,
+      active ? 0 : sleep ? 0x39000000u : 0x31000000u );
+
+    bsp_voltage_field( offset + 0x18, 0xfe000000u,
+      active ? BSP_BIT32( 25 ) : 0 );
+    /* The LL only writes regulator bits 31:16. Preserve DBIAS_SEL,
+     * DBIAS_INIT and the PVT status fields in ACTIVE's low half. */
+    bsp_voltage_field( offset + 0x28, 0xffff0000u,
+      ( ( sleep ? 1u : hp_bias ) << 27 ) | BSP_BIT32( 18 ) );
+    bsp_voltage_field( offset + 0x2c, 0xffffff00u, 0 );
+
+    WRITE_REG( VOLTAGE_PMU_BASE, offset + 0x1c,
+      active ? 0x010100a0u : sleep ? 0x12800200u : 0x00100010u );
+    WRITE_REG( VOLTAGE_PMU_BASE, offset + 0x20, 0xffffffffu );
+
+    /* Match the per-mode update/protect ordering in pmu_hp_system_init. */
+    bsp_voltage_field( 0xdc, BSP_BIT32( 31 ), BSP_BIT32( 31 ) );
+    bsp_voltage_field( 0xd0, BSP_BIT32( 28 ), BSP_BIT32( 28 ) );
+    bsp_voltage_field( 0x12c, 3u << 16, 2u << 16 );
+  }
+
+  /* pmu_lp_system_init_default(): LP_ACTIVE then LP_SLEEP. The XTAL
+   * and bias LL setters target LP_SLEEP in BOTH iterations. */
+  for ( uint32_t mode = 0; mode < 2; ++mode ) {
+    uint32_t offset = 0x9cu + mode * 0x18u;
+    WRITE_REG( VOLTAGE_PMU_BASE, offset + 0x0c, 0 );
+    WRITE_REG( VOLTAGE_PMU_BASE, offset + 0x10,
+      mode == 0 ? 0x70000000u : 0 );
+    bsp_voltage_field( 0xbc, BSP_BIT32( 31 ), 0 );
+    bsp_voltage_field( 0xc8, 0xfe000000u,
+      mode == 0 ? 0 : 0xc0000000u );
+    bsp_voltage_field( offset, 0xffe00000u,
+      ( ( mode == 0 ? lp_bias : 12u ) << 27 ) | BSP_BIT32( 22 ) );
+    bsp_voltage_field( offset + 0x04, 0xf0000000u, 0 );
+  }
+
+  /* Only hand control to the FSM after all backing policies are installed.
+   * Bypass the reserved HP peripheral domain, just like the IDF initializer.
+   * Keep PD masks and all memory force bits other than NO_ISO unchanged. */
+  bsp_voltage_field( 0xf4, 0x3fu, 0 ); /* TOP */
+  bsp_voltage_field( 0xf8, 0x3fu, 0 ); /* HP_AON */
+  bsp_voltage_field( 0xfc, 0x3fu, 0 ); /* CPU */
+  bsp_voltage_field( 0x104, 0x3fu, 0 ); /* WIFI */
+  bsp_voltage_field( 0x10c, 15u << 24, 0 ); /* force_hp_mem_no_iso only */
+  bsp_voltage_field( 0x108, 0x3fu, 0 ); /* LP peripheral */
+}
+#endif
diff --git a/bsps/riscv/esp32/start/bspc6rtc.h b/bsps/riscv/esp32/start/bspc6rtc.h
new file mode 100644
index 0000000000000000000000000000000000000000..6406ac2d52a91ef6c39372cd6424d4171f017ef4
--- /dev/null
+++ b/bsps/riscv/esp32/start/bspc6rtc.h
@@ -0,0 +1,173 @@
+/*
+ * SPDX-FileCopyrightText: 2022-2026 Espressif Systems (Shanghai) CO LTD
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/* ESP-IDF 9a97f6c54ec638111ce55cd36581b3c192f15207, C6 rtc_clk_init.c,
+ * rtc_time.c, ocode_init.c and esp_system/port/soc/esp32c6/clk.c.
+ * Direct boot: XTAL40, CPU160, RC_SLOW/RC_FAST, PVT off (C6 IDF default).
+ * RTEMS retains timer/scheduler and peripheral-driver ownership.
+ */
+#if defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+
+#include "bspc6pmu.h"
+
+static void bsp_clock_init( void );
+
+static void bsp_c6_delay( uint32_t us )
+{
+  ( (void (*)( uint32_t )) (uintptr_t) 0x40000040U )( us );
+}
+
+static void bsp_c6_rtc_tune( void )
+{
+  const uintptr_t clkrst = 0x600b0400;
+  uint32_t reg = READ_REG( clkrst, 0x18 );
+  WRITE_REG( clkrst, 0x18, ( reg & ~0xffc00000u ) | ( 100u << 22 ) );
+  bsp_voltage_i2c_write( 0x6d, 14, 0xffu, 128u );
+  reg = READ_REG( clkrst, 0x1c );
+  WRITE_REG( clkrst, 0x1c, ( reg & ~0xffc00000u ) | ( 700u << 22 ) );
+  reg = READ_REG( (uintptr_t) 0x600b1000, 0x10 );
+  uint32_t xtal = ( reg & 0x10001u ) == 0x10001u ? 41u : 40u;
+  WRITE_REG( (uintptr_t) 0x600b1000, 0x10, xtal | ( xtal << 16 ) );
+}
+
+static void bsp_c6_rtc_sources( void )
+{
+  const uintptr_t clkrst = 0x600b0400;
+  bsp_voltage_field( 0xac, BSP_BIT32( 30 ), BSP_BIT32( 30 ) );
+  bsp_c6_delay( 50 );
+  WRITE_REG( clkrst, 0, READ_REG( clkrst, 0 ) & ~4u );
+  bsp_c6_delay( 3 );
+  WRITE_REG( clkrst, 0, READ_REG( clkrst, 0 ) & ~3u );
+  bsp_c6_delay( 300 );
+}
+
+/* The selected profile has only RC_SLOW calibration. The TIMG0 calibrator
+ * is not its counter or watchdog. Keep IDF's cycling-mode drain, threshold,
+ * initial wait and Q19 rounding. A nonresponsive calibrator stops boot,
+ * rather than publishing a guessed period or waiting forever.
+ */
+static uint32_t bsp_c6_slow_calibrate( uint32_t cycles )
+{
+  const uintptr_t timg = 0x60008000;
+  uint32_t reg = READ_REG( timg, 0x68 );
+  if ( reg & BSP_BIT32( 12 ) ) {
+    WRITE_REG( timg, 0x80,
+      ( READ_REG( timg, 0x80 ) & ~0xffffff80u ) | ( 1u << 7 ) );
+    uint32_t wait = 100000;
+    while ( !( READ_REG( timg, 0x68 ) & BSP_BIT32( 15 ) ) &&
+            !( READ_REG( timg, 0x80 ) & 1u ) ) {
+      if ( --wait == 0 ) {
+        rtems_panic( "ESP32-C6: RTC calibration drain timed out" );
+      }
+      bsp_c6_delay( 1 );
+    }
+  }
+  reg = READ_REG( timg, 0x68 );
+  reg &= ~( BSP_BIT32( 31 ) | BSP_BIT32( 12 ) | ( 3u << 13 )
+    | ( 0x7fffu << 16 ) );
+  WRITE_REG( timg, 0x68, reg | ( cycles << 16 ) );
+  WRITE_REG( timg, 0x80,
+    ( READ_REG( timg, 0x80 ) & ~0xffffff80u ) | ( cycles << 17 ) );
+  WRITE_REG( timg, 0x68, READ_REG( timg, 0x68 ) | BSP_BIT32( 31 ) );
+  bsp_c6_delay( cycles * 1000000ULL / 136000u );
+  uint32_t wait = 100000;
+  while ( !( READ_REG( timg, 0x68 ) & BSP_BIT32( 15 ) ) ) {
+    if ( ( READ_REG( timg, 0x80 ) & 1u ) || --wait == 0 ) {
+      rtems_panic( "ESP32-C6: RTC calibration timed out" );
+    }
+    bsp_c6_delay( 1 );
+  }
+  uint64_t xtal_cycles = ( READ_REG( timg, 0x6c ) >> 7 ) & 0x1ffffffu;
+  WRITE_REG( timg, 0x68, READ_REG( timg, 0x68 ) & ~BSP_BIT32( 31 ) );
+  uint64_t divisor = 40u * cycles;
+  uint32_t period = ( ( xtal_cycles << 19 ) + divisor / 2 - 1 ) / divisor;
+  if ( period == 0 ) {
+    rtems_panic( "ESP32-C6: invalid RTC calibration" );
+  }
+  return period;
+}
+
+static uint64_t bsp_c6_rtc_count( void )
+{
+  const uintptr_t timer = 0x600b0c00;
+  WRITE_REG( timer, 0x10, READ_REG( timer, 0x10 ) | BSP_BIT32( 28 ) );
+  uint32_t low = READ_REG( timer, 0x14 );
+  uint32_t high = READ_REG( timer, 0x18 ) & 0xffffu;
+  return ( (uint64_t) high << 32 ) | low;
+}
+
+static uint32_t bsp_c6_ulp_read( uint32_t address )
+{
+  const uintptr_t i2c = 0x600af800;
+  uint32_t host = ( READ_REG( i2c, 0x20 ) & BSP_BIT32( 10 ) ) ? 0 : 4;
+  WRITE_REG( i2c, 0x1c, 0xfffeffu );
+  bsp_voltage_i2c_wait( host );
+  WRITE_REG( i2c, host, 0x61u | ( address << 8 ) );
+  bsp_voltage_i2c_wait( host );
+  return ( READ_REG( i2c, host ) >> 16 ) & 0xffu;
+}
+
+static void bsp_c6_ocode_init( void )
+{
+  if ( ( (uint32_t (*)( uint32_t )) (uintptr_t) 0x40000018U )( 0 ) != 1 ) {
+    return; /* IDF only calibrates on chip power-on, never deep-sleep wake. */
+  }
+  uint32_t version = READ_REG( (uintptr_t) 0x600b0800, 0x50 );
+  uint32_t block_version = ( ( version >> 30 ) & 3u ) * 100
+    + ( ( version >> 27 ) & 7u );
+  if ( block_version >= 1 ) {
+    uint32_t code = ( READ_REG( (uintptr_t) 0x600b0800, 0x6c ) >> 9 ) & 0xffu;
+    bsp_voltage_i2c_write( 0x61, 6, 0xffu, code );
+    bsp_voltage_i2c_write( 0x61, 5, 0x40u, 0x40u );
+    return;
+  }
+
+  uint32_t period = bsp_c6_slow_calibrate( 100 );
+  uint64_t deadline = bsp_c6_rtc_count() + ( ( 10000ULL << 19 ) / period );
+  WRITE_REG( CLK_PCR_BASE, 0x11c, READ_REG( CLK_PCR_BASE, 0x11c ) & ~0xffu );
+  WRITE_REG( CLK_PCR_BASE, 0x118, READ_REG( CLK_PCR_BASE, 0x118 ) & ~0xffu );
+  WRITE_REG( CLK_PCR_BASE, 0x110, READ_REG( CLK_PCR_BASE, 0x110 ) & ~( 3u << 16 ) );
+  ( (void (*)( uint32_t )) (uintptr_t) 0x40000048U )( 40 );
+  WRITE_REG( VOLTAGE_PMU_BASE, 0xcc,
+    READ_REG( VOLTAGE_PMU_BASE, 0xcc ) | BSP_BIT32( 0 ) );
+  WRITE_REG( VOLTAGE_PMU_BASE, 0xcc,
+    READ_REG( VOLTAGE_PMU_BASE, 0xcc ) | BSP_BIT32( 4 ) | BSP_BIT32( 5 ) );
+  bsp_voltage_i2c_write( 0x61, 0, 1u, 0 );
+  bsp_voltage_i2c_write( 0x61, 0, 1u, 1u );
+  uint32_t wait = 100000;
+  while ( ( bsp_c6_ulp_read( 3 ) & 9u ) != 9u ) {
+    if ( bsp_c6_rtc_count() >= deadline ) {
+      break; /* IDF warns and continues after the 10 ms o-code deadline. */
+    }
+    if ( --wait == 0 ) {
+      rtems_panic( "ESP32-C6: RTC stopped during o-code calibration" );
+    }
+    bsp_c6_delay( 1 );
+  }
+  bsp_clock_init(); /* Restore PLL160 through its calibration sequence. */
+}
+
+static void bsp_c6_rtc_init( void )
+{
+  const uintptr_t lpcon = 0x600af000;
+  /* IDF's bootloader leaves the analog master clock configured/enabled. */
+  WRITE_REG( lpcon, 0x18, READ_REG( lpcon, 0x18 ) | BSP_BIT32( 2 ) );
+  WRITE_REG( lpcon, 0x10, READ_REG( lpcon, 0x10 ) | 1u );
+  uint32_t read_mask = READ_REG( VOLTAGE_I2C_BASE, 0x1c );
+  bsp_c6_rtc_sources();
+  bsp_c6_pmu_init();
+  bsp_c6_ocode_init();
+  bsp_c6_rtc_sources();
+  /* esp_clk_init(): disable unused RC32K and LP_ACTIVE oscillator powers. */
+  bsp_voltage_field( 0xac, BSP_BIT32( 29 ), 0 );
+  WRITE_REG( VOLTAGE_PMU_BASE, 0xac, BSP_BIT32( 30 ) );
+  uint32_t period = bsp_c6_slow_calibrate( 1024 );
+  WRITE_REG( (uintptr_t) 0x600b1000, 0x04, period );
+  /* Preserve driver-owned LP gates; eFuse must remain clocked. */
+  WRITE_REG( (uintptr_t) 0x600b2800, 0,
+    READ_REG( (uintptr_t) 0x600b2800, 0 ) | BSP_BIT32( 30 ) );
+  WRITE_REG( VOLTAGE_I2C_BASE, 0x1c, read_mask );
+}
+#endif
diff --git a/bsps/riscv/esp32/start/bspp4pvt.h b/bsps/riscv/esp32/start/bspp4pvt.h
new file mode 100644
index 0000000000000000000000000000000000000000..05726b705fffadacccd83868add6b66bfd4de5fc
--- /dev/null
+++ b/bsps/riscv/esp32/start/bspp4pvt.h
@@ -0,0 +1,146 @@
+/*
+ * SPDX-FileCopyrightText: 2025-2026 Espressif Systems (Shanghai) CO LTD
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/* ESP-IDF 9a97f6c54ec638111ce55cd36581b3c192f15207: esp32p4/pmu_pvt.c,
+ * soc/rtc.h and hw_ver1/hw_ver3 register definitions.  Both layouts share
+ * these PVT, clock, PMU and eFuse offsets; only the delay thresholds differ.
+ * Called after bsp_clock_init(), with ROM delay timing updated and SPLL's
+ * PLL_F160M available.  Keep the preceding voltage prerequisites unchanged.
+ */
+#if defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+
+#include <assert.h>
+
+#define P4_PVT_BASE     (uintptr_t) 0x5009e000U
+#define P4_PVT_EFUSE    (uintptr_t) 0x5012d000U
+
+static void bsp_p4_pvt_field(
+  uintptr_t base,
+  uintptr_t offset,
+  uint32_t mask,
+  uint32_t value
+)
+{
+  WRITE_REG( base, offset, ( READ_REG( base, offset ) & ~mask ) | value );
+}
+
+static void bsp_p4_pvt_delay( uint32_t us )
+{
+  ( (void (*)( uint32_t )) (uintptr_t) 0x4fc0003cU )( us );
+}
+
+static bool bsp_p4_pvt_supported( void )
+{
+  /* BLK1 bits 72..74 (minor), 75..76 (major), not the wafer revision. */
+  uint32_t version = READ_REG( P4_PVT_EFUSE, 0x4c );
+  uint32_t block_version = ( ( version >> 11 ) & 3u ) * 100
+    + ( ( version >> 8 ) & 7u );
+
+  return block_version >= 2 && block_version != 100;
+}
+
+void bsp_esp32p4_pvt_enable( bool enable )
+{
+  if ( !bsp_p4_pvt_supported() ) {
+    return;
+  }
+
+  if ( enable ) {
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa4,
+      BSP_BIT32( 24 ), BSP_BIT32( 24 ) );
+    /* Start calibration, then enable the monitor clock (never close it). */
+    bsp_p4_pvt_field( CLK_PMU_BASE, 0x28,
+      BSP_BIT32( 15 ), BSP_BIT32( 15 ) );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x30, BSP_BIT32( 8 ), BSP_BIT32( 8 ) );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x108, 1u, 1u );
+    bsp_p4_pvt_delay( 10 );
+    /* Hand DBIAS control to PVT before clearing DBIAS_INIT. */
+    bsp_p4_pvt_field( CLK_PMU_BASE, 0x28, BSP_BIT32( 14 ), 0 );
+    bsp_p4_pvt_field( CLK_PMU_BASE, 0x28, BSP_BIT32( 15 ), 0 );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x64, BSP_BIT32( 31 ), BSP_BIT32( 31 ) );
+    bsp_p4_pvt_delay( 50 );
+  } else {
+    uint32_t hp = ( READ_REG( CLK_PMU_BASE, 0x28 ) >> 9 ) & 31u;
+    uint32_t lp = ( READ_REG( CLK_PMU_BASE, 0x28 ) >> 4 ) & 31u;
+
+    /* Preserve PVT's outputs before handing control back to the PMU. */
+    bsp_p4_pvt_field( CLK_PMU_BASE, 0x18, 31u << 18, hp << 18 );
+    bsp_p4_pvt_field( CLK_PMU_BASE, 0x9c, 31u << 27, lp << 27 );
+    bsp_p4_pvt_field( CLK_PMU_BASE, 0x28,
+      BSP_BIT32( 14 ), BSP_BIT32( 14 ) );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa4, BSP_BIT32( 24 ), 0 );
+  }
+}
+
+static void bsp_p4_pvt_init( void )
+{
+  if ( bsp_p4_pvt_supported() ) {
+    /* PVT must be reset after CPU power-down, before configuring it. */
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xc0,
+      BSP_BIT32( 5 ), BSP_BIT32( 5 ) );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xc0, BSP_BIT32( 5 ), 0 );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0x2c, 1u, 1u );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0x18,
+      BSP_BIT32( 25 ), BSP_BIT32( 25 ) );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x64, BSP_BIT32( 31 ), 0 );
+    bsp_p4_pvt_delay( 1 );
+
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x34, 0x7fu << 25, 49u << 25 );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x34, 0x7fu << 18, 53u << 18 );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x3c, 0x1ffffu, 0x11fffu );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x40, 0x1ffffu, 0x17fffu );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x44, 0x1ffffu, 0x10000u );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x50, 0x7ffu, 0x24u );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x54, 0x7ffu, 0x05u );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x58, 0x7ffu, 0x427u );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x64, 0xffffu << 15, 0xffffu << 15 );
+
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa4, 0xffu << 16, 1u << 16 );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa8, 0xffu, 1u );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa4,
+      BSP_BIT32( 24 ), BSP_BIT32( 24 ) );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa8,
+      BSP_BIT32( 8 ), BSP_BIT32( 8 ) );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa8,
+      BSP_BIT32( 9 ), BSP_BIT32( 9 ) );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa8,
+      BSP_BIT32( 10 ), BSP_BIT32( 10 ) );
+    bsp_p4_pvt_field( CLK_HP_SYS_CLKRST_BASE, 0xa8,
+      BSP_BIT32( 11 ), BSP_BIT32( 11 ) );
+
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x1c8, 3u, 1u );
+#if BSP_ESP32P4_REVISION == 1
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x108, 0xffu << 2, 164u << 2 );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x10c, 0xffu << 2, 157u << 2 );
+#else
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x108, 0xffu << 2, 160u << 2 );
+    bsp_p4_pvt_field( P4_PVT_BASE, 0x10c, 0xffu << 2, 153u << 2 );
+#endif
+
+    /* Both layouts: BLK1 bit 165, length 5 = RD_MAC_SYS_5 bits 9:5.
+     * eFuse and PVT use sign/magnitude, NOT two's complement.  The -8
+     * adjustment and range assertion are get_lp_hp_gap()'s exact policy.
+     */
+    uint32_t raw = ( READ_REG( P4_PVT_EFUSE, 0x58 ) >> 5 ) & 31u;
+    int32_t gap = ( raw & 16u ) != 0 ? -(int32_t) ( raw & 15u )
+      : (int32_t) ( raw & 15u );
+    gap -= 8;
+    assert( gap >= -15 && gap <= 7 );
+    uint32_t encoded = gap < 0 ? (uint32_t) ( 16 - gap ) : (uint32_t) gap;
+    uint32_t flag = ( encoded >> 4 ) != 0 ? BSP_BIT32( 16 ) : 0;
+    uint32_t magnitude = ( encoded & 15u ) << 11;
+
+    for ( uintptr_t offset = 0x50; offset <= 0x58; offset += 4 ) {
+      bsp_p4_pvt_field( P4_PVT_BASE, offset, BSP_BIT32( 16 ), flag );
+      bsp_p4_pvt_field( P4_PVT_BASE, offset, 31u << 11, magnitude );
+    }
+  }
+
+  bsp_esp32p4_pvt_enable( true );
+  /* pmu_init(): allow PVT to take effect before continuing startup. */
+  bsp_p4_pvt_delay( 1000 );
+}
+
+#endif
