+#if defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+static void bsp_c6_bbpll_init( void )
+{
+  const uintptr_t pmu = 0x600b0000;
+  const uintptr_t syscon = 0x600a9800;
+  const uintptr_t lpcon = 0x600af000;
+  uint32_t reg;
+
+  /* rtc_clk_init(): ACTIVE ICG code and modem APB/I2C/LP APB maps must
+   * precede PLL configuration. Preserve other domains and power states.
+   */
+  reg = READ_REG( pmu, 0x0c );
+  WRITE_REG( pmu, 0x0c, ( reg & ~( 3u << 30 ) ) | ( 2u << 30 ) );
+  reg = READ_REG( syscon, 0x0c );
+  WRITE_REG( syscon, 0x0c, ( reg & ~( 15u << 28 ) ) | ( 4u << 28 ) );
+  reg = READ_REG( lpcon, 0x20 );
+  WRITE_REG( lpcon, 0x20, ( reg & ~0xff000000u ) | 0x44000000u );
+  WRITE_REG( pmu, 0xdc, BSP_BIT32( 31 ) );
+  WRITE_REG( pmu, 0xd0, BSP_BIT32( 28 ) );
+
+  /* Select the 40 MHz crystal while configuring the 480 MHz PLL. */
+  reg = READ_REG( CLK_PCR_BASE, 0x11c );
+  WRITE_REG( CLK_PCR_BASE, 0x11c, reg & ~0xffu );
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG, reg & ~0xffu );
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_SYSCLK_CONF_REG );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_SYSCLK_CONF_REG, reg & ~( 3u << 16 ) );
+  ( (void (*)( uint32_t )) (uintptr_t) 0x40000048U )( 40 );
+
+  /* rtc_clk_init installs the safe MSPI divider before PLL configuration. */
+  reg = READ_REG( CLK_PCR_BASE, 0x1c );
+  WRITE_REG( CLK_PCR_BASE, 0x1c, ( reg & ~0xff00u ) | ( 5u << 8 ) );
+
+  /* rtc_clk_bbpll_enable()/configure(), clk_tree_ll.h and regi2c_impl.c.
+   * The C6 PLL is fixed at 480 MHz and supports a 40 MHz crystal.
+   */
+  WRITE_REG( pmu, 0xcc, 0x70000000u );
+  WRITE_REG( pmu, 0xcc, 0x02000000u );
+  uint32_t clock = READ_REG( lpcon, 0x18 );
+  uint32_t source = READ_REG( lpcon, 0x10 );
+  uint32_t analog_mask = READ_REG( ESP_ANALOG_I2C_BASE, 0x1c );
+  WRITE_REG( lpcon, 0x18, clock | BSP_BIT32( 2 ) );
+  WRITE_REG( lpcon, 0x10, source | 1u );
+  bsp_c6_rtc_tune();
+  bsp_voltage_init();
+  reg = READ_REG( ESP_ANALOG_I2C_BASE, 0x18 );
+  WRITE_REG( ESP_ANALOG_I2C_BASE, 0x18, ( reg & ~4u ) | 8u );
+  bsp_esp_bbpll_i2c_write( 2, 0xffu, 0x50u );
+  bsp_esp_bbpll_i2c_write( 3, 0xffu, 8u );
+  bsp_esp_bbpll_i2c_write( 5, 0x77u, 0u );
+  bsp_esp_bbpll_i2c_write( 6, 0xffu, 0x73u );
+  bsp_esp_bbpll_i2c_write( 9, 3u, 2u );
+  uint32_t timeout = 1000000;
+  while ( !( READ_REG( ESP_ANALOG_I2C_BASE, 0x18 ) & BSP_BIT32( 24 ) ) ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32-C6: PLL calibration timed out" );
+    }
+  }
+  /* ESP-IDF waits 10 us after CAL_DONE before stopping calibration. */
+  bsp_c6_delay( 10 );
+  reg = READ_REG( ESP_ANALOG_I2C_BASE, 0x18 );
+  WRITE_REG( ESP_ANALOG_I2C_BASE, 0x18, ( reg & ~8u ) | 4u );
+  WRITE_REG( ESP_ANALOG_I2C_BASE, 0x1c, analog_mask );
+  WRITE_REG( lpcon, 0x10, source );
+  WRITE_REG( lpcon, 0x18, clock );
