 {
+#if BSP_ESP32P4_REVISION == 1
+  /* All supported L2 modes use only upper SRAM. Preserve ROM's mapping and
+   * cache configuration; never make the lower-bank allocator depend on size. */
+  uint32_t cache_size = READ_REG( (uintptr_t) 0x3ff10000U, 0x278 );
+  if ( cache_size != ( 1U << 9 ) && cache_size != ( 1U << 10 ) &&
+       cache_size != ( 1U << 11 ) ) {
+    rtems_panic( "ESP32-P4 v1: unsupported L2 cache size" );
+  }
+#endif
+
+#if defined( LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H )
+  /* Like ESP-IDF, permit execution from SRAM. The direct-boot ROM leaves
+   * PMA entry 14 read/write only, which also constrains machine mode.
+   * Keep its range and other attributes, adding only execute permission.
+   */
+  uint32_t sram_pma;
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+    "csrr %0, 0xbce\n"
+    "csrw 0xbce, zero\n"
+    "ori %0, %0, 4\n"
+    "csrw 0xbce, %0\n"
+    ".option pop\n"
+    : "=&r" ( sram_pma )
+    :
+    : "memory"
+  );
+#endif
+
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+  bsp_esp32s31_initialize_pma();
+#endif
+
+  bsp_clock_init();
+
+#if defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+  bsp_p4_pvt_init();
+#elif defined( LIBBSP_ESP32_C3_CHIP_DEFINITIONS_H )
+  bsp_c3_rtc_init();
+#elif defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+  bsp_c6_rtc_init();
+#endif
+
+  uint32_t timg_wdtconfig0;
+
+#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_H2_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H)
+  /* Unlock and disable LP WDT */
+  WRITE_REG( LP_WDT_BASE, LP_WDT_WPROTECT_OFFSET, 0x50d83aa1U );
+  uint32_t lp_wdt = READ_REG( LP_WDT_BASE, 0x0 );
+  WRITE_REG( LP_WDT_BASE, 0x0, lp_wdt & ~( BSP_BIT32( 31 ) | BSP_BIT32( 12 ) ) );
+
+  /* Unlock and auto-feed the super watchdog (SWD) */
+  WRITE_REG( LP_WDT_BASE, LP_WDT_SWD_WPROTECT_OFFSET, 0x50d83aa1U );
+  uint32_t swd = READ_REG( LP_WDT_BASE, LP_WDT_SWD_CONFIG_OFFSET );
+  WRITE_REG( LP_WDT_BASE, LP_WDT_SWD_CONFIG_OFFSET, swd | BSP_BIT32( 18 ) );
+#else
   uint32_t wdt_config0;
   uint32_t swd_conf;
-  uint32_t timg_wdtconfig0;
 
   /* disable RTC watchdog write protection */
   RTC_WRITE( RTC_CNTL_WDTWPROTECT_REG, RTC_CNTL_WDTWPROTECT_KEY );
 
-  /* disable the RTC watchdog */
+  /*
+   * Disable the RTC watchdog.
+   *
+   * & ~EN, not & EN.  The original cleared every bit *except* the enable,
+   * which is the inverse of what it reads as -- it left the watchdog running
+   * and cleared its stage-action fields instead.
+   *
+   * That was accidentally safe rather than wrong in effect: RTC_CNTL_WDT_STG0
+   * and its three siblings occupy bits 30:28 downwards and encode 0 as "no
+   * action", so a watchdog with every stage set to nothing does nothing.  It
+   * is corrected because the next reader should not have to work that out, and
+   * because a mistake in this register presents on real silicon as a boot loop
+   * with no other symptom -- QEMU does not model these, so it has never been
+   * exercised either way.
+   */
   wdt_config0 = RTC_READ( RTC_CNTL_WDTCONFIG0_REG );
-  RTC_WRITE( RTC_CNTL_WDTCONFIG0_REG, wdt_config0 & RTC_CNTL_WDTCONFIG0_EN );
+  RTC_WRITE(
+    RTC_CNTL_WDTCONFIG0_REG,
+    wdt_config0 & ~( RTC_CNTL_WDTCONFIG0_EN | RTC_CNTL_WDT_FLASHBOOT_MOD_EN )
+  );
 
   /* disable super watchdog write protection */
   RTC_WRITE( RTC_CNTL_SWD_WPROTECT_REG, RTC_CNTL_SWD_WPROTECT_KEY );
@@ -82,15 +910,48 @@ void bsp_start( void )
 
   /* clear SWD stall register */
   RTC_WRITE( RTC_CNTL_SW_CPU_STALL_REG, 0 );
+#endif
+
+  /*
+   * Disable timergroup 0's watchdog, the same correction as above -- and
+   * unlock it first, which the RTC watchdog above gets and this one did not.
+   *
+   * Every write to the timergroup watchdog registers is discarded while
+   * TIMG_WDTWPROTECT_REG holds anything other than the key, with no error and
+   * no other symptom, so the disable was a no-op and the watchdog stayed
+   * enabled at its reset timeout.
+   *
+   * The flash-boot mode bit matters more than the enable.  It defaults to 1
+   * and is independent: clearing only TIMG_WDTCONFIG0_EN leaves a watchdog
+   * that still bites, which is what the register read back as on hardware --
+   * 0x0004c000, enable clear and flash-boot mode set.
+   *
+   * On silicon that is roughly a second and a half, after which the chip
+   * resets with rst:0x7 (TG0WDT_SYS_RST).  Anything that boots and finishes
+   * inside that window looks perfectly healthy, which is why every test so far
+   * has: it only bites once something runs for longer, and the first thing
+   * that did was bringing up WiFi.  QEMU models neither watchdog, so this
+   * could not have shown up before hardware.
+   */
+  TIMG_WRITE( TIMG_WDTWPROTECT_REG, TIMG_WDTWPROTECT_KEY );
 
-  /* Disable timergroup 0 watchdog */
   timg_wdtconfig0 = TIMG_READ( TIMG_WDTCONFIG0_REG );
-  TIMG_WRITE( TIMG_WDTCONFIG0_REG, timg_wdtconfig0 & TIMG_WDTCONFIG0_EN );
+  TIMG_WRITE(
+    TIMG_WDTCONFIG0_REG,
+    timg_wdtconfig0 & ~( TIMG_WDTCONFIG0_EN | TIMG_WDT_FLASHBOOT_MOD_EN )
+  );
 
   bsp_interrupt_initialize();
 }
 
 /* src is the offset in flash */
+/*
+ * The distance from the instruction window to the data window onto the same
+ * SRAM, defined in the BSP's linker script.  A LINKER_SYMBOL rather than a
+ * constant here so that changing the memory map changes one place.
+ */
+LINKER_SYMBOL( esp32c_iram_to_dram_delta );
+
 BSP_START_TEXT_SECTION static inline void copy_from_flash_offset(
   void       *dest,
   const void *src,
@@ -98,7 +959,13 @@ BSP_START_TEXT_SECTION static inline void copy_from_flash_offset(
 )
 {
   /* The RAM load sections are offset from 0x0, offset from mapped flash base */
+#if defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H)
+  uintptr_t flash_base = 0x40000000;
+#elif defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_H2_CHIP_DEFINITIONS_H)
+  uintptr_t flash_base = 0x42000000;
+#else
   uintptr_t flash_base = 0x3c000000;
+#endif
 
   uintptr_t flash_address = ( (uintptr_t) src );
   flash_address += flash_base;
@@ -113,8 +980,17 @@ BSP_START_TEXT_SECTION void bsp_start_copy_sections( void )
     (size_t) bsp_section_data_size
   );
 
+  /*
+   * .fast_text is linked in the instruction window so that calls into it
+   * resolve to 0x4038xxxx, but it is *written* through the data window.  The
+   * two address the same SRAM; stores through the data bus are the access the
+   * part guarantees, and are how ESP-IDF loads its own IRAM.
+   *
+   * esp32c_iram_to_dram_delta comes from the linker script, so the two places
+   * that know the window layout cannot drift apart.
+   */
   copy_from_flash_offset(
-    bsp_section_fast_text_begin,
+    (char *) bsp_section_fast_text_begin + (intptr_t) esp32c_iram_to_dram_delta,
     bsp_section_fast_text_load_begin,
     (size_t) bsp_section_fast_text_size
   );
@@ -124,4 +1000,14 @@ BSP_START_TEXT_SECTION void bsp_start_copy_sections( void )
     bsp_section_fast_data_load_begin,
     (size_t) bsp_section_fast_data_size
   );
+#if defined( LIBBSP_ESP32_H2_CHIP_DEFINITIONS_H )
+  /* Publish the SRAM instructions before bsp_start calls the PLL routines. */
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zifencei\n"
+    "fence.i\n"
+    ".option pop\n"
+    ::: "memory"
+  );
+#endif
 }
diff --git a/bsps/riscv/esp32/start/bspvoltage.h b/bsps/riscv/esp32/start/bspvoltage.h
new file mode 100644
index 0000000000000000000000000000000000000000..01898e1190ee05ecbdbc1e4286e3bbff8e2d23ea
--- /dev/null
+++ b/bsps/riscv/esp32/start/bspvoltage.h
@@ -0,0 +1,260 @@
+/*
+ * SPDX-FileCopyrightText: 2022-2026 Espressif Systems (Shanghai) CO LTD
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * Direct-boot voltage prerequisites, from ESP-IDF 9a97f6c54ec638111ce55cd36581b3c192f15207:
+ * esp_hw_support/port/<chip>/{rtc_clk_init.c,pmu_param.c,pmu_init.c},
+ * esp_hal_regi2c/<chip>/regi2c_impl.c and soc/<chip> register definitions.
+ * Initialize LP_ACTIVE sleep controls before building a retained LP_SLEEP
+ * template; P4 preserves XPD, matching its distinct PMU initializer.
+ * This is not the full IDF PMU/PVT or sleep policy.  The caller has selected
+ * XTAL, updated ROM timing and enabled the chip's analog master clock.
+ * C3 and H2 deliberately retain their existing startup sequences.
+ */
+#if defined( LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H ) \
+  || defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H ) \
+  || defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H ) \
+  || defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+#define VOLTAGE_I2C_BASE (uintptr_t) 0x2010f800
+#define VOLTAGE_PMU_BASE (uintptr_t) 0x20704000
+#elif defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+#define VOLTAGE_I2C_BASE (uintptr_t) 0x50124000
+#define VOLTAGE_PMU_BASE (uintptr_t) 0x50115000
+#else
+#define VOLTAGE_I2C_BASE (uintptr_t) 0x600af800
+#define VOLTAGE_PMU_BASE (uintptr_t) 0x600b0000
+#endif
+
+static void bsp_voltage_i2c_wait( uint32_t host )
+{
+  uint32_t timeout = 1000000;
+
+  while ( READ_REG( VOLTAGE_I2C_BASE, host ) & BSP_BIT32( 25 ) ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32: voltage regi2c timed out" );
+    }
+  }
+}
+
+/* C6 also accesses ULP (0x61) for power-on o-code initialization. */
+static void bsp_voltage_i2c_write(
+  uint32_t block,
+  uint32_t address,
+  uint32_t mask,
+  uint32_t value
+)
+{
+  uint32_t host;
+  uint32_t command = block | ( address << 8 );
+
+#if defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+  /* P4 actively selects one slave on master 0, unlike C5/C6/S31. */
+  uint32_t select = block == 0x6du ? 10 : 12;
+  WRITE_REG( VOLTAGE_I2C_BASE, 0x20,
+    ( READ_REG( VOLTAGE_I2C_BASE, 0x20 ) & ~0xffffffu ) | BSP_BIT32( select ) );
+  WRITE_REG( VOLTAGE_I2C_BASE, 0x1c,
+    READ_REG( VOLTAGE_I2C_BASE, 0x1c ) & ~0xffffffu );
+  host = 0;
+#else
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+  /* DIG_REG (0x6d) bit 13, BIAS (0x6a) bit 4, MPLL (0x0b) bit 12.
+   * CONF2 shift 4, CONF1 shift 2. */
+  uint32_t bit_mask;
+  switch ( block ) {
+    case 0x6d: bit_mask = 1u << 13; break; /* DIG_REG */
+    case 0x6a: bit_mask = 1u << 4; break;  /* BIAS */
+    case 0x0b: bit_mask = 1u << 12; break; /* MPLL */
+    default: bit_mask = 0; break;
+  }
+  uint32_t select = bit_mask << 4;
+  uint32_t read_mask = ~( bit_mask << 2 ) & 0xffffffu;
+  host = ( READ_REG( VOLTAGE_I2C_BASE, 0x20 ) & select ) != 0 ? 0 : 4;
+  WRITE_REG( VOLTAGE_I2C_BASE, 0x1c, read_mask );
+#else
+#if defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+  const uint32_t select = block == 0x61u ? 10 : 12;
+  const uint32_t read_bit = block == 0x61u ? 8 : 10;
+#else
+  const uint32_t select = 12;
+  const uint32_t read_bit = 10;
+#endif
+  host = ( READ_REG( VOLTAGE_I2C_BASE, 0x20 ) & BSP_BIT32( select ) )
+    != 0 ? 0 : 4;
+  WRITE_REG( VOLTAGE_I2C_BASE, 0x1c, 0xffffffu & ~BSP_BIT32( read_bit ) );
+#endif
+#endif
+  bsp_voltage_i2c_wait( host );
+  WRITE_REG( VOLTAGE_I2C_BASE, host, command );
+  bsp_voltage_i2c_wait( host );
+  uint32_t data = ( READ_REG( VOLTAGE_I2C_BASE, host ) >> 16 ) & 0xffu;
+  data = ( data & ~mask ) | ( value & mask );
+  WRITE_REG( VOLTAGE_I2C_BASE, host,
+    command | BSP_BIT32( 24 ) | ( data << 16 ) );
+  bsp_voltage_i2c_wait( host );
+}
+
+static void bsp_voltage_field( uint32_t offset, uint32_t mask, uint32_t value )
+{
+  WRITE_REG( VOLTAGE_PMU_BASE, offset,
+    ( READ_REG( VOLTAGE_PMU_BASE, offset ) & ~mask ) | value );
+}
+
+#if !defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+static uint32_t bsp_voltage_dbias(
+  uint32_t calibrated,
+  uint32_t margin,
+  uint32_t fallback
+)
+{
+  if ( calibrated == 0 ) {
+    return fallback;
+  }
+  return calibrated + margin > 31 ? 31 : calibrated + margin;
+}
+#endif
+
+static void bsp_voltage_init( void )
+{
+  uint32_t mask = READ_REG( VOLTAGE_I2C_BASE, 0x1c );
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+  /* pmu_hp_system_init(ACTIVE): the shared analog master is not owned by
+   * any individual PLL.  Power it and release isolation/retention. */
+  bsp_voltage_field( 0x1c, 7u << 20, BSP_BIT32( 22 ) );
+  WRITE_REG( VOLTAGE_PMU_BASE, 0xf0, BSP_BIT32( 28 ) | BSP_BIT32( 2 ) );
+  WRITE_REG( VOLTAGE_PMU_BASE, 0x110, BSP_BIT32( 31 ) );
+#elif defined( LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H ) \
+  || defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+  bsp_voltage_field( 0x14, 7u << 26, BSP_BIT32( 28 ) );
+  WRITE_REG( VOLTAGE_PMU_BASE, 0xe8, BSP_BIT32( 31 ) );
+#endif
+#if defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+  uint32_t select = READ_REG( VOLTAGE_I2C_BASE, 0x20 );
+
+  /* P4 FORCE fields are NOT the C5/C6 ENIF fields. */
+  bsp_voltage_i2c_write( 0x6d, 10, 3u, 3u );
+  bsp_voltage_i2c_write( 0x6d, 13, 12u, 0 );
+  bsp_voltage_i2c_write( 0x6a, 4, 15u, 0 );
+
+  const uintptr_t efuse = 0x5012d000;
+  uint32_t version = READ_REG( efuse, 0x4c );
+  uint32_t blk = ( ( version >> 11 ) & 3u ) * 100
+    + ( ( version >> 8 ) & 7u );
+  uint32_t calibrated = blk >= 2 && blk != 100 ? READ_REG( efuse, 0x54 ) : 0;
+  uint32_t hp = bsp_voltage_dbias( ( calibrated >> 16 ) & 15u, 16, 24 );
+  uint32_t lp = bsp_voltage_dbias( ( calibrated >> 20 ) & 15u, 20, 29 );
+
+  /* Keep HP LDO on until the DCDC has settled.  Preserve a higher PVT VSET. */
+  bsp_voltage_field( 0x28, BSP_BIT32( 18 ), BSP_BIT32( 18 ) );
+  bsp_voltage_field( 0x28, 31u << 27, hp << 27 );
+  bsp_voltage_field( 0x9c, 0xffa00000u, lp << 27 );
+  uint32_t vset = ( READ_REG( VOLTAGE_PMU_BASE, 0x28 ) >> 9 ) & 31u;
+  if ( vset < 27 ) {
+    vset = 27;
+  }
+#if BSP_ESP32P4_REVISION != 1
+  /* Only the v3 BSP uses IDF's >=3.1 feedback-resistor/FIB workaround. */
+  uint32_t major = ( ( version >> 4 ) & 3u ) | ( ( ( version >> 23 ) & 1u ) << 2 );
+  uint32_t revision = major * 100 + ( version & 15u );
+  if ( revision >= 301 ) {
+    bsp_voltage_field( 0x204, BSP_BIT32( 11 ), BSP_BIT32( 11 ) );
+  }
+#endif
+  /* pmu_ll_set_dcdc_en(true): clear DONE_FORCE, then request ON. */
+  bsp_voltage_field( 0x204, BSP_BIT32( 7 ), 0 );
+  bsp_voltage_field( 0x204, BSP_BIT32( 0 ), BSP_BIT32( 0 ) );
+  bsp_voltage_field( 0x10c, 3u, 0 ); /* release both switch force controls */
+  bsp_voltage_field( 0x18, 31u << 18, vset << 18 );
+  bsp_voltage_field( 0x28, BSP_BIT32( 14 ), BSP_BIT32( 14 ) );
+  ( (void (*)( uint32_t )) (uintptr_t) 0x4fc0003cU )( 1000 );
+#if BSP_ESP32P4_REVISION != 1
+  if ( revision >= 301 ) {
+    const uintptr_t lp_system = 0x50110000;
+    WRITE_REG( lp_system, 0x08,
+      ( READ_REG( lp_system, 0x08 ) & ~( 255u << 21 ) ) | ( 0xefu << 21 ) );
+    bsp_voltage_field( 0x204, BSP_BIT32( 11 ), 0 );
+    ( (void (*)( uint32_t )) (uintptr_t) 0x4fc0003cU )( 10 );
+  }
+#endif
+  bsp_voltage_field( 0x28, BSP_BIT32( 18 ), 0 );
+  /* pmu_hp_system_init(ACTIVE): do not retain reset sleep-LDO controls. */
+  bsp_voltage_field( 0x28,
+    BSP_BIT32( 16 ) | BSP_BIT32( 17 ) | ( 15u << 23 ), 0 );
+
+  WRITE_REG( VOLTAGE_I2C_BASE, 0x20, select );
+#else
+  bsp_voltage_i2c_write( 0x6d, 5, 0x80u, 0x80u );
+  bsp_voltage_i2c_write( 0x6d, 7, 0x80u, 0x80u );
+#if !defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+  /* C6 rtc_clk_init deliberately does not clear XPD_RTC/DIG_REG. */
+  bsp_voltage_i2c_write( 0x6d, 13, 12u, 0 );
+#endif
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+  /* bootloader_esp32s31.c:61-63: unconditional analog-bias setup before clocks */
+  bsp_voltage_i2c_write( 0x0b, 1, 3u, 3u );       /* MPLL IR_CAL_EXT_CAP = 3 */
+  bsp_voltage_i2c_write( 0x6a, 0, 0xf0u, 0xc0u ); /* BIAS DREG_1P1 = 12 */
+  bsp_voltage_i2c_write( 0x6a, 1, 0x0fu, 0x0cu ); /* BIAS DREG_1P1_PVT = 12 */
+  bsp_voltage_i2c_write( 0x6d, 14, 0xffu, 0x80u ); /* DIG_REG SCK_DCAP = 128 */
+#endif
+
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+  /* S31 uses a deliberate fixed-voltage/no-PVT profile with nominal biases (26).
+   * PVT is disabled in RTEMS. */
+  bsp_voltage_field( 0x20, 0xfe000000u, BSP_BIT32( 25 ) );
+  bsp_voltage_field( 0x34, ( 31u << 27 ) | ( 31u << 9 ) | ( 31u << 4 )
+      | BSP_BIT32( 18 ) | BSP_BIT32( 14 ) | BSP_BIT32( 3 ),
+    ( 26u << 27 ) | ( 0x1cu << 9 ) | ( 0xdu << 4 )
+      | BSP_BIT32( 18 ) | BSP_BIT32( 14 ) | BSP_BIT32( 3 ) );
+  bsp_voltage_field( 0x74, 31u << 27, 26u << 27 );
+  bsp_voltage_field( 0xc0, 0xffe00000u, ( 26u << 27 ) | BSP_BIT32( 22 ) );
+
+  /* rtc_clk_init.c / clk.c: enable RC_FAST in PMU (xpd_fosc=1, pd_osc=0) */
+  WRITE_REG( VOLTAGE_PMU_BASE, 0xd0,
+    ( READ_REG( VOLTAGE_PMU_BASE, 0xd0 ) & ~BSP_BIT32( 31 ) ) | BSP_BIT32( 30 ) );
+  ( (void (*)( uint32_t )) (uintptr_t) 0x2f80003cU )( 50 ); /* 50 us delay */
+
+  /* Select fast clock source RC_FAST (0) and slow clock source RC_SLOW (0) */
+  const uintptr_t lp_root_clk_conf = 0x20701000;
+  WRITE_REG( lp_root_clk_conf, 0x00,
+    READ_REG( lp_root_clk_conf, 0x00 ) & ~( 3u << 26 ) );
+  ( (void (*)( uint32_t )) (uintptr_t) 0x2f80003cU )( 3 );   /* 3 us delay */
+  WRITE_REG( lp_root_clk_conf, 0x00,
+    READ_REG( lp_root_clk_conf, 0x00 ) & ~( 7u << 23 ) );
+  ( (void (*)( uint32_t )) (uintptr_t) 0x2f80003cU )( 300 ); /* 300 us delay */
+
+  /* Force releases and ICG updates belong to sleep's full FSM initializer,
+   * after its ACTIVE/LP policies are installed, not this voltage-only setup.
+   */
+  bsp_voltage_field( 0x15c, 3u << 16, 2u << 16 );
+#else
+#if defined( LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H )
+  const uintptr_t efuse = 0x600b4800;
+  uint32_t version = READ_REG( efuse, 0x4c );
+  uint32_t chip = ( ( version >> 4 ) & 3u ) * 100 + ( version & 15u );
+  uint32_t blk = ( ( version >> 11 ) & 3u ) * 100
+    + ( ( version >> 8 ) & 7u );
+  bool valid = ( chip == 1 && blk >= 1 ) || ( chip >= 100 && blk >= 2 );
+  uint32_t calibrated = valid ? READ_REG( efuse, 0x50 ) : 0;
+  uint32_t hp = bsp_voltage_dbias( ( calibrated >> 10 ) & 15u, 19, 28 );
+  uint32_t lp = bsp_voltage_dbias( ( calibrated >> 14 ) & 15u, 19, 28 );
+#else
+  const uintptr_t efuse = 0x600b0800;
+  uint32_t version = READ_REG( efuse, 0x50 );
+  uint32_t blk = ( ( version >> 30 ) & 3u ) * 100
+    + ( ( version >> 27 ) & 7u );
+  uint32_t calibrated = blk >= 3 ? READ_REG( efuse, 0x4c ) : 0;
+  uint32_t hp = bsp_voltage_dbias( calibrated & 31u, 2, 25 );
+  uint32_t lp = bsp_voltage_dbias( ( calibrated >> 5 ) & 31u, 2, 26 );
+#endif
+  bsp_voltage_field( 0x28, BSP_BIT32( 14 ), BSP_BIT32( 14 ) );
+  bsp_voltage_field( 0x28, 31u << 27, hp << 27 );
+  bsp_voltage_field( 0x5c, 31u << 27, hp << 27 );
+  bsp_voltage_field( 0x9c, 0xffe00000u, ( lp << 27 ) | BSP_BIT32( 22 ) );
+#endif
+#endif
+  WRITE_REG( VOLTAGE_I2C_BASE, 0x1c, mask );
+}
+#endif
