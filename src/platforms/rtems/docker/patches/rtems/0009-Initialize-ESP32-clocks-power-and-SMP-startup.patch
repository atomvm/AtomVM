+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+static void bsp_s31_bus_update( void )
+{
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x14, 1u );
+  uint32_t timeout = 1000000;
+  while ( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x14 ) & 1u ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32-S31: clock update timed out" );
+    }
+  }
+}
+
+static void bsp_s31_cpll_init( void )
+{
+  const uintptr_t lp_clkrst = 0x20701000;
+  const uintptr_t lpcon = 0x2010f000;
+  const uintptr_t syscon = 0x20109c00;
+  uint32_t reg;
+
+  /* rtc_clk_cpu_freq_to_xtal(): switch all buses to XTAL before changing
+   * CPLL dividers. S31 supports a 40 MHz crystal.
+   */
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x4, 0u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x8, 0u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0xc, 0u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x10, 0u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x0, 0u );
+  bsp_s31_bus_update();
+  if ( ets_update_cpu_frequency != NULL ) {
+    ets_update_cpu_frequency( 40 );
+  }
+
+  /* clk_ll_cpll_enable(): power, ungate, HP clock, ACTIVE power state. */
+  reg = READ_REG( CLK_PMU_BASE, 0xf4 );
+  WRITE_REG( CLK_PMU_BASE, 0xf4, reg | ( 1u << 27 ) | ( 1u << 23 ) );
+  reg = READ_REG( CLK_PMU_BASE, 0xf4 );
+  WRITE_REG( CLK_PMU_BASE, 0xf4, reg | ( 1u << 19 ) );
+  reg = READ_REG( CLK_HP_ALIVE_SYS_BASE, 0x0 );
+  WRITE_REG( CLK_HP_ALIVE_SYS_BASE, 0x0, reg | ( 1u << 29 ) );
+  reg = READ_REG( CLK_PMU_BASE, 0x1c );
+  WRITE_REG( CLK_PMU_BASE, 0x1c, reg | ( 1u << 27 ) | ( 1u << 23 ) );
+
+  /* clk_ll_cpll_set_freq_mhz(): XTAL40 * feedback8 / reference1. */
+  reg = READ_REG( lp_clkrst, 0x4c );
+  WRITE_REG( lp_clkrst, 0x4c, ( reg & ~0xfffu ) | 0x81u );
+  uint32_t clock = READ_REG( lpcon, 0x18 );
+  uint32_t force = READ_REG( lpcon, 0x1c );
+  uint32_t source = READ_REG( syscon, 0x04 );
+  WRITE_REG( lpcon, 0x18, clock | ( 1u << 2 ) );
+  WRITE_REG( lpcon, 0x1c, force | ( 1u << 2 ) );
+  WRITE_REG( syscon, 0x04, source | ( 1u << 12 ) );
+  bsp_voltage_init();
+  /* rtc_clk_cpll_configure(): start, wait CAL_END, settle 10 us, stop. */
+  reg = READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x174 );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x174, reg & ~( 1u << 3 ) );
+  uint32_t timeout = 1000000;
+  while ( !( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x174 ) & ( 1u << 2 ) ) ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32-S31: CPLL calibration timed out" );
+    }
+  }
+  ( (void (*)( uint32_t )) (uintptr_t) 0x2f80003cU )( 10 );
+  reg = READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x174 );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x174, reg | ( 1u << 3 ) );
+  WRITE_REG( syscon, 0x04, source );
+  WRITE_REG( lpcon, 0x18, clock );
+  WRITE_REG( lpcon, 0x1c, force );
+}
+#endif
