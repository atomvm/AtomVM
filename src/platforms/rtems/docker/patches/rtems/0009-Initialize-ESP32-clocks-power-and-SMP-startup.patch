+#define HP_SYS_CORE1_CLIC_CLK_EN ( 1U << 1 )
+#define HP_SYS_CORE1_CPU_CLK_EN  ( 1U << 4 )
+#define HP_SYS_CORE1_RST_EN_BIT  ( 1U << 8 )
