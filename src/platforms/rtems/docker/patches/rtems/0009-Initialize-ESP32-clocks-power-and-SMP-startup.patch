+static void bsp_p4_regi2c_write( uint8_t block, uint8_t reg, uint8_t val )
+{
+  /* ESP-IDF regi2c_enable_block(): select only the CPLL on master 0. */
+  WRITE_REG( CLK_LP_I2C_ANA_BASE, 0x20, ( READ_REG( CLK_LP_I2C_ANA_BASE, 0x20 ) & ~0xffffffu ) | ( 1u << 11 ) );
+  WRITE_REG( CLK_LP_I2C_ANA_BASE, 0x1c, READ_REG( CLK_LP_I2C_ANA_BASE, 0x1c ) & ~0xffffffu );
+  uint32_t timeout = 1000000;
+  while ( READ_REG( CLK_LP_I2C_ANA_BASE, 0x00 ) & ( 1u << 25 ) ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32-P4: regi2c busy timed out" );
+    }
+  }
+  uint32_t data = ( (uint32_t) block & 0xffu ) |
+                  ( ( (uint32_t) reg & 0xffu ) << 8 ) |
+                  ( ( (uint32_t) val & 0xffu ) << 16 ) |
+                  ( 1u << 24 );
+  WRITE_REG( CLK_LP_I2C_ANA_BASE, 0x00, data );
+  timeout = 1000000;
+  while ( READ_REG( CLK_LP_I2C_ANA_BASE, 0x00 ) & ( 1u << 25 ) ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32-P4: regi2c write timed out" );
+    }
+  }
+}
+
+static void bsp_p4_cpll_init( void )
+{
+  /* ESP-IDF rtc_clk_cpu_freq_to_xtal(): switch the root first, since the
+   * hardware can silently correct illegal dividers while CPLL is selected. */
+  WRITE_REG( CLK_LP_CLKRST_BASE, 0x40, READ_REG( CLK_LP_CLKRST_BASE, 0x40 ) & ~3u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x04, ( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x04 ) & ~( 0xffffffu << 5 ) ) );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x08, ( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x08 ) & ~( 0xffu | ( 0xffu << 24 ) ) ) );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x0c, ( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x0c ) & ~( 0xffu << 16 ) ) );
+  bsp_p4_bus_update();
+
+  if ( ets_update_cpu_frequency != NULL ) {
+    ets_update_cpu_frequency( 40 );
+  }
+
+  /* Enable LP_I2CMST clock */
+  WRITE_REG( CLK_LP_PERI_BASE, 0x00, READ_REG( CLK_LP_PERI_BASE, 0x00 ) | ( 1u << 27 ) );
+  WRITE_REG( CLK_LP_I2C_ANA_BASE, 0x34, READ_REG( CLK_LP_I2C_ANA_BASE, 0x34 ) | 1u );
+  bsp_voltage_init();
+
+  /* Power up CPLL in PMU */
+  WRITE_REG( CLK_PMU_BASE, 0xcc, READ_REG( CLK_PMU_BASE, 0xcc ) | ( 1u << 27 ) | ( 1u << 23 ) | ( 1u << 17 ) );
+
+  /* ESP-IDF rtc_clk_cpll_configure(): start calibration before programming
+   * the analog registers, then wait for completion and a timed settling period. */
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0xbc, READ_REG( CLK_HP_SYS_CLKRST_BASE, 0xbc ) & ~( 1u << 3 ) );
+
+  /* ESP-IDF clk_ll_cpll_set_config(): ECO1 uses div7_0=9 for 360 MHz;
+   * v3 uses div7_0=10 for 400 MHz. ECO0 is not supported by this BSP. */
+  bsp_p4_regi2c_write( 0x67, 2, 0x50 );
+#if BSP_ESP32P4_REVISION == 1
+  bsp_p4_regi2c_write( 0x67, 3, 9 );
+#else
+  bsp_p4_regi2c_write( 0x67, 3, 10 );
+#endif
+  bsp_p4_regi2c_write( 0x67, 6, 0x73 );
+
+  uint32_t timeout = 1000000;
+  while ( !( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0xbc ) & ( 1u << 2 ) ) ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32-P4: CPLL calibration timed out" );
+    }
+  }
+  ( (void (*)( uint32_t )) (uintptr_t) 0x4fc0003cU )( 10 ); /* ets_delay_us */
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0xbc, READ_REG( CLK_HP_SYS_CLKRST_BASE, 0xbc ) | ( 1u << 3 ) );
+  WRITE_REG( CLK_LP_PERI_BASE, 0x00, READ_REG( CLK_LP_PERI_BASE, 0x00 ) & ~( 1u << 27 ) );
+
+  /* Configure Bus Dividers: APB -> SYS -> MEM -> CPU */
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x0c, ( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x0c ) & ~( 0xffu << 16 ) ) | ( 1u << 16 ) );
+  bsp_p4_bus_update();
+
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x08, ( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x08 ) & ~( 0xffu << 24 ) ) );
+  bsp_p4_bus_update();
+
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x08, ( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x08 ) & ~0xffu ) | 1u );
+  bsp_p4_bus_update();
+
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x04, ( READ_REG( CLK_HP_SYS_CLKRST_BASE, 0x04 ) & ~( 0xffffffu << 5 ) ) );
+  bsp_p4_bus_update();
+
+  /* Select CPLL root clock */
+  WRITE_REG( CLK_LP_CLKRST_BASE, 0x40, ( READ_REG( CLK_LP_CLKRST_BASE, 0x40 ) & ~3u ) | 1u );
+}
+#endif
+
+static void bsp_clock_init( void )
+{
+  uint32_t cpu_freq_mhz = BSP_ESP32_CPU_FREQ_MHZ;
+
+#if defined( LIBBSP_ESP32_C3_CHIP_DEFINITIONS_H )
+
+  bsp_c3_clock_init();
+
+#elif defined( LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H )
+
+  uint32_t reg;
+
+  bsp_c5_bbpll_init();
+
+  /* CPU = PLL_F160M / 1, AHB = PLL_F160M / 4 = 40 MHz. */
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG, reg & ~0xFFu );
+
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG, ( reg & ~0xFFu ) | 3u );
+
+  /* SOC_CLK_SEL = PLL_F160M (2). */
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_SYSCLK_CONF_REG );
+  WRITE_REG(
+    CLK_PCR_BASE,
+    CLK_PCR_SYSCLK_CONF_REG,
+    ( reg & ~( 0x3u << 16 ) ) | ( 2u << 16 )
+  );
+
+  /* Latch the change and wait for the bus to settle. */
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_BUS_CLK_UPDATE_REG, 1u );
+  while ( READ_REG( CLK_PCR_BASE, CLK_PCR_BUS_CLK_UPDATE_REG ) != 0u ) {
+  }
+
+#elif defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+
+  uint32_t reg;
+
+  bsp_c6_bbpll_init();
+
+  /* CPU = PLL(480) with the HS divider at 3 -> 160 MHz. */
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG );
+  reg &= ~( 0xFFu << 8 );
+  reg &= ~( 1u << 16 );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG, reg );
+
+  /* SOC_CLK_SEL = PLL (1). */
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_SYSCLK_CONF_REG );
+  WRITE_REG(
+    CLK_PCR_BASE,
+    CLK_PCR_SYSCLK_CONF_REG,
+    ( reg & ~( 0x3u << 16 ) ) | ( 1u << 16 )
+  );
+
+#elif defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+
+  bsp_s31_cpll_init();
+
+  /* CPLL 320 -> CPU /1 (320), MEM /2 (160), SYS /3 (106.67), APB /2 (53.33). */
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x8, 1u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0xc, 2u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x10, 1u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x4, 0u );
+  WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0x0, 1u );
+
+  bsp_s31_bus_update();
+
+#elif defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+
+  bsp_p4_cpll_init();
+
+#elif defined( LIBBSP_ESP32_H2_CHIP_DEFINITIONS_H )
+
+  uint32_t reg;
+
+  bsp_h2_voltage_init();
+  bsp_h2_bbpll_init();
+  /* CPU = PLL(96) / 1, AHB = PLL(96) / 3 = 32 MHz, the AHB maximum. */
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_CPU_FREQ_CONF_REG, reg & ~0xFFu );
+
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG );
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_AHB_FREQ_CONF_REG, ( reg & ~0xFFu ) | 2u );
+
+  /* SOC_CLK_SEL = PLL (1). */
+  reg = READ_REG( CLK_PCR_BASE, CLK_PCR_SYSCLK_CONF_REG );
+  WRITE_REG(
+    CLK_PCR_BASE,
+    CLK_PCR_SYSCLK_CONF_REG,
+    ( reg & ~( 0x3u << 16 ) ) | ( 1u << 16 )
+  );
+
+  /* Latch the dividers and the new source, then wait for the bus to settle. */
+  WRITE_REG( CLK_PCR_BASE, CLK_PCR_BUS_CLK_UPDATE_REG, 1u );
+  while ( READ_REG( CLK_PCR_BASE, CLK_PCR_BUS_CLK_UPDATE_REG ) != 0u ) {
+  }
+
+#endif
+
+#if defined( LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H )
+  ( (void (*)( uint32_t )) (uintptr_t) 0x40000048U )( cpu_freq_mhz );
+#else
+  if ( ets_update_cpu_frequency != NULL ) {
+    ets_update_cpu_frequency( cpu_freq_mhz );
+  }
+#endif
+}
+
+#if defined( LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H )
+void bsp_esp32s31_initialize_pma( void )
+{
+  /*
+   * The ROM's PMA entry 14 maps the 512 KiB HP TCM as read/write, without
+   * execute permission.  PMA applies even in machine mode and is per hart.
+   * Give RTEMS the same executable SRAM mapping as ESP-IDF before starting
+   * any tasks; Wi-Fi can execute on a different hart from its initializer.
+   * Keep the ROM's other PMA regions and their cache attributes unchanged.
+   */
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+    "csrw 0xbce, zero\n"
+    "csrw 0xbde, %0\n"
+    "csrw 0xbce, %1\n"
+    ".option pop\n"
+    :
+    : "r" ( ( 0x2f000000U | ( 0x80000U / 2U - 1U ) ) >> 2 ),
+      "r" ( 0xc000001dU ) /* NAPOT, enabled, read/write/execute */
+    : "memory"
+  );
+}
+#endif
+
+/*
+ * LP WDT register offsets.  The H2 carries one extra configuration register at
+ * the end of the block, which shifts write protection, the super watchdog's
+ * configuration and its write protection by one word each.
+ */
+#if defined( LIBBSP_ESP32_H2_CHIP_DEFINITIONS_H )
+#define LP_WDT_WPROTECT_OFFSET     0x1cu
+#define LP_WDT_SWD_CONFIG_OFFSET   0x20u
+#define LP_WDT_SWD_WPROTECT_OFFSET 0x24u
+#else
+#define LP_WDT_WPROTECT_OFFSET     0x18u
+#define LP_WDT_SWD_CONFIG_OFFSET   0x1cu
+#define LP_WDT_SWD_WPROTECT_OFFSET 0x20u
+#endif
+
