+#if defined( LIBBSP_ESP32_H2_CHIP_DEFINITIONS_H )
+/*
+ * Only these three analog blocks are used at startup.  Match ESP-IDF's
+ * regi2c_enable_block(): each has its own master selector and read mask.
+ * Both this helper and the PLL routine must remain out of flash, including
+ * when optimizing: FLASH_PLL is derived from the BBPLL being calibrated.
+ */
+static BSP_FAST_TEXT_SECTION __attribute__((noinline)) void bsp_h2_i2c_write(
+  uint32_t block,
+  uint32_t address,
+  uint32_t mask,
+  uint32_t value
+)
+{
+  uint32_t select = block == 0x66u ? 9 : block == 0x6au ? 8 : 12;
+  uint32_t read_bit = block == 0x66u ? 7 : block == 0x6au ? 6 : 10;
+  uint32_t host = ( READ_REG( ESP_ANALOG_I2C_BASE, 0x20 ) & BSP_BIT32( select ) )
+    != 0 ? 0 : 4;
+  uint32_t command = block | ( address << 8 );
+
+  WRITE_REG( ESP_ANALOG_I2C_BASE, 0x1c, 0xffffffu & ~BSP_BIT32( read_bit ) );
+  while ( READ_REG( ESP_ANALOG_I2C_BASE, host ) & BSP_BIT32( 25 ) ) {
+  }
+  WRITE_REG( ESP_ANALOG_I2C_BASE, host, command );
+  while ( READ_REG( ESP_ANALOG_I2C_BASE, host ) & BSP_BIT32( 25 ) ) {
+  }
+  uint32_t data = ( READ_REG( ESP_ANALOG_I2C_BASE, host ) >> 16 ) & 0xffu;
+  data = ( data & ~mask ) | value;
+  WRITE_REG( ESP_ANALOG_I2C_BASE, host,
+    command | BSP_BIT32( 24 ) | ( data << 16 ) );
+  while ( READ_REG( ESP_ANALOG_I2C_BASE, host ) & BSP_BIT32( 25 ) ) {
+  }
+}
+
+static uint32_t bsp_h2_dbias( uint32_t calibrated, uint32_t fallback )
+{
+  /* get_act_{hp,lp}_dbias(): zero means unburnt; add two, saturating at 31. */
+  if ( calibrated == 0 ) {
+    return fallback;
+  }
+  return calibrated > 29 ? 31 : calibrated + 2;
+}
+
+static void bsp_h2_voltage_init( void )
+{
+  const uintptr_t efuse = 0x600b0800;
+  const uintptr_t pmu = 0x600b0000;
+  const uintptr_t lpcon = 0x600ad000;
+  uint32_t version = READ_REG( efuse, 0x6c );
+  uint32_t blk_version = ( ( version >> 5 ) & 3u ) * 100
+    + ( ( version >> 2 ) & 7u );
+  uint32_t hp = 17;
+  uint32_t lp = 18;
+  uint32_t reg;
+
+  /* Bootloader's low-temperature DREG_0P8 fix, then rtc_clk_init's handoff
+   * from analog I2C DREG control to the PMU, before raising CPU frequency. */
+  WRITE_REG( lpcon, 0x08, READ_REG( lpcon, 0x08 ) | BSP_BIT32( 2 ) );
+  bsp_h2_i2c_write( 0x6a, 0, 0xf0u, 0x80u );
+  bsp_h2_i2c_write( 0x6d, 8, 0x03u, 0 );
+  WRITE_REG( lpcon, 0x08, READ_REG( lpcon, 0x08 ) & ~BSP_BIT32( 2 ) );
+
+  if ( blk_version >= 3 ) {
+    uint32_t calibrated = READ_REG( efuse, 0x4c );
+    hp = bsp_h2_dbias( ( calibrated >> 17 ) & 31u, hp );
+    lp = bsp_h2_dbias( ( calibrated >> 22 ) & 31u, lp );
+  }
+  reg = READ_REG( pmu, 0x5c );
+  WRITE_REG( pmu, 0x5c, ( reg & ~( 31u << 27 ) ) | ( hp << 27 ) );
+  reg = READ_REG( pmu, 0x28 );
+  WRITE_REG( pmu, 0x28, ( reg & ~( 31u << 27 ) ) | ( hp << 27 ) );
+  reg = READ_REG( pmu, 0x9c );
+  WRITE_REG( pmu, 0x9c, ( reg & ~( 31u << 27 ) ) | ( lp << 27 ) );
+}
+
+/*
+ * _start copies .fast_text before boot_card runs the bsp_start sysinit item.
+ * Do not move this call earlier: SRAM has no code in it before that copy.
+ * Leave MSPI on the ROM's 64 MHz FLASH_PLL source and execute exclusively
+ * from SRAM until calibration has stopped.  Like IDF, wait for CAL_DONE:
+ * returning to flash on a timeout would use an uncalibrated flash clock.
+ */
+static BSP_FAST_TEXT_SECTION __attribute__((noinline)) void bsp_h2_bbpll_init( void )
+{
+  const uintptr_t pmu = 0x600b0000;
+  const uintptr_t lpcon = 0x600ad000;
+  uint32_t reg;
+
+  /* Power the PLL and the analog I2C master that programs it. */
+  WRITE_REG(
+    pmu,
+    0xcc,
+    BSP_BIT32( 25 ) | BSP_BIT32( 28 ) | BSP_BIT32( 29 ) | BSP_BIT32( 30 )
+  );
+
+  /* ANALOG_CLOCK_ENABLE(): the regi2c bus is gated by MODEM_LPCON. */
+  WRITE_REG( lpcon, 0x08, READ_REG( lpcon, 0x08 ) | BSP_BIT32( 2 ) );
+
+  /* Start calibration BEFORE programming the analog PLL configuration. */
+  reg = READ_REG( ESP_ANALOG_I2C_BASE, 0x18 );
+  WRITE_REG( ESP_ANALOG_I2C_BASE, 0x18, ( reg & ~BSP_BIT32( 2 ) ) | BSP_BIT32( 3 ) );
+  /* clk_ll_bbpll_set_config(): OC_REF_DIV, OC_DIV, DHREF_SEL and DLREF_SEL. */
+  bsp_h2_i2c_write( 0x66, 2, 0x0fu, 0x00u );
+  bsp_h2_i2c_write( 0x66, 3, 0x3fu, 0x01u );
+  bsp_h2_i2c_write( 0x66, 5, 0xf0u, 0x70u );
+  while ( !( READ_REG( ESP_ANALOG_I2C_BASE, 0x18 ) & BSP_BIT32( 24 ) ) ) {
+  }
+  /* ESP-IDF waits 10 us after CAL_DONE before stopping calibration. */
+  for ( volatile uint32_t delay = 0; delay < 1000; ++delay ) {
+    __asm__ volatile ( "nop" );
+  }
+  /* BBPLL CALIBRATION STOP */
+  reg = READ_REG( ESP_ANALOG_I2C_BASE, 0x18 );
+  WRITE_REG( ESP_ANALOG_I2C_BASE, 0x18, ( reg & ~BSP_BIT32( 3 ) ) | BSP_BIT32( 2 ) );
+  WRITE_REG( lpcon, 0x08, READ_REG( lpcon, 0x08 ) & ~BSP_BIT32( 2 ) );
+}
+#endif
