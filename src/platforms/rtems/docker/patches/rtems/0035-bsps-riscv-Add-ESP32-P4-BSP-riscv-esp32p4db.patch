+                  ( ( (uint32_t) reg & 0xffu ) << 8 ) |
+                  ( ( (uint32_t) val & 0xffu ) << 16 ) |
+                  ( 1u << 24 );
+  WRITE_REG( CLK_LP_I2C_ANA_BASE, 0x00, data );
+  timeout = 1000000;
+  while ( READ_REG( CLK_LP_I2C_ANA_BASE, 0x00 ) & ( 1u << 25 ) ) {
+    if ( --timeout == 0 ) {
+      rtems_panic( "ESP32-P4: regi2c write timed out" );
