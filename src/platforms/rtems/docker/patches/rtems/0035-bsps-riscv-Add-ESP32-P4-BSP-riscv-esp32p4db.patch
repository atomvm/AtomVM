+#define SYSTIMER_TARGET1_INTR       54
+#define SYSTIMER_TARGET2_INTR       55
+#define RSA_INTR                    68
+#define AES_INTR                    69
+#define SHA_INTR                    70
+#define ECC_INTR                    71
+#define ECDSA_INTR                  72
+#define KM_INTR                     73
+#define GPIO_INTR0                  74
+#define GPIO_INTR1                  75
+#define GPIO_INTR2                  76
+#define GPIO_INTR3                  77
+#define SW_INTR_0                   79
+#define SW_INTR_1                   80
+#define SW_INTR_2                   81
+#define SW_INTR_3                   82
+#define CACHE_INTR                  83
+#define MSPI_FLASH_INTR             84
+#define ETH_MAC_INTR                92
+#define USB_OTG_INTR                93
+#define ASSIST_DEBUG_INTR          127
+
+/* Compatibility aliases used by the shared BSP sources. */
+#define I2S_INTR              I2S0_INTR
+#define UART_INTR             UART0_INTR
+#define I2C_EXT0_INTR         I2C0_INTR
+#define TG_T0_INTR            TIMERGRP0_T0_INTR
+#define TG_WDT_INTR           TIMERGRP0_WDT_INTR
+#define TG1_T0_INTR           TIMERGRP1_T0_INTR
+#define TG1_WDT_INTR          TIMERGRP1_WDT_INTR
+#define LEDC_INTR             LEDC0_INTR
+#define GPIO_PROCPU_INTR      GPIO_INTR0
+
+#define RISCV_INTERRUPT_VECTOR_SOFTWARE SW_INTR_0
+#define RISCV_INTERRUPT_VECTOR_TIMER    SYSTIMER_TARGET0_INTR
+
+/* On-chip peripheral register windows. */
+#define GPIO_BASE            ( (uintptr_t) 0x500E0000U )
+#define IO_MUX_BASE          ( (uintptr_t) 0x500E1000U )
+#define I2C_BASE             ( (uintptr_t) 0x500C4000U )
+#define UART0_BASE           ( (uintptr_t) 0x500CA000U )
+#define UART1_BASE           ( (uintptr_t) 0x500CB000U )
+#define SYSTIMER_BASE        ( (uintptr_t) 0x500E2000U )
+#define USB_SERIAL_JTAG_BASE ( (uintptr_t) 0x500D2000U )
+#define SPI2_BASE            ( (uintptr_t) 0x500D0000U )
+#define TIMG_BASE            ( (uintptr_t) 0x500C2000U )
+#define INT_MATRIX_BASE      ( (uintptr_t) 0x500D6000U )
+#define SYSREG_BASE          ( (uintptr_t) 0x500E5000U )
+
+/* Low-power watchdog */
+#define LP_WDT_BASE          ( (uintptr_t) 0x50116000U )
+#define LP_AON_BASE          ( (uintptr_t) 0x50110000U )
+
+/* CLIC base for ESP32-P4 (16 internal + 32 external interrupt IDs). */
+#define CLIC_BASE            ( (uintptr_t) 0x20800000U )
+
+/* ESP32-P4 ROM function addresses. */
+#define UART_TX_ONE_CHAR_ADDR ( (void *) (uintptr_t) 0x4fc00054 )
+#define UART_RX_ONE_CHAR_ADDR ( (void *) (uintptr_t) 0x4fc00060 )
+#define UART_TX_FLUSH_ADDR    ( (void *) (uintptr_t) 0x4fc00074 )
