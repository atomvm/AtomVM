  * and the receive signal in, which is a coincidence of the map rather than a
  * rule, so they are spelled separately. */
-#if defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H)
 #define UART1_SIG_TX 13
 #define UART1_SIG_RX 13
 #else
@@ -289,7 +295,7 @@ static bool esp32c3_uart_set_baud( esp32c3_uart_context *ctx, uint32_t baud )
     return false;
   }
 
-#if defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H)
