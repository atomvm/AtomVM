+/*
+ * The ESP32-P4 routes 136 peripheral interrupt sources (0-135) through the
+ * interrupt matrix onto 32 CLIC external channels (CLIC IDs 16-47).
+ */
+#define RISCV_MAXIMUM_EXTERNAL_INTERRUPTS 136
+#define BSP_INTERRUPT_VECTOR_COUNT        RISCV_MAXIMUM_EXTERNAL_INTERRUPTS
+
+#define BSP_INTERRUPT_CUSTOM_VALID_VECTOR
+
+#define BSP_GPIO_PIN_COUNT     55
+#define BSP_GPIO_PINS_PER_BANK 32
+
