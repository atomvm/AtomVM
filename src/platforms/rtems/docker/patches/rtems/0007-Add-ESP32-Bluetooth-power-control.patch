--- /dev/null
+++ b/bsps/riscv/esp32/bt/bt_c3.c
@@ -0,0 +1,239 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSBSPsRISCVESP32BT
+ *
+ * @brief This source file contains the implementation of the ESP32-C3
+ *   Bluetooth hardware bring-up.
+ */
+
