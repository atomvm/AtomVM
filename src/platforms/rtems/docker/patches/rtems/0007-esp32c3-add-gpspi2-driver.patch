From af6997c77b6d52d88f2debf0b3879f00557881a3 Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Wed, 16 Sep 2026 22:50:47 -0400
Subject: [PATCH] esp32c3: Add a GPSPI2 driver, and stop a controller registering twice

The BSP has no SPI.  This adds one for GPSPI2, the general purpose
controller -- not SPI0 or SPI1, which are the flash interface and whose
registers are a different peripheral rather than a variant of this one.

It goes through <dev/spi/spi.h>, so the bus is an ordinary RTEMS SPI bus:
open the device file and hand it a spi_ioc_transfer list.  <bsp/spi.h>
defines BSP_SPI_REGISTER and BSP_SPI_BUS_COUNT for the same reason
<bsp/i2c.h> does -- RTEMS has no convention for registering a bus, so
portable code otherwise has to name the chip.

Transfers are always full duplex on the wire whatever the caller asked
for, so the driver drives both directions and lets the framework's NULL
buffer decide which half is kept.  Messages longer than the 64 byte
register file are split; DMA is not used.

The pads are the interesting part.  The IO_MUX defaults for FSPI on this
part are GPIO6, 7, 2 and 10, and every one is already spoken for: 6 is
I2C SCL, 7 and 10 are UART1, 2 is a strapping pin.  So the bus is routed
through the GPIO matrix to GPIO0, 1, 3 and 4, which the free list in
docs/esp32c3-bsp.md says are available, and each is claimed through
<bsp/pin.h> so that a later collision is refused rather than silent.

Writing that turned up a hole in the claim, and it is fixed here for I2C
as well as for SPI.  bsp_pin_claim() lets the same owner re-claim a pad,
deliberately, so a driver that configures one in several steps need not
track whether it has claimed yet -- and a *second registration of the same
driver* is indistinguishable from that.  So registering the controller at
a second path succeeded, reconfiguring it underneath the first bus.  Each
driver now refuses that itself, which the claim cannot do for it.

Register offsets and field positions are from the technical reference
manual cross-checked against esp-idf v5.3.1 soc/esp32c3 spi_reg.h, and
the GPIO matrix signal numbers against its gpio_sig_map.h.  Two positions
differ from the original ESP32 and neither announces itself: SPI_USR is
bit 24 rather than 18, so a transfer never starts, and USR_ADDR_BITLEN
begins at 27 rather than 26.

Tested by tests/bsp-spidrv in the rtems-esphome tree, which reads a JEDEC
ID from an is25lp016d through the framework, and by tests/bsp-gpspi,
which drives the same controller's registers directly so that the two
lanes bracket the driver between them.

---
diff --git a/bsps/riscv/esp32/i2c/i2c_c3.c b/bsps/riscv/esp32/i2c/i2c_c3.c
index f3c4a01edfa8c381693da34b590ceae516dd2917..821febf39782936c6ca2538b09006eeab159c300 100644
--- a/bsps/riscv/esp32/i2c/i2c_c3.c
+++ b/bsps/riscv/esp32/i2c/i2c_c3.c
@@ -188,6 +188,17 @@ typedef struct {
 
 static const char esp32c3_i2c_owner[] = "esp32c3 i2c";
 
+/*
+ * Whether the one controller this part has is already registered.
+ *
+ * The pin claim cannot answer this: a re-claim by the same owner succeeds by
+ * design, so a driver configuring a pad in several steps need not track
+ * whether it has claimed yet, and a second registration of this driver is
+ * indistinguishable from that.  Registering at a second path would otherwise
+ * succeed and reconfigure the controller underneath the first bus.
+ */
+static bool esp32c3_i2c_registered;
+
 static bool esp32c3_i2c_route_pin( uint32_t pin, uint32_t signal )
 {
   volatile uint32_t *mux = (volatile uint32_t *) IO_MUX_PIN_REG( pin );
@@ -493,6 +504,8 @@ static int esp32c3_i2c_set_clock( i2c_bus *bus, unsigned long clock )
 
 static void esp32c3_i2c_destroy( i2c_bus *bus )
 {
+  esp32c3_i2c_registered = false;
+
   I2C_REG( I2C_CTR ) = 0;
 
   /* Give the pads back, otherwise registering a bus again after a destroy
@@ -508,6 +521,11 @@ rtems_status_code esp32c3_i2c_register( const char *bus_path )
   esp32c3_i2c_bus *self;
   int rv;
 
+  if ( esp32c3_i2c_registered ) {
+    printk( "esp32c3 i2c: the controller is already registered\n" );
+    return RTEMS_RESOURCE_IN_USE;
+  }
+
   self = (esp32c3_i2c_bus *) i2c_bus_alloc_and_init( sizeof( *self ) );
 
   if ( self == NULL ) {
@@ -550,5 +568,7 @@ rtems_status_code esp32c3_i2c_register( const char *bus_path )
     return RTEMS_UNSATISFIED;
   }
 
+  esp32c3_i2c_registered = true;
+
   return RTEMS_SUCCESSFUL;
 }
