+#ifndef LIBBSP_ESP32_BSP_SPI_H
+#define LIBBSP_ESP32_BSP_SPI_H
+
+#include <rtems.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Registers the GPSPI2 controller as a bus device.
+ *
+ * The bus appears at @a bus_path and is driven through <dev/spi/spi.h>, so a
+ * device on it is reached with the ordinary open(), ioctl() and read()/write()
+ * that any other RTEMS SPI bus offers.
+ *
+ * This is GPSPI2, the general purpose controller.  It is not SPI0 or SPI1,
+ * which are the flash interface: driving those from here would be driving the
+ * memory the program is executing from.
+ *
+ * The four pads are claimed through <bsp/pin.h>, so a configuration that has
+ * already given one of them to I2C, UART1 or GPIO is refused rather than
+ * quietly winning.
+ *
+ * @param bus_path The path of the bus device file, for example "/dev/spi-0".
+ *
+ * @retval RTEMS_SUCCESSFUL Successful operation.
+ * @retval RTEMS_NO_MEMORY The bus could not be allocated.
+ * @retval RTEMS_RESOURCE_IN_USE One of the pads belongs to another driver.
+ * @retval RTEMS_UNSATISFIED The bus could not be registered at @a bus_path.
+ */
+rtems_status_code esp32c3_spi_register( const char *bus_path );
+
+/**
+ * @brief BSP-neutral names, for the same reason <bsp/i2c.h> has them.
+ *
+ * RTEMS has no convention for registering a SPI bus, so every BSP names the
+ * call after its own chip and portable code has no way to ask for "this
+ * board's SPI".  See #61.
+ */
+#define BSP_SPI_REGISTER esp32c3_spi_register
+#define BSP_SPI_BUS_COUNT 1
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* LIBBSP_ESP32_BSP_SPI_H */
diff --git a/bsps/riscv/esp32/spi/spi_c3.c b/bsps/riscv/esp32/spi/spi_c3.c
new file mode 100644
index 0000000000000000000000000000000000000000..c4de95c90aae31a128db7836908bcd306d8187ea
--- /dev/null
+++ b/bsps/riscv/esp32/spi/spi_c3.c
@@ -0,0 +1,342 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSBSPsRISCVESP32
+ *
+ * @brief ESP32 I2C master driver interface.
+ */
+
+/*
+ * Copyright (C) 2026 Samuel Price <thesamprice@gmail.com>
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE AUTHOR AND CONTRIBUTORS ``AS IS'' AND
+ * ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED.  IN NO EVENT SHALL THE AUTHOR OR CONTRIBUTORS BE LIABLE
+ * FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
+ * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS
+ * OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
+ * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
+ * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ */
+
+/*
+ * GPSPI2, the general purpose controller.  Not SPI0 or SPI1, which are the
+ * flash interface -- hw/ssi/esp32c3_spi.c models those and their registers are
+ * a different peripheral, not a variant of this one.
+ *
+ * Register offsets and field positions are from the technical reference
+ * manual, cross-checked against esp-idf v5.3.1 soc/esp32c3 spi_reg.h.  Two of
+ * them differ from the original ESP32 and neither announces itself: SPI_USR is
+ * bit 24 rather than 18, so a transfer simply never starts, and
+ * USR_ADDR_BITLEN begins at 27 rather than 26.
+ */
+
+#include <bsp.h>
+#include <bsp/spi.h>
+#include <bsp/pin.h>
+
+#include <dev/spi/spi.h>
+
+#include <rtems/bspIo.h>
+
+#include <errno.h>
+#include <inttypes.h>
+#include <string.h>
+
+#define SPI2_BASE 0x60024000U
+#define GPIO_BASE 0x60004000U
+#define IO_MUX_BASE 0x60009000U
+
+#define SPI_REG( off ) ( *(volatile uint32_t *) ( SPI2_BASE + (off) ) )
+
+#define SPI_CMD       0x0000
+#define SPI_ADDR      0x0004
+#define SPI_CTRL      0x0008
+#define SPI_CLOCK     0x000c
+#define SPI_USER      0x0010
+#define SPI_USER1     0x0014
+#define SPI_USER2     0x0018
+#define SPI_MS_DLEN   0x001c
+#define SPI_MISC      0x0020
+#define SPI_W0        0x0098
+
+#define SPI_CMD_USR       ( 1U << 24 )
+#define SPI_USER_MOSI     ( 1U << 27 )
+#define SPI_USER_MISO     ( 1U << 28 )
+#define SPI_USER_DOUTDIN  ( 1U << 0 )
+#define SPI_MISC_CS0_DIS  ( 1U << 0 )
+
+/* W0 through W15: 64 bytes, which is the most one transfer can carry without
+ * DMA.  A longer message is split. */
+#define SPI_BUF_BYTES 64
+
+/* Pad routing.  As in the I2C driver, these are GPIO and IO_MUX registers
+ * rather than SPI ones: whoever configures a pin owns its muxing. */
+#define GPIO_ENABLE_W1TS_REG  ( GPIO_BASE + 0x0024 )
+#define GPIO_FUNC_IN_SEL_REG( sig )  ( GPIO_BASE + 0x0154 + 4 * (sig) )
+#define GPIO_FUNC_OUT_SEL_REG( pin ) ( GPIO_BASE + 0x0554 + 4 * (pin) )
+#define IO_MUX_PIN_REG( n )   ( IO_MUX_BASE + 0x0004 + 4 * (n) )
+
+#define IO_MUX_FUN_IE         ( 1U << 9 )
+#define IO_MUX_MCU_SEL_SHIFT  12
+#define IO_MUX_MCU_SEL_MASK   ( 0x7U << IO_MUX_MCU_SEL_SHIFT )
+#define IO_MUX_FUNC_GPIO      1
+#define GPIO_FUNC_IN_SEL_ENA  ( 1U << 6 )
+
+/* GPIO matrix signal numbers, from esp-idf soc/esp32c3 gpio_sig_map.h. */
+#define FSPICLK_OUT_IDX 63
+#define FSPIQ_IN_IDX    64
+#define FSPID_OUT_IDX   65
+#define FSPICS0_OUT_IDX 68
+
+/*
+ * Pads.  The IO_MUX defaults for FSPI on this part are GPIO6, 7, 2 and 10,
+ * and every one of them is spoken for here: 6 is I2C SCL, 7 and 10 are UART1,
+ * and 2 is a strapping pin.  So the bus is routed through the GPIO matrix to
+ * pads that are actually free.  See docs/esp32c3-bsp.md for the list; it
+ * leaves 0, 1, 3, 4 and 11, and this takes four of them.
+ */
+#define SPI_CLK_PIN  0
+#define SPI_MOSI_PIN 1
+#define SPI_MISO_PIN 3
+#define SPI_CS_PIN   4
+
+static const char esp32c3_spi_owner[] = "esp32c3 spi";
+
+/*
+ * Whether the one controller this part has is already registered.
+ *
+ * The pin claim cannot answer this.  A re-claim by the same owner succeeds by
+ * design, so that a driver configuring a pad in several steps need not track
+ * whether it has claimed yet -- and that is exactly what a second registration
+ * of the same driver looks like to it.  So the driver has to say no itself.
+ */
+static bool esp32c3_spi_registered;
+
+typedef struct {
+  spi_bus base;
+} esp32c3_spi_bus;
+
+static bool esp32c3_spi_route_pin( uint32_t pin, bool input )
+{
+  volatile uint32_t *mux = (volatile uint32_t *) IO_MUX_PIN_REG( pin );
+  uint32_t value;
+
+  if ( !bsp_pin_claim( pin, esp32c3_spi_owner ) ) {
+    printk(
+      "esp32c3 spi: GPIO%" PRIu32 " belongs to %s\n",
+      pin,
+      bsp_pin_owner( pin )
+    );
+    return false;
+  }
+
+  value = *mux;
+  value &= ~IO_MUX_MCU_SEL_MASK;
+  value |= (uint32_t) IO_MUX_FUNC_GPIO << IO_MUX_MCU_SEL_SHIFT;
+  value |= IO_MUX_FUN_IE;
+  *mux = value;
+
+  if ( !input ) {
+    *(volatile uint32_t *) GPIO_ENABLE_W1TS_REG = 1U << pin;
+  }
+
+  return true;
+}
+
+static bool esp32c3_spi_route_pins( void )
+{
+  static const struct { uint32_t pin; bool input; } pads[] = {
+    { SPI_CLK_PIN,  false },
+    { SPI_MOSI_PIN, false },
+    { SPI_MISO_PIN, true  },
+    { SPI_CS_PIN,   false },
+  };
+  size_t i;
+
+  for ( i = 0; i < RTEMS_ARRAY_SIZE( pads ); ++i ) {
+    if ( !esp32c3_spi_route_pin( pads[ i ].pin, pads[ i ].input ) ) {
+      /* Give back whatever was claimed, so a second attempt is not refused
+       * by this one's leftovers. */
+      while ( i-- > 0 ) {
+        bsp_pin_release( pads[ i ].pin );
+      }
+      return false;
+    }
+  }
+
+  *(volatile uint32_t *) GPIO_FUNC_OUT_SEL_REG( SPI_CLK_PIN )  = FSPICLK_OUT_IDX;
+  *(volatile uint32_t *) GPIO_FUNC_OUT_SEL_REG( SPI_MOSI_PIN ) = FSPID_OUT_IDX;
+  *(volatile uint32_t *) GPIO_FUNC_OUT_SEL_REG( SPI_CS_PIN )   = FSPICS0_OUT_IDX;
+  *(volatile uint32_t *) GPIO_FUNC_IN_SEL_REG( FSPIQ_IN_IDX ) =
+    SPI_MISO_PIN | GPIO_FUNC_IN_SEL_ENA;
+
+  return true;
+}
+
+/*
+ * One chunk: at most SPI_BUF_BYTES, full duplex.  rx and tx may be the same
+ * buffer, may be NULL, and need not be the same length as each other -- the
+ * framework gives one length and a NULL for the direction not wanted.
+ */
+static void esp32c3_spi_chunk(
+  const uint8_t *tx,
+  uint8_t       *rx,
+  size_t         len
+)
+{
+  uint32_t words[ SPI_BUF_BYTES / sizeof( uint32_t ) ];
+  size_t i;
+
+  memset( words, 0, sizeof( words ) );
+
+  if ( tx != NULL ) {
+    memcpy( words, tx, len );
+  }
+
+  for ( i = 0; i < RTEMS_ARRAY_SIZE( words ); ++i ) {
+    SPI_REG( SPI_W0 + 4 * i ) = words[ i ];
+  }
+
+  /* Both directions always.  SPI is full duplex on the wire whatever the
+   * caller wanted, and asking for only one leaves the other undriven. */
+  SPI_REG( SPI_USER ) = SPI_USER_MOSI | SPI_USER_MISO | SPI_USER_DOUTDIN;
+  SPI_REG( SPI_USER1 ) = 0;
+  SPI_REG( SPI_USER2 ) = 0;
+  SPI_REG( SPI_ADDR ) = 0;
+  SPI_REG( SPI_MS_DLEN ) = (uint32_t) ( len * 8 - 1 );
+
+  SPI_REG( SPI_CMD ) = SPI_CMD_USR;
+
+  if ( rx != NULL ) {
+    for ( i = 0; i < RTEMS_ARRAY_SIZE( words ); ++i ) {
+      words[ i ] = SPI_REG( SPI_W0 + 4 * i );
+    }
+    memcpy( rx, words, len );
+  }
+}
+
+static int esp32c3_spi_transfer(
+  spi_bus                *bus,
+  const spi_ioc_transfer *msgs,
+  uint32_t                msg_count
+)
+{
+  uint32_t i;
+
+  (void) bus;
+
+  for ( i = 0; i < msg_count; ++i ) {
+    const spi_ioc_transfer *m = &msgs[ i ];
+    const uint8_t *tx = (const uint8_t *) m->tx_buf;
+    uint8_t *rx = (uint8_t *) m->rx_buf;
+    size_t done = 0;
+
+    if ( m->len == 0 ) {
+      continue;
+    }
+
+    while ( done < m->len ) {
+      size_t chunk = m->len - done;
+
+      if ( chunk > SPI_BUF_BYTES ) {
+        chunk = SPI_BUF_BYTES;
+      }
+
+      esp32c3_spi_chunk(
+        tx != NULL ? tx + done : NULL,
+        rx != NULL ? rx + done : NULL,
+        chunk
+      );
+
+      done += chunk;
+    }
+  }
+
+  return 0;
+}
+
+static int esp32c3_spi_setup( spi_bus *bus )
+{
+  /* Eight bits per word is what the buffer path above does; anything else
+   * would need the word size programmed and the packing changed, so it is
+   * refused rather than silently ignored. */
+  if ( bus->bits_per_word != 8 ) {
+    return -EINVAL;
+  }
+
+  if ( bus->lsb_first ) {
+    return -EINVAL;
+  }
+
+  return 0;
+}
+
+static void esp32c3_spi_destroy( spi_bus *bus )
+{
+  esp32c3_spi_registered = false;
+
+  bsp_pin_release( SPI_CLK_PIN );
+  bsp_pin_release( SPI_MOSI_PIN );
+  bsp_pin_release( SPI_MISO_PIN );
+  bsp_pin_release( SPI_CS_PIN );
+
+  spi_bus_destroy_and_free( bus );
+}
+
+rtems_status_code esp32c3_spi_register( const char *bus_path )
+{
+  esp32c3_spi_bus *self;
+  int rv;
+
+  if ( esp32c3_spi_registered ) {
+    printk( "esp32c3 spi: GPSPI2 is already registered\n" );
+    return RTEMS_RESOURCE_IN_USE;
+  }
+
+  self = (esp32c3_spi_bus *) spi_bus_alloc_and_init( sizeof( *self ) );
+
+  if ( self == NULL ) {
+    return RTEMS_NO_MEMORY;
+  }
+
+  if ( !esp32c3_spi_route_pins() ) {
+    spi_bus_destroy_and_free( &self->base );
+    return RTEMS_RESOURCE_IN_USE;
+  }
+
+  /* CS0 takes part, the other two do not.  The bits are "disable". */
+  SPI_REG( SPI_MISC ) = ~SPI_MISC_CS0_DIS & 0x7U;
+  SPI_REG( SPI_CLOCK ) = 0;
+  SPI_REG( SPI_CTRL ) = 0;
+
+  self->base.transfer = esp32c3_spi_transfer;
+  self->base.setup = esp32c3_spi_setup;
+  self->base.destroy = esp32c3_spi_destroy;
+  self->base.bits_per_word = 8;
+  self->base.speed_hz = 1000000;
+
+  rv = spi_bus_register( &self->base, bus_path );
+
+  if ( rv != 0 ) {
+    return RTEMS_UNSATISFIED;
+  }
+
+  esp32c3_spi_registered = true;
+
+  return RTEMS_SUCCESSFUL;
+}
