+/* These parts have a CLIC, with 16 internal and 32 external interrupt IDs. */
+#if defined(LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H)
+#define BSP_CLIC_BASE 0x20800000U
+#define DR_REG_INTMTX_CORE1_BASE 0x500d6800U
+#define INTERRUPT_CORE0_INTR_STATUS_0_REG 0x200
+#define INTERRUPT_CORE0_INTR_STATUS_1_REG 0x204
+#define INTERRUPT_CORE0_INTR_STATUS_2_REG 0x208
+#define INTERRUPT_CORE0_INTR_STATUS_3_REG 0x20c
+#define INTERRUPT_CORE0_INTR_STATUS_4_REG 0x220
+#elif defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H)
+#define BSP_CLIC_BASE 0x10800000U
+#define DR_REG_INTMTX_CORE1_BASE 0x20585800U
+#define INTERRUPT_CORE0_INTR_STATUS_0_REG 0x2a8
+#define INTERRUPT_CORE0_INTR_STATUS_1_REG 0x2ac
+#define INTERRUPT_CORE0_INTR_STATUS_2_REG 0x2b0
+#define INTERRUPT_CORE0_INTR_STATUS_3_REG 0x2b4
+#define INTERRUPT_CORE0_INTR_STATUS_4_REG 0x2b8
+#define INTERRUPT_CORE0_INTR_STATUS_5_REG 0x2bc
+#else
+#define BSP_CLIC_BASE 0x20800000U
+#define INTERRUPT_CORE0_INTR_STATUS_0_REG 0x150
+#define INTERRUPT_CORE0_INTR_STATUS_1_REG 0x154
+#define INTERRUPT_CORE0_INTR_STATUS_2_REG 0x158
+#endif
+#define INTPRI_REG( reg ) *( (volatile uint32_t *) ( INTPRI_BASE + ( reg ) ) )
+#define CLIC_EXTERNAL_INTERRUPT_OFFSET 16U
+#define CLIC_REG( offset ) \
+  *( (volatile uint32_t *) ( BSP_CLIC_BASE + ( offset ) ) )
+#define CLIC_INTERRUPT_REG( cpu_int ) \
+  CLIC_REG( 0x1000U + ( ( cpu_int ) + CLIC_EXTERNAL_INTERRUPT_OFFSET ) * 4U )
+
+static inline void esp32_cpu_int_enable_all( void )
+{
+  uintptr_t mtvec;
+
+  /* Three level bits; machine-mode, level-triggered, non-vectored sources. */
+#if BSP_ESP32P4_REVISION == 1
+  CLIC_REG( 0x00 ) = 3U << 1;
+#else
+  CLIC_REG( 0x00 ) = 3U;
+#endif
+  for ( uint32_t id = 0; id < 48U; ++id ) {
+    CLIC_REG( 0x1000U + id * 4U ) = 0x1fc00000U;
+  }
+  for ( uint32_t channel = 0; channel < 32U; ++channel ) {
+    CLIC_INTERRUPT_REG( channel ) = 0x3fc00100U;
+  }
+
+  /* Non-vectored CLIC interrupts enter RTEMS' existing common trap handler. */
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+    "csrr %0, mtvec\n"
+    ".option pop\n" : "=r" ( mtvec )
+  );
+  mtvec = ( mtvec & ~(uintptr_t) 3U ) | 3U;
+#if BSP_ESP32P4_REVISION == 1
+  /* Legacy CLIC threshold takes effect after a subsequent memory load. */
+  CLIC_REG( 0x08 ) = 0;
+  (void) CLIC_REG( 0x08 );
+#endif
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+#if BSP_ESP32P4_REVISION != 1
+    "csrw 0x347, zero\n"
+#endif
+    "csrw mtvec, %0\n"
+    ".option pop\n" : : "r" ( mtvec ) : "memory"
+  );
+}
+
+static inline void esp32_cpu_int_type_level( void )
+{
+  /* Configured together with each CLIC source above. */
+}
+
+static inline void esp32_cpu_int_clear( uint8_t cpu_vector )
+{
+  /* Level interrupts deassert when the peripheral handler clears its source. */
+  (void) cpu_vector;
+}
+
+static inline void esp32_cpu_int_set_prio( uint8_t cpu_int, uint32_t prio )
+{
+  uint32_t reg = CLIC_INTERRUPT_REG( cpu_int );
+
+  CLIC_INTERRUPT_REG( cpu_int ) =
+    ( reg & 0x00ffffffU ) | ( ( ( prio << 5 ) | 0x1fU ) << 24 );
+}
