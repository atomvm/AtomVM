+ * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS
+ * OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
+ * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
+ * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ */
+
+#include <bsp/bootcard.h>
+#include <bsp/irq.h>
+
+#include <rtems/score/percpu.h>
+#include <rtems/score/riscv-utility.h>
+#include <rtems/score/smpimpl.h>
+
+#if defined(RTEMS_SMP) && defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H)
+
+#define WRITE_PERI_REG( addr, val ) \
+  ( *( (volatile uint32_t *) (uintptr_t) ( addr ) ) = (uint32_t) ( val ) )
+#define READ_PERI_REG( addr ) \
+  ( *( (volatile uint32_t *) (uintptr_t) ( addr ) ) )
+
+#define LP_ROM_BOOT_ADDR_CORE1   0x20700164U
+#define HP_SYS_CLKRST_BASE       0x20587000U
+#define HP_SYS_CORE1_CLKRST_REG  ( HP_SYS_CLKRST_BASE + 0x20U )
+#define HP_SYS_CORE1_CLIC_CLK_EN ( 1U << 0 )
+#define HP_SYS_CORE1_CPU_CLK_EN  ( 1U << 1 )
+#define HP_SYS_CORE1_RST_EN_BIT  ( 1U << 2 )
+
+#define HP_SYSTEM_CPU_INT_FROM_CPU_0_REG 0x20586010U
+#define HP_SYSTEM_CPU_INT_FROM_CPU_1_REG 0x20586014U
+#define HP_SYSTEM_CPU_CORESTALLED_ST_REG 0x20586064U
+#define PMU_CPU_STALL_SW_REG             0x207041ecU
+
+#define DR_REG_INTMTX_CORE1_BASE 0x20585800U
+#define CORE1_MATRIX_REG( reg ) \
+  ( *( (volatile uint32_t *) ( DR_REG_INTMTX_CORE1_BASE + ( reg ) ) ) )
+#define CLIC_BASE_CORE1          0x10800000U
+#define CLIC_REG_CORE1( offset ) \
+  ( *( (volatile uint32_t *) ( CLIC_BASE_CORE1 + ( offset ) ) ) )
+#define CLIC_INT_REG_CORE1( chan ) \
+  ( *( (volatile uint32_t *) ( CLIC_BASE_CORE1 + 0x1000U + ( ( chan ) + 16U ) * 4U ) ) )
+
+extern void _start( void );
+
+typedef void (*ets_set_appcpu_boot_addr_t)(uint32_t start);
+
+uint32_t _CPU_SMP_Initialize( void )
+{
+  return rtems_configuration_get_maximum_processors() > 1 ? 2 : 1;
+}
+
+bool _CPU_SMP_Start_processor( uint32_t cpu_index )
+{
+  if ( cpu_index != 1 ) {
+    return false;
+  }
+
+  /* Unstall Core 1 */
+  uint32_t stall_reg = READ_PERI_REG( PMU_CPU_STALL_SW_REG );
+  stall_reg = ( stall_reg & ~0x00FF0000U ) | ( 0xFFU << 16 );
+  WRITE_PERI_REG( PMU_CPU_STALL_SW_REG, stall_reg );
+  for ( volatile uint32_t delay = 0; delay < 1000u; delay++ ) {
+    if ( ( READ_PERI_REG( HP_SYSTEM_CPU_CORESTALLED_ST_REG ) & ( 1U << 1 ) ) == 0U ) {
+      break;
+    }
+  }
+
+  /* Program Core 1 entry address via ROM function and register */
+  ( (ets_set_appcpu_boot_addr_t) 0x2f8000a8U )( (uint32_t) (uintptr_t) _start );
+  WRITE_PERI_REG( LP_ROM_BOOT_ADDR_CORE1, (uint32_t) (uintptr_t) _start );
+
+  /* Release Core 1 from reset and enable CPU + CLIC clocks */
+  uint32_t reg = READ_PERI_REG( HP_SYS_CORE1_CLKRST_REG );
+  reg |= ( HP_SYS_CORE1_CPU_CLK_EN | HP_SYS_CORE1_CLIC_CLK_EN );
+  reg &= ~HP_SYS_CORE1_RST_EN_BIT;
+  WRITE_PERI_REG( HP_SYS_CORE1_CLKRST_REG, reg );
+
+  return true;
+}
+
+void _CPU_SMP_Finalize_initialization( uint32_t cpu_count )
+{
+  (void) cpu_count;
+  /* Route SW_INTR_0 (source 65) on Core 0 to CPU channel 1 (CLIC interrupt ID 17 = 1 + 16) */
+  *( (volatile uint32_t *) ( 0x20585000U + 65U * 4U ) ) = 1U + 16U;
+  set_csr( mie, MIP_MEIP );
+}
+
+void _CPU_SMP_Prepare_start_multitasking( void )
+{
+}
+
+void _CPU_SMP_Send_interrupt( uint32_t target_processor_index )
+{
+  if ( target_processor_index == 0 ) {
+    WRITE_PERI_REG( HP_SYSTEM_CPU_INT_FROM_CPU_0_REG, 1U );
+  } else if ( target_processor_index == 1 ) {
+    WRITE_PERI_REG( HP_SYSTEM_CPU_INT_FROM_CPU_1_REG, 1U );
+  }
+}
+
+void bsp_start_on_secondary_processor( Per_CPU_Control *cpu_self )
+{
+  uint32_t cpu_index_self = _Per_CPU_Get_index( cpu_self );
+
+  if ( _SMP_Should_start_processor( cpu_index_self ) ) {
+    /* Core 1 CLIC initialization */
+    CLIC_REG_CORE1( 0x00 ) = 3U;
+    for ( uint32_t id = 0; id < 48U; ++id ) {
+      CLIC_REG_CORE1( 0x1000U + id * 4U ) = 0x1fc00000U;
+    }
+    for ( uint32_t channel = 0; channel < 32U; ++channel ) {
+      CLIC_INT_REG_CORE1( channel ) = 0x3fc00100U;
+    }
+
+    uintptr_t mtvec;
+    __asm__ volatile (
+      ".option push\n"
+      ".option arch, +zicsr\n"
+      "csrr %0, mtvec\n"
+      ".option pop\n" : "=r" ( mtvec )
+    );
+    mtvec = ( mtvec & ~(uintptr_t) 3U ) | 3U;
+    __asm__ volatile (
+      ".option push\n"
+      ".option arch, +zicsr\n"
+      "csrw 0x347, zero\n"
+      "csrw mtvec, %0\n"
+      ".option pop\n" : : "r" ( mtvec ) : "memory"
+    );
+
+    /* Route SW_INTR_1 (source 66) on Core 1 to CPU channel 1 (CLIC interrupt ID 17 = 1 + 16) */
+    CORE1_MATRIX_REG( 66U * 4U ) = 1U + 16U;
+
+    set_csr( mie, MIP_MEIP );
+
+    _SMP_Start_multitasking_on_secondary_processor( cpu_self );
+  } else {
+    _CPU_Thread_Idle_body( 0 );
+  }
+}
+
+
+#endif /* RTEMS_SMP && LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H */
