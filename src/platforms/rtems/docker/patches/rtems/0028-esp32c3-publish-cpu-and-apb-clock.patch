Subject: [PATCH] bsps/riscv/esp32c3: select PLL mux and publish APB clock

Clear both source-select bits when selecting PLL160, and store the 80 MHz
APB frequency in the RTC scratch register as ESP-IDF does for ROM clients.

--- a/bsps/riscv/esp32/start/bspstart.c
+++ b/bsps/riscv/esp32/start/bspstart.c
@@ -249,8 +249,14 @@
   WRITE_REG(
     CLK_SYSTEM_BASE,
     CLK_SYSCLK_CONF_REG,
-    ( reg & ~0x3FFu ) | ( 1u << 10 )
-  );
+    ( reg & ~0xFFFu ) | ( 1u << 10 )
+  );
+
+  /* ESP-IDF rtc_clk_cpu_freq_to_pll_mhz(): ROM clients read APB frequency
+   * from two copies of (frequency in Hz >> 12) in RTC_CNTL_STORE5.
+   */
+  uint32_t apb = 80000000u >> 12;
+  WRITE_REG( (uintptr_t) 0x60008000, 0xbc, apb | ( apb << 16 ) );
 
 #elif defined( LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H )
 
