+#include <bsp.h>
+#include <bsp/irq.h>
+#include <bsp/pin.h>
+#include <dev/gpio/gpio.h>
+#include <rtems/irq-extension.h>
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#define GPIO_REG( off ) \
+  ( *( (volatile uint32_t *) ( GPIO_BASE + (off) ) ) )
+#define IO_MUX_REG( off ) \
+  ( *( (volatile uint32_t *) ( IO_MUX_BASE + (off) ) ) )
+
+/* Keep physical numbering and the existing low 32-bit bank implementation.
+ * The P4 and S31 high banks are not implemented by this controller. */
+#define ESP32_GPIO_PIN_COUNT ( BSP_GPIO_PIN_COUNT < 32 ? BSP_GPIO_PIN_COUNT : 32 )
+
+#define GPIO_OUT          0x0004
+#define GPIO_OUT_W1TS     0x0008
+#define GPIO_OUT_W1TC     0x000c
+#if defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H)
+#define GPIO_ENABLE_W1TS  0x0038
+#define GPIO_ENABLE_W1TC  0x003c
+#define GPIO_IN           0x0064
+#define GPIO_STATUS       0x0074
+#define GPIO_STATUS_W1TC  0x007c
+#define GPIO_PIN( n )     ( 0x00f4 + 4 * (n) )
+#define GPIO_FUNC_OUT_SEL_CFG( n ) ( 0x0af4 + 4 * (n) )
+#elif defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+#define GPIO_ENABLE_W1TS  0x0038
+#define GPIO_ENABLE_W1TC  0x003c
+#define GPIO_IN           0x0064
+#define GPIO_STATUS       0x0074
+#define GPIO_STATUS_W1TC  0x007c
+#define GPIO_PIN( n )     ( 0x00d4 + 4 * (n) )
+#define GPIO_FUNC_OUT_SEL_CFG( n ) ( 0x0ad4 + 4 * (n) )
+#else
+#define GPIO_ENABLE_W1TS  0x0024
+#define GPIO_ENABLE_W1TC  0x0028
+#define GPIO_IN           0x003c
+#define GPIO_STATUS       0x0044
+#define GPIO_STATUS_W1TC  0x004c
+#define GPIO_PIN( n )     ( 0x0074 + 4 * (n) )
+#if defined(LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H)
+#define GPIO_FUNC_OUT_SEL_CFG( n ) ( 0x0558 + 4 * (n) )
+#else
+#define GPIO_FUNC_OUT_SEL_CFG( n ) ( 0x0554 + 4 * (n) )
+#endif
+#endif
+
+#define GPIO_PIN_PAD_DRIVER     ( 1U << 2 )
+#define GPIO_PIN_INT_TYPE_SHIFT 7
+#define GPIO_PIN_INT_TYPE_MASK  ( 0x7U << GPIO_PIN_INT_TYPE_SHIFT )
+#define GPIO_PIN_INT_ENA_MASK   ( 0x1fU << 13 )
+#define GPIO_PIN_INT_ENA_CPU    ( 0x1U << 13 )
+
+/* C5 and S31 start pad zero at offset zero, unlike the older layouts. */
+#if defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+#define IO_MUX_PIN( n )   ( 4 * (n) )
+#else
+#define IO_MUX_PIN( n )   ( 0x0004 + 4 * (n) )
+#endif
+#define IO_MUX_FUN_PD     ( 1U << 7 )
+#define IO_MUX_FUN_PU     ( 1U << 8 )
+#define IO_MUX_FUN_IE     ( 1U << 9 )
+#define IO_MUX_MCU_SEL_SHIFT 12
+#define IO_MUX_MCU_SEL_MASK  ( 0x7U << IO_MUX_MCU_SEL_SHIFT )
+#define IO_MUX_FUNC_GPIO  1
+#if defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+#define SIG_GPIO_OUT_IDX  256
+#else
+#define SIG_GPIO_OUT_IDX  128
+#endif
+
+static const char esp32_gpio_owner[] = "esp32 gpio";
+static rtems_gpio_config esp32_gpio_config[ ESP32_GPIO_PIN_COUNT ];
+static rtems_gpio_irq_handler esp32_gpio_handler[ ESP32_GPIO_PIN_COUNT ];
+static void *esp32_gpio_arg[ ESP32_GPIO_PIN_COUNT ];
+static uint32_t esp32_gpio_active_low[ 1 ];
+static uint32_t esp32_gpio_scratch[ 1 ];
+
+/*
+ * The generic mutex serializes task operations, not the ISR.  Hold this
+ * interrupt lock THROUGH each callback, including on SMP: disable/release
+ * then wait for an already-running callback and cannot return with an old
+ * callback still using its argument.  Callbacks must be short, interrupt-safe
+ * and must not call this controller, nor take locks held by its callers.
+ */
+RTEMS_INTERRUPT_LOCK_DEFINE( static, esp32_gpio_irq_lock, "ESP32 GPIO IRQ" )
+
+static bool esp32_gpio_owned( uint32_t pin )
+{
+  return bsp_pin_owner( pin ) == esp32_gpio_owner &&
+    esp32_gpio_config[ pin ].direction != RTEMS_GPIO_DIRECTION_NONE;
+}
+
+/* ROM flash pads (including VDD_SPI) and the selected console are not
+ * GPIO resources.  These checks do not claim/release other drivers' pads.
+ * Console pads above the low bank are already outside this controller. */
+static const char *esp32_gpio_reserved( uint32_t pin )
+{
+#if defined(LIBBSP_ESP32_C3_CHIP_DEFINITIONS_H)
+  if ( pin >= 12 && pin <= 17 ) { return "flash"; }
+#ifdef ESPRESSIF_USE_USB_CONSOLE
+  if ( pin == 18 || pin == 19 ) { return "USB console"; }
+#else
+  if ( pin == 20 || pin == 21 ) { return "UART0 console"; }
+#endif
+#elif defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+  if ( pin >= 16 && pin <= 22 ) { return "flash"; }
+#ifdef ESPRESSIF_USE_USB_CONSOLE
+  if ( pin == 13 || pin == 14 ) { return "USB console"; }
+#else
+  if ( pin == 11 || pin == 12 ) { return "UART0 console"; }
+#endif
+#elif defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
+  if ( pin >= 24 && pin <= 30 ) { return "flash"; }
+#ifdef ESPRESSIF_USE_USB_CONSOLE
+  if ( pin == 12 || pin == 13 ) { return "USB console"; }
+#else
+  if ( pin == 16 || pin == 17 ) { return "UART0 console"; }
+#endif
+#elif defined(LIBBSP_ESP32_H2_CHIP_DEFINITIONS_H)
+  if ( pin >= 15 && pin <= 21 ) { return "flash"; }
+#ifdef ESPRESSIF_USE_USB_CONSOLE
+  if ( pin == 26 || pin == 27 ) { return "USB console"; }
+#else
+  if ( pin == 23 || pin == 24 ) { return "UART0 console"; }
+#endif
+#elif defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H)
+  if ( pin >= 26 ) { return "flash"; }
+#elif defined(LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H)
+#ifdef ESPRESSIF_USE_USB_CONSOLE
+  if ( pin == 24 || pin == 25 ) { return "USB console"; }
+#endif
+#endif
+  (void) pin;
+  return NULL;
+}
+
+static int esp32_gpio_get_info(
+  RTEMS_UNUSED rtems_gpio_drv_ctrl *ctrl,
+  uint32_t pin,
+  rtems_gpio_pin_info *info
+)
+{
+  const char *owner = bsp_pin_owner( pin );
+  const char *reserved = esp32_gpio_reserved( pin );
+
+  info->kind = RTEMS_GPIO_PIN_PHYSICAL;
+  info->capabilities = RTEMS_GPIO_CAP_INPUT | RTEMS_GPIO_CAP_OUTPUT |
+    RTEMS_GPIO_CAP_OUTPUT_READBACK | RTEMS_GPIO_CAP_PULL_UP |
+    RTEMS_GPIO_CAP_PULL_DOWN | RTEMS_GPIO_CAP_OPEN_DRAIN |
+    RTEMS_GPIO_CAP_EDGE_RISING | RTEMS_GPIO_CAP_EDGE_FALLING |
+    RTEMS_GPIO_CAP_EDGE_BOTH | RTEMS_GPIO_CAP_LEVEL_HIGH |
+    RTEMS_GPIO_CAP_LEVEL_LOW;
+  snprintf( info->name, sizeof( info->name ), "GPIO%lu", (unsigned long) pin );
+
+  /* IN_USE authorizes generic get/set/release, so it MUST NOT describe
+   * another peripheral's claim.  RESERVED protects it from configuration;
+   * the claim itself is checked again atomically before touching hardware. */
+  if ( reserved != NULL ) {
+    info->flags = RTEMS_GPIO_PIN_RESERVED;
+    snprintf( info->owner, sizeof( info->owner ), "%s", reserved );
+  } else if ( owner != NULL ) {
+    info->flags = esp32_gpio_owned( pin ) ?
+      RTEMS_GPIO_PIN_IN_USE : RTEMS_GPIO_PIN_RESERVED;
+    snprintf( info->owner, sizeof( info->owner ), "%s", owner );
+  }
+  return 0;
+}
+
+static uint32_t esp32_gpio_irq_type( rtems_gpio_trigger trigger )
+{
+  switch ( trigger ) {
+    case RTEMS_GPIO_TRIGGER_EDGE_RISING: return 1;
+    case RTEMS_GPIO_TRIGGER_EDGE_FALLING: return 2;
+    case RTEMS_GPIO_TRIGGER_EDGE_BOTH: return 3;
+    case RTEMS_GPIO_TRIGGER_LEVEL_LOW: return 4;
+    case RTEMS_GPIO_TRIGGER_LEVEL_HIGH: return 5;
+    default: return 0;
+  }
+}
+
+/* Caller holds esp32_gpio_irq_lock. Disable the type before acknowledging
+ * a level interrupt, otherwise the asserted level immediately relatches it. */
+static void esp32_gpio_irq_clear( uint32_t pin )
+{
+  GPIO_REG( GPIO_PIN( pin ) ) &=
+    ~( GPIO_PIN_INT_TYPE_MASK | GPIO_PIN_INT_ENA_MASK );
+  GPIO_REG( GPIO_STATUS_W1TC ) = 1U << pin;
+  esp32_gpio_handler[ pin ] = NULL;
+  esp32_gpio_arg[ pin ] = NULL;
+}
+
+static int esp32_gpio_set(
+  RTEMS_UNUSED rtems_gpio_drv_ctrl *ctrl,
+  uint32_t pin,
+  int value
+)
+{
+  if ( !esp32_gpio_owned( pin ) ) {
+    return EBADF;
+  }
+  /* Writing an input intentionally preloads the output latch. */
+  GPIO_REG( value != 0 ? GPIO_OUT_W1TS : GPIO_OUT_W1TC ) = 1U << pin;
+  return 0;
+}
+
+static int esp32_gpio_configure(
+  RTEMS_UNUSED rtems_gpio_drv_ctrl *ctrl,
+  uint32_t pin,
+  rtems_gpio_config *config
+)
+{
+  uint32_t mux;
+  uint32_t reg;
+  rtems_interrupt_lock_context lock_context;
+
+  if ( esp32_gpio_reserved( pin ) != NULL ) {
+    return EACCES;
+  }
+  if ( config->direction != RTEMS_GPIO_DIRECTION_INPUT &&
+       config->direction != RTEMS_GPIO_DIRECTION_OUTPUT ) {
+    return EINVAL;
+  }
+  if ( (unsigned) config->bias > RTEMS_GPIO_BIAS_PULL_DOWN ||
+       (unsigned) config->trigger > RTEMS_GPIO_TRIGGER_LEVEL_LOW ||
+       ( config->flags & ~RTEMS_GPIO_FLAG_ACTIVE_LOW ) != 0 ||
+       config->drive_strength != 0 || config->debounce != 0 ||
+       ( config->direction == RTEMS_GPIO_DIRECTION_OUTPUT &&
+         config->drive != RTEMS_GPIO_DRIVE_PUSH_PULL &&
+         config->drive != RTEMS_GPIO_DRIVE_OPEN_DRAIN ) ) {
+    return ENOTSUP;
+  }
+  if ( !bsp_pin_claim( pin, esp32_gpio_owner ) ) {
+    return EBUSY;
+  }
+
+  rtems_interrupt_lock_acquire( &esp32_gpio_irq_lock, &lock_context );
+  esp32_gpio_irq_clear( pin );
+  GPIO_REG( GPIO_ENABLE_W1TC ) = 1U << pin;
+  GPIO_REG( config->initial_value != 0 ? GPIO_OUT_W1TS : GPIO_OUT_W1TC ) =
+    1U << pin;
+
+  mux = IO_MUX_REG( IO_MUX_PIN( pin ) );
+  mux &= ~( IO_MUX_MCU_SEL_MASK | IO_MUX_FUN_PU | IO_MUX_FUN_PD );
+  /* Input readback remains enabled even for an output. */
+  mux |= ( IO_MUX_FUNC_GPIO << IO_MUX_MCU_SEL_SHIFT ) | IO_MUX_FUN_IE;
+  if ( config->bias == RTEMS_GPIO_BIAS_PULL_UP ) {
+    mux |= IO_MUX_FUN_PU;
+  } else if ( config->bias == RTEMS_GPIO_BIAS_PULL_DOWN ) {
+    mux |= IO_MUX_FUN_PD;
+  }
+  IO_MUX_REG( IO_MUX_PIN( pin ) ) = mux;
+  GPIO_REG( GPIO_FUNC_OUT_SEL_CFG( pin ) ) = SIG_GPIO_OUT_IDX;
+  reg = GPIO_REG( GPIO_PIN( pin ) ) & ~GPIO_PIN_PAD_DRIVER;
+  if ( config->direction == RTEMS_GPIO_DIRECTION_OUTPUT &&
+       config->drive == RTEMS_GPIO_DRIVE_OPEN_DRAIN ) {
+    reg |= GPIO_PIN_PAD_DRIVER;
+  }
+  GPIO_REG( GPIO_PIN( pin ) ) = reg;
+  if ( config->direction == RTEMS_GPIO_DIRECTION_INPUT ) {
+    config->drive = RTEMS_GPIO_DRIVE_PUSH_PULL;
+  } else {
+    GPIO_REG( GPIO_ENABLE_W1TS ) = 1U << pin;
+  }
+  esp32_gpio_config[ pin ] = *config;
+  rtems_interrupt_lock_release( &esp32_gpio_irq_lock, &lock_context );
+  return 0;
+}
+
+static int esp32_gpio_get_config(
+  RTEMS_UNUSED rtems_gpio_drv_ctrl *ctrl,
+  uint32_t pin,
+  rtems_gpio_config *config
+)
+{
+  if ( !esp32_gpio_owned( pin ) ) {
+    return EBADF;
+  }
+  *config = esp32_gpio_config[ pin ];
+  /* Report the CURRENT output latch, not the sampled pad or initial value.
+   * This also preserves input preloads over release/configure cycles. */
+  config->initial_value = ( GPIO_REG( GPIO_OUT ) & ( 1U << pin ) ) != 0;
+  return 0;
+}
+
+static int esp32_gpio_irq_disable(
+  RTEMS_UNUSED rtems_gpio_drv_ctrl *ctrl,
+  uint32_t pin
+)
+{
+  rtems_interrupt_lock_context lock_context;
+
+  if ( !esp32_gpio_owned( pin ) ) {
+    return EBADF;
+  }
+  rtems_interrupt_lock_acquire( &esp32_gpio_irq_lock, &lock_context );
+  esp32_gpio_irq_clear( pin );
+  rtems_interrupt_lock_release( &esp32_gpio_irq_lock, &lock_context );
+  return 0;
+}
+
+static int esp32_gpio_release( rtems_gpio_drv_ctrl *ctrl, uint32_t pin )
+{
+  int err = esp32_gpio_irq_disable( ctrl, pin );
+
+  if ( err != 0 ) {
+    return err;
+  }
+  GPIO_REG( GPIO_ENABLE_W1TC ) = 1U << pin;
+  GPIO_REG( GPIO_OUT_W1TC ) = 1U << pin;
+  GPIO_REG( GPIO_PIN( pin ) ) &= ~GPIO_PIN_PAD_DRIVER;
+  GPIO_REG( GPIO_FUNC_OUT_SEL_CFG( pin ) ) = SIG_GPIO_OUT_IDX;
+  IO_MUX_REG( IO_MUX_PIN( pin ) ) =
+    ( IO_MUX_REG( IO_MUX_PIN( pin ) ) &
+      ~( IO_MUX_MCU_SEL_MASK | IO_MUX_FUN_IE | IO_MUX_FUN_PU | IO_MUX_FUN_PD ) ) |
+    ( IO_MUX_FUNC_GPIO << IO_MUX_MCU_SEL_SHIFT );
+  memset( &esp32_gpio_config[ pin ], 0, sizeof( esp32_gpio_config[ pin ] ) );
+  /* Last: no peripheral can claim the pin while it is being reset. */
+  bsp_pin_release( pin );
+  return 0;
+}
+
+static int esp32_gpio_get(
+  RTEMS_UNUSED rtems_gpio_drv_ctrl *ctrl,
+  uint32_t pin,
+  int *value
+)
+{
+  if ( !esp32_gpio_owned( pin ) ) {
+    return EBADF;
+  }
+  *value = ( GPIO_REG( GPIO_IN ) & ( 1U << pin ) ) != 0;
+  return 0;
+}
+
+static int esp32_gpio_irq_enable(
+  RTEMS_UNUSED rtems_gpio_drv_ctrl *ctrl,
+  uint32_t pin,
+  rtems_gpio_irq_flags flags,
+  rtems_gpio_irq_handler handler,
+  void *arg
+)
+{
+  rtems_interrupt_lock_context lock_context;
+  uint32_t type = esp32_gpio_irq_type( esp32_gpio_config[ pin ].trigger );
+
+  if ( !esp32_gpio_owned( pin ) ) {
+    return EBADF;
+  }
+  if ( flags != RTEMS_GPIO_IRQ_DEFAULT ) {
+    return ENOTSUP;
+  }
+  if ( handler == NULL || type == 0 ) {
+    return EINVAL;
+  }
+  rtems_interrupt_lock_acquire( &esp32_gpio_irq_lock, &lock_context );
+  esp32_gpio_irq_clear( pin );
+  esp32_gpio_handler[ pin ] = handler;
+  esp32_gpio_arg[ pin ] = arg;
+  GPIO_REG( GPIO_PIN( pin ) ) |=
+    ( type << GPIO_PIN_INT_TYPE_SHIFT ) | GPIO_PIN_INT_ENA_CPU;
+  rtems_interrupt_lock_release( &esp32_gpio_irq_lock, &lock_context );
+  return 0;
+}
+
+static void esp32_gpio_interrupt( RTEMS_UNUSED void *arg )
+{
+  rtems_interrupt_lock_context lock_context;
+  uint32_t pending;
+  uint32_t pin;
+
+  rtems_interrupt_lock_acquire( &esp32_gpio_irq_lock, &lock_context );
+  pending = GPIO_REG( GPIO_STATUS );
+  for ( pin = 0; pin < ESP32_GPIO_PIN_COUNT; ++pin ) {
+    uint32_t bit = 1U << pin;
+
+    if ( ( pending & bit ) != 0 && esp32_gpio_handler[ pin ] != NULL ) {
+      /* Acknowledge only this controller's enabled pins. A level still
+       * asserted after the callback will raise another interrupt. */
+      GPIO_REG( GPIO_STATUS_W1TC ) = bit;
+      ( *esp32_gpio_handler[ pin ] )( pin, esp32_gpio_arg[ pin ] );
+    }
+  }
+  rtems_interrupt_lock_release( &esp32_gpio_irq_lock, &lock_context );
+}
+
+static const rtems_gpio_drv_handlers esp32_gpio_handlers = {
+  .pin_get_info = esp32_gpio_get_info,
+  .pin_configure = esp32_gpio_configure,
+  .pin_get_config = esp32_gpio_get_config,
+  .pin_release = esp32_gpio_release,
+  .pin_get = esp32_gpio_get,
+  .pin_set = esp32_gpio_set,
+  .pin_irq_enable = esp32_gpio_irq_enable,
+  .pin_irq_disable = esp32_gpio_irq_disable
+};
+
+static rtems_gpio_drv_ctrl esp32_gpio_ctrl = {
+  .handlers = &esp32_gpio_handlers,
+  .pin_count = ESP32_GPIO_PIN_COUNT,
+  .name = "ESP32 GPIO",
+  .can_block = false,
+  .active_low = esp32_gpio_active_low,
+  .scratch = esp32_gpio_scratch
+};
+
+/* Referenced by the bspstart sysinit item so archive linking retains this
+ * controller even when applications only use open/ioctl. No application API. */
+void esp32_gpio_initialize( void );
+
+void esp32_gpio_initialize( void )
+{
+  rtems_status_code sc;
+
+  if ( rtems_gpio_drv_ctrl_init( &esp32_gpio_ctrl ) != 0 ) {
+    rtems_panic( "ESP32 GPIO: controller initialization failed" );
+  }
+  sc = rtems_interrupt_handler_install(
+    GPIO_PROCPU_INTR, "GPIO", RTEMS_INTERRUPT_UNIQUE,
+    esp32_gpio_interrupt, NULL
+  );
+  if ( sc != RTEMS_SUCCESSFUL ) {
+    rtems_panic( "ESP32 GPIO: interrupt installation failed" );
+  }
+  if ( rtems_gpio_drv_ctrl_register( &esp32_gpio_ctrl, "/dev/gpio" ) != 0 ) {
+    rtems_panic( "ESP32 GPIO: device registration failed" );
+  }
+}
