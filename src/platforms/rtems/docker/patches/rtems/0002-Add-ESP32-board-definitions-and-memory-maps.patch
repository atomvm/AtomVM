+#define UART0_BASE           ( (uintptr_t) 0x2038A000U )
+#define UART1_BASE           ( (uintptr_t) 0x2038B000U )
+#define SYSTIMER_BASE        ( (uintptr_t) 0x20399000U )
+#define USB_SERIAL_JTAG_BASE ( (uintptr_t) 0x20391000U )
+#define SPI2_BASE            ( (uintptr_t) 0x2038F000U )
+#define TIMG_BASE            ( (uintptr_t) 0x20580000U )
+#define INT_MATRIX_BASE      ( (uintptr_t) 0x20585000U )
+#define SYSREG_BASE          ( (uintptr_t) 0x20586000U )
+#define PCR_BASE             ( (uintptr_t) 0x20587000U )
+
+/*
+ * Low-power watchdog (a.k.a. RTC watchdog).  Register layout matches the other
+ * ESP32 parts: CONFIG0 at 0x0, WPROTECT at 0x18, SWD_CONFIG at 0x1c and
+ * SWD_WPROTECT at 0x20.
