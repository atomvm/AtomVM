diff --git a/spec/build/bsps/riscv/esp32/optdramromreserve.yml b/spec/build/bsps/riscv/esp32/optdramromreserve.yml
new file mode 100644
index 0000000000000000000000000000000000000000..fd405594d3656490f79672a27b7421be29389019
--- /dev/null
+++ b/spec/build/bsps/riscv/esp32/optdramromreserve.yml
@@ -0,0 +1,51 @@
+SPDX-License-Identifier: CC-BY-SA-4.0 OR BSD-2-Clause
+actions:
+- get-integer: null
+- assert-uint32: null
+- env-assign: null
+- format-and-define: null
+build-type: option
+copyrights:
+- Copyright (C) 2026 Samuel Price <thesamprice@gmail.com>
+default:
+- enabled-by: riscv/esp32c3db
+  value: 0x18f0
+- enabled-by: riscv/esp32c5db
+  value: 0x16000
+- enabled-by: riscv/esp32c6db
+  value: 0x16000
+- enabled-by: riscv/esp32h2db
+  value: 0x12000
+- enabled-by:
+  - riscv/esp32p4db
+  - riscv/esp32p4v1db
+  - riscv/esp32s31db
+  value: 0x6000
+- enabled-by: true
+  value: 0x0
+description: |
+  How many bytes at the top of the internal SRAM belong to the ROM rather than
+  to the application, in bytes, aligned to 4.
+
+  C3 reserves 0x18f0 bytes, matching ESP-IDF. The Wi-Fi adapter's smaller
+  buffers and timer stack leave space for the radio without using ROM data.
+
+  The ESP32-C3's ROM keeps its own data in the SRAM, from 0x3fcce710 to the
+  end of the block at 0x3fcd0000.  That is where ESP-IDF stops: esp_system's
+  memory.ld computes dram0_0_seg's length from the same address, and the
+  C3 default here is 0x3fcd0000 - 0x3fcce710.
+
+  A BSP that ends its data region at 0x3fcd0000 instead does not gain 6384
+  bytes; it hands out 6384 bytes the ROM believes it owns, to whatever the
+  allocator places last.  Every image built for this part calls ROM code --
+  the ets_* entry points, the PHY routines, and the ROM halves of the WiFi
+  libraries -- so the overlap is not conditional on using a particular driver.
+
+  Lower it only for an image that calls no ROM code at all, and know that the
+  PHY and WiFi blobs do so from their own ROM address literals, not through
+  anything the link can be made to show.
+enabled-by: true
+format: '{:#010x}'
+links: []
+name: ESP32C_DRAM_ROM_RESERVE_SIZE
+type: build
