+#define LP_WDT_BASE          ( (uintptr_t) 0x20801000U )
+#define RTC_CNTL_BASE        ( (uintptr_t) 0x20804000U )
+#define LP_AON_BASE          ( (uintptr_t) 0x20804000U )
+
+/* CLIC base for this part (16 internal + 32 external interrupt IDs). */
+#define CLIC_BASE            ( (uintptr_t) 0x10800000U )
+
+/* ESP32-S31 ROM function addresses (the mask ROM __call trampolines). */
+#define UART_TX_ONE_CHAR_ADDR ( (void *) (uintptr_t) 0x2f800054 )
+#define UART_RX_ONE_CHAR_ADDR ( (void *) (uintptr_t) 0x2f800060 )
+#define UART_TX_FLUSH_ADDR    ( (void *) (uintptr_t) 0x2f800074 )
+
+#endif /* LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H */
