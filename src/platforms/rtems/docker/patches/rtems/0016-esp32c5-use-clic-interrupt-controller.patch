Subject: [PATCH] bsps/riscv: use the ESP32-C5 CLIC interrupt controller

C5 routes external channels to CLIC IDs 16..47. Configure the CLIC at
0x20800000, enter non-vectored CLIC mode, translate mcause IDs and use
the C5 interrupt-matrix status registers. C6 PLIC configuration leaves
SYSTIMER pending without delivering any RTEMS clock ticks on C5.

diff --git a/bsps/riscv/esp32/irq/irq_c3.c b/bsps/riscv/esp32/irq/irq_c3.c
--- a/bsps/riscv/esp32/irq/irq_c3.c
+++ b/bsps/riscv/esp32/irq/irq_c3.c
@@ -176,7 +176,72 @@
 
 #define MATRIX_REG( reg ) *( (volatile uint32_t *) ( INT_MATRIX_BASE + reg ) )
 
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+/* ESP32-C5 has a CLIC, with 16 internal and 32 external interrupt IDs. */
+#define INTERRUPT_CORE0_INTR_STATUS_0_REG 0x150
+#define INTERRUPT_CORE0_INTR_STATUS_1_REG 0x154
+#define INTERRUPT_CORE0_INTR_STATUS_2_REG 0x158
+#define INTPRI_REG( reg ) *( (volatile uint32_t *) ( INTPRI_BASE + ( reg ) ) )
+#define CLIC_EXTERNAL_INTERRUPT_OFFSET 16U
+#define CLIC_REG( offset ) \
+  *( (volatile uint32_t *) ( 0x20800000U + ( offset ) ) )
+#define CLIC_INTERRUPT_REG( cpu_int ) \
+  CLIC_REG( 0x1000U + ( ( cpu_int ) + CLIC_EXTERNAL_INTERRUPT_OFFSET ) * 4U )
+
+static inline void esp32_cpu_int_enable_all( void )
+{
+  uintptr_t mtvec;
+
+  /* Three level bits; machine-mode, level-triggered, non-vectored sources. */
+  CLIC_REG( 0x00 ) = 3U;
+  for ( uint32_t id = 0; id < 48U; ++id ) {
+    CLIC_REG( 0x1000U + id * 4U ) = 0x1fc00000U;
+  }
+  for ( uint32_t channel = 0; channel < 32U; ++channel ) {
+    CLIC_INTERRUPT_REG( channel ) = 0x3fc00100U;
+  }
+
+  /* Non-vectored CLIC interrupts enter RTEMS' existing common trap handler. */
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+    "csrr %0, mtvec\n"
+    ".option pop\n" : "=r" ( mtvec )
+  );
+  mtvec = ( mtvec & ~(uintptr_t) 3U ) | 3U;
+  __asm__ volatile (
+    ".option push\n"
+    ".option arch, +zicsr\n"
+    "csrw 0x347, zero\n"
+    "csrw mtvec, %0\n"
+    ".option pop\n" : : "r" ( mtvec ) : "memory"
+  );
+}
+
+static inline void esp32_cpu_int_type_level( void )
+{
+  /* Configured together with each CLIC source above. */
+}
+
+static inline void esp32_cpu_int_clear( uint8_t cpu_vector )
+{
+  /* Level interrupts deassert when the peripheral handler clears its source. */
+  (void) cpu_vector;
+}
+
+static inline void esp32_cpu_int_set_prio( uint8_t cpu_int, uint32_t prio )
+{
+  uint32_t reg = CLIC_INTERRUPT_REG( cpu_int );
+
+  CLIC_INTERRUPT_REG( cpu_int ) =
+    ( reg & 0x00ffffffU ) | ( ( ( prio << 5 ) | 0x1fU ) << 24 );
+}
+
+static inline uint32_t esp32_cpu_int_get_prio( uint8_t cpu_int )
+{
+  return CLIC_INTERRUPT_REG( cpu_int ) >> 29;
+}
+#elif defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
 /* ESP32-C6 Interrupt Matrix status registers */
 #define INTERRUPT_CORE0_INTR_STATUS_0_REG 0x134
 #define INTERRUPT_CORE0_INTR_STATUS_1_REG 0x138
@@ -339,7 +404,16 @@
   (void) cpu_self;
 
   rtems_vector_number active;
-  uint8_t             cpu_vector = mcause & 0x1f;
+#if defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+  uint32_t interrupt_id = mcause & 0xfffU;
+
+  if ( interrupt_id < CLIC_EXTERNAL_INTERRUPT_OFFSET || interrupt_id >= 48U ) {
+    return;
+  }
+  uint8_t cpu_vector = interrupt_id - CLIC_EXTERNAL_INTERRUPT_OFFSET;
+#else
+  uint8_t cpu_vector = mcause & 0x1f;
+#endif
 
   /*
    * All interrupts on the ESP32-C3 are external except for exceptions which
@@ -385,7 +459,11 @@
    * reserved one, and nothing here indexes channels by vector.
    */
   for ( uint8_t vec = 0; vec < RISCV_MAXIMUM_EXTERNAL_INTERRUPTS; vec++ ) {
+#if defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+    bsp_interrupt_set_priority( vec, 6 );
+#else
     bsp_interrupt_set_priority( vec, 14 );
+#endif
   }
 
   _RISCV_MMIO_store_release_fence();
@@ -424,7 +502,11 @@
   attributes->can_get_affinity = false;
   attributes->can_set_affinity = false;
   /* priorities range from 1 to 15, but this is expected to be 0-based */
+#if defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+  attributes->maximum_priority = 6;
+#else
   attributes->maximum_priority = 14;
+#endif
   attributes->can_get_priority = true;
   attributes->can_set_priority = true;
 
@@ -467,7 +549,13 @@
 {
   bsp_interrupt_assert( bsp_interrupt_is_valid_vector( vector ) );
 
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+  if ( vector >= SW_INTR_0 && vector <= SW_INTR_3 ) {
+    INTPRI_REG( 0x90U + ( vector - SW_INTR_0 ) * 4U ) = 1U;
+    return RTEMS_SUCCESSFUL;
+  }
+  return RTEMS_UNSATISFIED;
+#elif defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
   switch ( vector ) {
     case SW_INTR_0:
       INTPRI_REG( 0x90 ) = 1;
@@ -520,7 +608,11 @@
   esp32_cpu_int_clear( cpu_int );
 
   /* If this is a software interrupt, clear it. */
-#if defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+#if defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+  if ( vector >= SW_INTR_0 && vector <= SW_INTR_3 ) {
+    INTPRI_REG( 0x90U + ( vector - SW_INTR_0 ) * 4U ) = 0U;
+  }
+#elif defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H)
   switch ( vector ) {
     case SW_INTR_0:
       INTPRI_REG( 0x90 ) = 0;
@@ -591,7 +683,11 @@
        */
       MATRIX_REG(
         periph_int_to_map_reg( vector )
+#if defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+      ) = irq_mappings[ i ].cpu_int + CLIC_EXTERNAL_INTERRUPT_OFFSET;
+#else
       ) = irq_mappings[ i ].cpu_int;
+#endif
       return RTEMS_SUCCESSFUL;
     }
   }
@@ -615,6 +711,11 @@
 {
   uint8_t cpu_int;
 
+#if defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
+  if ( priority > 6U ) {
+    return RTEMS_INVALID_PRIORITY;
+  }
+#endif
   /* adjust priority to the range the matrix uses */
   priority += 1;
 
