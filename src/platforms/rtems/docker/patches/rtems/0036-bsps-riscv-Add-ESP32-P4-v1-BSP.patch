 spec/build/bsps/riscv/optespressifdirectboot.yml   |  1 +
 spec/build/cpukit/optsmp.yml                       |  1 +
 20 files changed, 162 insertions(+), 12 deletions(-)
diff --git a/bsps/riscv/esp32/include/p4/chip_definitions.h b/bsps/riscv/esp32/include/p4/chip_definitions.h
index 789ca3fabf..bc16dd25cf 100644
--- a/bsps/riscv/esp32/include/p4/chip_definitions.h
+++ b/bsps/riscv/esp32/include/p4/chip_definitions.h
@@ -36,6 +36,10 @@
 #ifndef LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H
 #define LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H
 
+#ifndef BSP_ESP32P4_REVISION
+#define BSP_ESP32P4_REVISION 3
+#endif
+
 #ifndef ASM
 
 #include <stdint.h>
@@ -43,10 +47,14 @@
 #endif /* ASM */
 
 /*
- * The ESP32-P4 routes 136 peripheral interrupt sources (0-135) through the
+ * The ESP32-P4 routes 128 (v1) or 136 (v3) peripheral sources through the
  * interrupt matrix onto 32 CLIC external channels (CLIC IDs 16-47).
  */
+#if BSP_ESP32P4_REVISION == 1
+#define RISCV_MAXIMUM_EXTERNAL_INTERRUPTS 128
+#else
 #define RISCV_MAXIMUM_EXTERNAL_INTERRUPTS 136
+#endif
 #define BSP_INTERRUPT_VECTOR_COUNT        RISCV_MAXIMUM_EXTERNAL_INTERRUPTS
 
 #define BSP_INTERRUPT_CUSTOM_VALID_VECTOR
diff --git a/bsps/riscv/esp32/include/p4v1/chip_definitions.h b/bsps/riscv/esp32/include/p4v1/chip_definitions.h
new file mode 100644
index 0000000000..8bc6f98a20
--- /dev/null
+++ b/bsps/riscv/esp32/include/p4v1/chip_definitions.h
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Copyright (C) 2026 Peter Madsen-Mygdal <petermm@gmail.com> */
+
+#ifndef LIBBSP_ESP32_P4V1_CHIP_DEFINITIONS_H
+#define LIBBSP_ESP32_P4V1_CHIP_DEFINITIONS_H
+
+#define BSP_ESP32P4_REVISION 1
+#include <p4/chip_definitions.h>
+
+#endif
diff --git a/bsps/riscv/esp32/irq/irq_c3.c b/bsps/riscv/esp32/irq/irq_c3.c
index 1ead8714ce..345257dbd8 100644
--- a/bsps/riscv/esp32/irq/irq_c3.c
+++ b/bsps/riscv/esp32/irq/irq_c3.c
@@ -299,7 +299,11 @@ static inline void esp32_cpu_int_enable_all( void )
   uintptr_t mtvec;
 
   /* Three level bits; machine-mode, level-triggered, non-vectored sources. */
+#if BSP_ESP32P4_REVISION == 1
+  CLIC_REG( 0x00 ) = 3U << 1;
+#else
   CLIC_REG( 0x00 ) = 3U;
+#endif
   for ( uint32_t id = 0; id < 48U; ++id ) {
     CLIC_REG( 0x1000U + id * 4U ) = 0x1fc00000U;
   }
@@ -315,10 +319,17 @@ static inline void esp32_cpu_int_enable_all( void )
     ".option pop\n" : "=r" ( mtvec )
   );
   mtvec = ( mtvec & ~(uintptr_t) 3U ) | 3U;
+#if BSP_ESP32P4_REVISION == 1
+  /* Legacy CLIC threshold takes effect after a subsequent memory load. */
+  CLIC_REG( 0x08 ) = 0;
+  (void) CLIC_REG( 0x08 );
+#endif
   __asm__ volatile (
     ".option push\n"
     ".option arch, +zicsr\n"
+#if BSP_ESP32P4_REVISION != 1
     "csrw 0x347, zero\n"
+#endif
     "csrw mtvec, %0\n"
     ".option pop\n" : : "r" ( mtvec ) : "memory"
   );
@@ -455,7 +466,11 @@ static uint8_t int_periph_to_cpu( rtems_vector_number vector )
 #if defined(LIBBSP_ESP32_S31_CHIP_DEFINITIONS_H)
 #define BSP_INTR_STATUS_WORDS 6
 #elif defined(LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H)
+#if BSP_ESP32P4_REVISION == 1
+#define BSP_INTR_STATUS_WORDS 4
+#else
 #define BSP_INTR_STATUS_WORDS 5
+#endif
 #elif defined(LIBBSP_ESP32_C6_CHIP_DEFINITIONS_H) || defined(LIBBSP_ESP32_C5_CHIP_DEFINITIONS_H)
 #define BSP_INTR_STATUS_WORDS 3
 #else
@@ -481,6 +496,8 @@ static uint32_t get_int_status( size_t word )
 #if BSP_INTR_STATUS_WORDS > 3
     case 3:
       return *( (volatile uint32_t *) ( matrix_base + INTERRUPT_CORE0_INTR_STATUS_3_REG ) );
+#endif
+#if BSP_INTR_STATUS_WORDS > 4
     case 4:
       return *( (volatile uint32_t *) ( matrix_base + INTERRUPT_CORE0_INTR_STATUS_4_REG ) );
 #endif
diff --git a/bsps/riscv/esp32/start/bspsmp.c b/bsps/riscv/esp32/start/bspsmp.c
index 01d63ceff4..dc19e9d015 100644
--- a/bsps/riscv/esp32/start/bspsmp.c
+++ b/bsps/riscv/esp32/start/bspsmp.c
@@ -166,7 +166,11 @@ void bsp_start_on_secondary_processor( Per_CPU_Control *cpu_self )
 
   if ( _SMP_Should_start_processor( cpu_index_self ) ) {
     /* Core 1 CLIC initialization */
+#if BSP_ESP32P4_REVISION == 1
+    CLIC_REG_CORE1( 0x00 ) = 3U << 1;
+#else
     CLIC_REG_CORE1( 0x00 ) = 3U;
+#endif
     for ( uint32_t id = 0; id < 48U; ++id ) {
       CLIC_REG_CORE1( 0x1000U + id * 4U ) = 0x1fc00000U;
     }
@@ -182,10 +186,16 @@ void bsp_start_on_secondary_processor( Per_CPU_Control *cpu_self )
       ".option pop\n" : "=r" ( mtvec )
     );
     mtvec = ( mtvec & ~(uintptr_t) 3U ) | 3U;
+#if BSP_ESP32P4_REVISION == 1
+    CLIC_REG_CORE1( 0x08 ) = 0;
+    (void) CLIC_REG_CORE1( 0x08 );
+#endif
     __asm__ volatile (
       ".option push\n"
       ".option arch, +zicsr\n"
+#if BSP_ESP32P4_REVISION != 1
       "csrw 0x347, zero\n"
+#endif
       "csrw mtvec, %0\n"
       ".option pop\n" : : "r" ( mtvec ) : "memory"
     );
diff --git a/bsps/riscv/esp32/start/bspstart.c b/bsps/riscv/esp32/start/bspstart.c
index b0809c37a2..eb24de4ef5 100644
--- a/bsps/riscv/esp32/start/bspstart.c
+++ b/bsps/riscv/esp32/start/bspstart.c
@@ -118,7 +118,21 @@
 #define CLK_HP_ALIVE_SYS_BASE (uintptr_t) 0x20589000
 #define CLK_HP_SYS_CLKRST_BASE (uintptr_t) 0x20587000
 #elif defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+#if BSP_ESP32P4_REVISION == 1
+#define BSP_ESP32_CPU_FREQ_MAX_MHZ 360
+/* Keep overrides from handing the pre-v3 ROM stack/globals or upper cache
+ * partition to the allocator. The direct-boot image needs only low SRAM. */
+_Static_assert( ESP32C_RAM_ORIGIN == 0x4ff00000U,
+  "P4 v1 requires lower-bank RAM" );
+_Static_assert( ESP32C_RAM_CODE_ORIGIN == 0x4ff00000U &&
+  ESP32C_IRAM_REGION_SIZE <= 0x1000U,
+  "P4 v1 SRAM code must fit in the lower 4 KiB" );
+_Static_assert( ESP32C_RAM_ORIGIN + ESP32C_RAM_SIZE -
+  ESP32C_DRAM_ROM_RESERVE_SIZE <= 0x4ff3a000U,
+  "P4 v1 RAM overlaps the ROM reservation" );
+#else
 #define BSP_ESP32_CPU_FREQ_MAX_MHZ 400
+#endif
 #define CLK_PMU_BASE           (uintptr_t) 0x50115000
 #define CLK_HP_SYS_CLKRST_BASE (uintptr_t) 0x500E6000
 #define CLK_LP_CLKRST_BASE     (uintptr_t) 0x50111000
@@ -443,9 +457,14 @@ static void bsp_p4_cpll_init( void )
    * the analog registers, then wait for completion and a timed settling period. */
   WRITE_REG( CLK_HP_SYS_CLKRST_BASE, 0xbc, READ_REG( CLK_HP_SYS_CLKRST_BASE, 0xbc ) & ~( 1u << 3 ) );
 
-  /* RegI2C CPLL 400 MHz configuration */
+  /* ESP-IDF clk_ll_cpll_set_config(): ECO1 uses div7_0=9 for 360 MHz;
+   * v3 uses div7_0=10 for 400 MHz. ECO0 is not supported by this BSP. */
   bsp_p4_regi2c_write( 0x67, 2, 0x50 );
+#if BSP_ESP32P4_REVISION == 1
+  bsp_p4_regi2c_write( 0x67, 3, 9 );
+#else
   bsp_p4_regi2c_write( 0x67, 3, 10 );
+#endif
   bsp_p4_regi2c_write( 0x67, 6, 0x73 );
 
   uint32_t timeout = 1000000;
@@ -598,13 +617,13 @@ void bsp_esp32s31_initialize_pma( void )
 
 void bsp_start( void )
 {
-#if defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
-  /* EFUSE_RD_MAC_SYS_2, as in ESP-IDF efuse_ll_get_chip_wafer_version_major().
-   * Reject incompatible silicon before using the v3 clocks or ROM data ABI. */
-  uint32_t wafer = READ_REG( (uintptr_t) 0x5012d000U, 0x4c );
-  uint32_t major = ( ( wafer >> 4 ) & 3U ) | ( ( ( wafer >> 23 ) & 1U ) << 2 );
-  if ( major != 3U ) {
-    rtems_panic( "ESP32-P4: this BSP requires revision 3.x" );
+#if BSP_ESP32P4_REVISION == 1
+  /* All supported L2 modes use only upper SRAM. Preserve ROM's mapping and
+   * cache configuration; never make the lower-bank allocator depend on size. */
+  uint32_t cache_size = READ_REG( (uintptr_t) 0x3ff10000U, 0x278 );
+  if ( cache_size != ( 1U << 9 ) && cache_size != ( 1U << 10 ) &&
+       cache_size != ( 1U << 11 ) ) {
+    rtems_panic( "ESP32-P4 v1: unsupported L2 cache size" );
   }
 #endif
 
diff --git a/bsps/riscv/shared/start/start.S b/bsps/riscv/shared/start/start.S
index 96a5e64556..ad1b1e6c68 100644
--- a/bsps/riscv/shared/start/start.S
+++ b/bsps/riscv/shared/start/start.S
@@ -35,6 +35,10 @@
 #include <bsp/linker-symbols.h>
 #include <bspopts.h>
 
+#ifdef ESPRESSIF_CHIP_HEADER
+#include RTEMS_XSTRING( ESPRESSIF_CHIP_HEADER )
+#endif
+
 PUBLIC(_start)
 
 	.section	.bsp_start_text, "wax", @progbits
@@ -55,6 +59,43 @@ PUBLIC(_start)
 TYPE_FUNC(_start)
 SYM(_start):
 
+#if defined( LIBBSP_ESP32_P4_CHIP_DEFINITIONS_H )
+	/* Reject the wrong ROM/SRAM ABI before selecting a stack or writing RAM. */
+	li	t0, 0x5012d04c
+	lw	t1, 0(t0)
+	srli	t2, t1, 4
+	andi	t2, t2, 3
+	srli	t1, t1, 21
+	andi	t1, t1, 4
+	or	t1, t1, t2
+	li	t2, BSP_ESP32P4_REVISION
+	beq	t1, t2, .Lp4_revision_ok
+	LADDR	t0, .Lp4_revision_error
+	li	t1, 0x500ca000
+.Lp4_revision_print:
+	lbu	t2, 0(t0)
+	beqz	t2, .Lp4_revision_halt
+.Lp4_revision_fifo:
+	lw	t3, 0x1c(t1)
+	srli	t3, t3, 16
+	andi	t3, t3, 0x3ff
+	li	t4, 128
+	bgeu	t3, t4, .Lp4_revision_fifo
+	sw	t2, 0(t1)
+	addi	t0, t0, 1
+	j	.Lp4_revision_print
+.Lp4_revision_halt:
+	j	.Lp4_revision_halt
+.Lp4_revision_error:
+#if BSP_ESP32P4_REVISION == 1
+	.asciz "ESP32-P4: this BSP requires revision 1.x\r\n"
+#else
+	.asciz "ESP32-P4: this BSP requires revision 3.x\r\n"
+#endif
+	.align	2
+.Lp4_revision_ok:
+#endif
+
 #ifndef RISCV_USE_S_MODE
 	csrr	a0, mhartid
 #endif
