 #define UART_CLK_CONF_RX_SCLK_EN         ( 1U << 25 )
 
-/* SCLK_SEL = 1 is APB_CLK, which on this part is 80 MHz. */
+/* SCLK_SEL = 1 is APB_CLK, which on this part is 80 MHz.  The newer UART
+ * (H2, S31, P4) selects its source in PCR instead; the H2's reset selection is
+ * the 32 MHz crystal, which is what the boot ROM programs the console for. */
 #define UART_SCLK_SEL_APB   1
+#if defined(LIBBSP_ESP32_H2_CHIP_DEFINITIONS_H)
+#define UART_SCLK_HZ        32000000U
+#else
 #define UART_SCLK_HZ        80000000U
+#endif
 
