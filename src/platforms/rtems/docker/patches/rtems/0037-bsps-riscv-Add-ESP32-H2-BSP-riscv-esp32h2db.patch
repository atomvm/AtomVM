   /* This part has no SCLK_SEL or SCLK_EN in the UART's own clock register: the
-   * source (REF_F80M) and divider live in HP_SYS_CLKRST and come up correct on
-   * reset, so only the transmit and receive clock gates need asserting. */
+   * source (REF_F80M, or XTAL for the H2) and divider live in HP_SYS_CLKRST and
+   * PCR and come up correct on reset, so only the transmit and receive clock
+   * gates need asserting. */
   UART_REG( ctx, UART_CLK_CONF ) =
       UART_CLK_CONF_TX_SCLK_EN
     | UART_CLK_CONF_RX_SCLK_EN;
