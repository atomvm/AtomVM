# Stage 1: Base build dependencies
FROM ubuntu:24.04 AS build-base

ENV DEBIAN_FRONTEND=noninteractive
ENV RTEMS_PREFIX=/opt/rtems/6
ENV RTEMS_VERSION=6
ENV RTEMS_RELEASE=6
ENV PATH="${RTEMS_PREFIX}/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    gdb \
    unzip \
    pax \
    bison \
    flex \
    texinfo \
    python3-dev \
    python-is-python3 \
    python3-setuptools \
    libncurses-dev \
    zlib1g-dev \
    ninja-build \
    pkg-config \
    cmake \
    gperf \
    wget \
    curl \
    xz-utils \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY dependencies.sh /tmp/dependencies.sh

# Stage 2: Heavy RSB ARM Toolchain (GCC, Binutils, Newlib) ~15-20 min build.
# Cached independently so it never rebuilds when BSP or LibBSD options change.
# GDB is not needed to compile or package GRiSP 2 firmware.
FROM build-base AS rsb-toolchain

WORKDIR /tmp/rsb
RUN . /tmp/dependencies.sh \
    && rtems_clone_pinned https://github.com/RTEMS/rtems-source-builder.git "${RTEMS_RSB6_COMMIT}" rsb \
    && sed -i '/with_rtems_gdb/d' rsb/rtems/config/tools/rtems-default-tools.bset \
    && sed -i 's|https://gmplib.org/download/gmp|https://ftp.gnu.org/gnu/gmp|g' rsb/source-builder/config/gmp.cfg \
    && cd rsb/rtems \
    && mkdir -p sources \
    && curl -fSL --retry 3 --retry-all-errors https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.bz2 -o sources/gmp-6.3.0.tar.bz2 \
    && ../source-builder/sb-set-builder --prefix="${RTEMS_PREFIX}" 6/rtems-arm

# Stage 3: RTEMS 6 Kernel for arm/imx7 ~2 min build.
FROM rsb-toolchain AS bsp-kernel

WORKDIR /tmp/rsb/rsb/rtems
RUN ../source-builder/sb-set-builder --prefix="${RTEMS_PREFIX}" \
    --target=arm-rtems6 \
    --with-rtems-bsp=arm/imx7 \
    --with-rtems-tests=no \
    6/rtems-kernel

# Stage 4: RTEMS LibBSD for arm/imx7 with GRiSP 2 Wi-Fi modules ~10-15 min build.
FROM bsp-kernel AS libbsd

COPY grisp2-libbsd.ini /tmp/grisp2-libbsd.ini

WORKDIR /tmp/libbsd
RUN . /tmp/dependencies.sh \
    && rm -rf /tmp/rsb \
    && git config --global --add url."https://github.com/RTEMS/rtems_waf".insteadOf "https://gitlab.rtems.org/rtems/tools/rtems-waf" \
    && git config --global --add url."https://github.com/RTEMS/rtems_waf".insteadOf "https://gitlab.rtems.org/rtems/tools/rtems_waf" \
    && rtems_clone_pinned https://github.com/RTEMS/rtems-libbsd.git "${RTEMS_LIBBSD_COMMIT}" rtems-libbsd \
    && cd rtems-libbsd \
    && git submodule update --init rtems_waf \
    && sed -i '1i#ifndef LIBIO_FLAGS_CLOSE_BUSY\n#define LIBIO_FLAGS_CLOSE_BUSY 0x0400U\n#endif' rtemsbsd/include/machine/rtems-bsd-libio.h \
    && ./waf configure \
        --prefix="${RTEMS_PREFIX}" \
        --rtems-bsps=arm/imx7 \
        --buildset=/tmp/grisp2-libbsd.ini \
        --rtems-version=6 \
    && ./waf \
    && ./waf install \
    && rm -rf /tmp/libbsd /tmp/grisp2-libbsd.ini

# Strip debug symbols from host binaries to minimize final layer size
RUN find ${RTEMS_PREFIX}/bin ${RTEMS_PREFIX}/libexec -type f -executable -exec strip {} + 2>/dev/null || true

# Stage 5: Final developer runtime & packaging environment.
# AtomVM source is bind-mounted into /workspace at runtime (-v $PWD:/workspace),
# ensuring that changes to AtomVM source code NEVER trigger a Docker image rebuild.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RTEMS_PREFIX=/opt/rtems/6
ENV PATH="${RTEMS_PREFIX}/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    python3 \
    python3-pip \
    gperf \
    curl \
    libtinfo6 \
    libssl3t64 \
    u-boot-tools \
    device-tree-compiler \
    zip \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Erlang/OTP and rebar3 are pinned to the same versions used by CI
# (.github/workflows/rtems-build.yaml), so locally built AVM packs are
# identical to the ones produced by the workflow.
COPY dependencies.sh /tmp/dependencies.sh
RUN . /tmp/dependencies.sh && rtems_install_otp

# Copy prebuilt RTEMS 6 ARM toolchain, imx7 BSP, and LibBSD
COPY --from=libbsd /opt/rtems/6 /opt/rtems/6

WORKDIR /workspace
CMD ["bash"]
