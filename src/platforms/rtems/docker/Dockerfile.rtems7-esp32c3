FROM ubuntu:24.04 AS toolchain-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV RTEMS_PREFIX=/opt/rtems/7

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    gdb \
    unzip \
    pax \
    bison \
    flex \
    texinfo \
    python3-dev \
    python-is-python3 \
    python3-setuptools \
    libncurses-dev \
    zlib1g-dev \
    ninja-build \
    pkg-config \
    cmake \
    gperf \
    git \
    wget \
    xz-utils \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Build RTEMS 7 RISC-V tools via RSB
WORKDIR /tmp/rsb
RUN git clone --depth 1 https://github.com/RTEMS/rtems-source-builder.git -b main . \
    && cd rtems \
    && ../source-builder/sb-set-builder --prefix="${RTEMS_PREFIX}" 7/rtems-riscv \
    && rm -rf /tmp/rsb

# Build RTEMS 7 kernel with riscv/esp32c3db BSP via waf
WORKDIR /tmp/rtems
ENV PATH="${RTEMS_PREFIX}/bin:${PATH}"
RUN git clone --depth 1 https://github.com/RTEMS/rtems.git -b main . \
    && ./waf configure --prefix="${RTEMS_PREFIX}" --rtems-bsps=riscv/esp32c3db \
    && ./waf \
    && ./waf install \
    && rm -rf /tmp/rtems

# Strip tools to reduce layer size
RUN find ${RTEMS_PREFIX}/bin ${RTEMS_PREFIX}/libexec -type f -executable -exec strip {} + 2>/dev/null || true

# Final developer & runner stage
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RTEMS_PREFIX=/opt/rtems/7
ENV PATH="${RTEMS_PREFIX}/bin:/root/.local/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    python3 \
    python-is-python3 \
    python3-pip \
    curl \
    git \
    gperf \
    ca-certificates \
    erlang-base \
    erlang-dev \
    erlang-tools \
    erlang-parsetools \
    && rm -rf /var/lib/apt/lists/*

# Copy prebuilt RTEMS 7 RISC-V toolchain
COPY --from=toolchain-builder /opt/rtems/7 /opt/rtems/7

# Install esp-emulator for direct headless simulation
RUN curl -fsSL https://raw.githubusercontent.com/espressif/esp-emulator/main/install.sh | sh \
    && cp /root/.local/bin/esp-emu /usr/local/bin/esp-emu || true

WORKDIR /workspace

CMD ["/bin/bash"]
