# Stage 1: Base build dependencies
FROM ubuntu:24.04 AS build-base

ENV DEBIAN_FRONTEND=noninteractive
ENV RTEMS_PREFIX=/opt/rtems/7

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    gdb \
    unzip \
    pax \
    bison \
    flex \
    texinfo \
    python3-dev \
    python-is-python3 \
    python3-setuptools \
    libncurses-dev \
    zlib1g-dev \
    ninja-build \
    pkg-config \
    cmake \
    gperf \
    git \
    wget \
    xz-utils \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: Heavy RSB Toolchain (GCC, Binutils, GDB, Newlib) ~15-20 min build.
# Cached independently so it never rebuilds when BSP or application code changes.
FROM build-base AS rsb-toolchain
ARG RSB_REF=main

WORKDIR /tmp/rsb
RUN git clone --depth 1 https://github.com/RTEMS/rtems-source-builder.git -b ${RSB_REF} . \
    && cd rtems \
    && ../source-builder/sb-set-builder --prefix="${RTEMS_PREFIX}" 7/rtems-riscv \
    && rm -rf /tmp/rsb

# Context for optional local RTEMS source tree (defaults to empty scratch stage)
# Override via: docker build --build-context rtems-src=/path/to/local/rtems ...
FROM scratch AS rtems-src

# Stage 3: RTEMS Kernel & ESP32-C3 BSP ~30 sec build.
# Layered on top of the cached RSB toolchain; if RTEMS BSP options change, only this fast step rebuilds.
FROM rsb-toolchain AS bsp-builder
ARG RTEMS_REF=main
ARG RTEMS_GIT_URL=https://github.com/RTEMS/rtems.git

WORKDIR /tmp/rtems
ENV PATH="${RTEMS_PREFIX}/bin:${PATH}"

# Copy patches directory from build context
COPY patches/ /tmp/patches/

# Copy optional local RTEMS source from build context (empty if not specified)
COPY --from=rtems-src . /tmp/rtems-local/

RUN if [ -f /tmp/rtems-local/waf ]; then \
        echo "==> Using local RTEMS source tree..." && \
        cp -a /tmp/rtems-local/. /tmp/rtems/ ; \
    else \
        echo "==> Cloning upstream RTEMS (${RTEMS_GIT_URL} @ ${RTEMS_REF})..." && \
        git clone --depth 1 "${RTEMS_GIT_URL}" -b "${RTEMS_REF}" . ; \
    fi \
    && if [ -d /tmp/patches ]; then \
        for patch in /tmp/patches/*.patch /tmp/patches/*.diff; do \
            if [ -f "$patch" ]; then \
                echo "==> Applying patch: $(basename "$patch")..." && \
                git apply "$patch" || patch -p1 < "$patch"; \
            fi; \
        done; \
    fi \
    && ./waf configure --prefix="${RTEMS_PREFIX}" --rtems-bsps=riscv/esp32c3db \
    && ./waf \
    && ./waf install \
    && rm -rf /tmp/rtems /tmp/rtems-local /tmp/patches

# Strip debug symbols from host binaries to minimize final layer size
RUN find ${RTEMS_PREFIX}/bin ${RTEMS_PREFIX}/libexec -type f -executable -exec strip {} + 2>/dev/null || true

# Stage 4: Final developer runtime & simulation environment.
# AtomVM source is bind-mounted into /workspace at runtime (-v $PWD:/workspace),
# ensuring that changes to AtomVM source code NEVER trigger a Docker image rebuild.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RTEMS_PREFIX=/opt/rtems/7
ENV PATH="${RTEMS_PREFIX}/bin:/root/.local/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    python3 \
    python-is-python3 \
    python3-pip \
    curl \
    git \
    gperf \
    ca-certificates \
    erlang-base \
    erlang-dev \
    erlang-tools \
    erlang-parsetools \
    && rm -rf /var/lib/apt/lists/*

# Copy prebuilt RTEMS 7 RISC-V toolchain and installed esp32c3db BSP
COPY --from=bsp-builder /opt/rtems/7 /opt/rtems/7

# Install esp-emulator for direct headless simulation
RUN curl -fsSL https://raw.githubusercontent.com/espressif/esp-emulator/main/install.sh | sh \
    && cp /root/.local/bin/esp-emu /usr/local/bin/esp-emu || true

WORKDIR /workspace

CMD ["/bin/bash"]
