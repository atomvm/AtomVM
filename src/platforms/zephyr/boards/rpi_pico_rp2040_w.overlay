/ {
	chosen {
		atomvm,retention = &atomvm_retention;
		zephyr,settings-partition = &storage_partition;
	};
	sram@20041f00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x20041f00 0x100>;
		ranges = <0x0 0x20041f00 0x100>;
		zephyr,memory-region = "ATOMVM_RETAINED";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;
		atomvm_retained_mem: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;
			atomvm_retention: retention@0 {
				compatible = "zephyr,retention";
				status = "okay";
				reg = <0x0 0x100>;
				prefix = [41 56 4d];
				checksum = <4>;
			};
		};
	};
};

&sram0 {
	reg = <0x20000000 0x41f00>;
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/delete-node/ partition@100;

		code_partition: partition@100 {
			label = "code-partition";
			reg = <0x100 0x1f9f00>;
			read-only;
		};

		storage_partition: partition@1fa000 {
			label = "storage";
			reg = <0x1fa000 DT_SIZE_K(24)>;
		};
	};
};
