/ {
    chosen {
        atomvm,i2c = &i2c0;
        atomvm,spi = &spi0;
        atomvm,pwm = &pwm0;
        atomvm,dac = &dac0;
        zephyr,settings-partition = &storage_partition;
    };

    pwm0: pwm0 {
        compatible = "zephyr,fake-pwm";
        status = "okay";
        #pwm-cells = <2>;
        frequency = <10000000>;
    };

    dac0: dac0 {
        compatible = "zephyr,dac-emul";
        status = "okay";
        nchannels = <2>;
        #io-channel-cells = <1>;
    };
};
