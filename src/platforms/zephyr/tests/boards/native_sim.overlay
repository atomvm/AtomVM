/ {
    chosen {
        atomvm,i2c = &i2c0;
        atomvm,spi = &spi0;
    };
};

&i2c0 {
    atomvm_i2c_test_target: atomvm-i2c-test-target@50 {
        compatible = "vnd,atomvm-native-sim-i2c-target";
        reg = <0x50>;
    };
};
