#include <zephyr/dt-bindings/adc/adc.h>

/ {
	chosen {
		atomvm,retention = &atomvm_retention;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	memory@50001f00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x50001f00 0x100>;
		ranges = <0x0 0x50001f00 0x100>;
		zephyr,memory-region = "ATOMVM_RTC_RETAINED";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;

		atomvm_retained_mem: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			atomvm_retention: retention@0 {
				compatible = "zephyr,retention";
				status = "okay";
				reg = <0x0 0x100>;
				prefix = [41 56 4d];
				checksum = <4>;
			};
		};
	};

	zephyr,user {
		io-channels = <&adc1 0>;
	};
};

&uart0 {
	status = "okay";
};

&rtc_slow_ram {
	reg = <0x50000000 0x1f00>;
};

&adc1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
