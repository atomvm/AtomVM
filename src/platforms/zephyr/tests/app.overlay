/ {
    /*
     * Small FAT volume for test_mount / test_file. The tests only create a
     * couple of short files, so 16 KiB is enough for mkfs + payload and keeps
     * the static DRAM cost reasonable on embedded targets.
     */
    ramdisk0 {
        compatible = "zephyr,ram-disk";
        disk-name = "RAM";
        sector-size = <512>;
        sector-count = <32>; /* 32 * 512 = 16 KiB */
    };
};
