CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=10000
# ECDSA chain verify on Wokwi occupies the main task for >5s and trips
# the idle-task watchdog, which then corrupts mbedtls (`{ssl,-2}`).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_AVM_RTC_SLOW_MAX_SIZE=1024
CONFIG_ETH_USE_OPENETH=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_LWIP_IPV6=n
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
